{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Clan",
  "description": "A clan data structure for Discord bot.",
  "type": "object",
  "properties": {
    "id": {
      "description": "The unique ID of the clan.",
      "type": "integer"
    },
    "name": {
      "description": "The name of the clan.",
      "type": "string"
    },
    "members": {
      "description": "A list of clan members.",
      "type": "array",
      "items": {
        "$ref": "clanMember.schema.json"
      }
    },
    "createdAt": {
      "description": "The timestamp when the clan was created.",
      "type": "string",
      "format": "date-time"
    }
  },
  "required": ["id", "name", "members", "createdAt"]
}