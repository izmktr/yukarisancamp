{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UserProfile",
  "description": "A user profile stored in Firebase.",
  "type": "object",
  "properties": {
    "googleUserId": {
      "description": "The unique ID of the user (from Google).",
      "type": "string"
    },
    "discordId": {
      "description": "The unique ID of the user (from Discord).",
      "type": ["string", "null"]
    },
    "discordServer": {
      "description": "The unique ID of the Discord server the user belongs to.",
      "type": ["string", "null"]
    },
    "displayName": {
      "description": "The user's display name.",
      "type": "string"
    },
    "createdAt": {
      "description": "The timestamp when the profile was created.",
      "type": "number"
    },
    "ownedCharacters": {
      "description": "所持キャラ一覧。",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "officialName": {
            "description": "公式名",
            "type": "string"
          },
          "nickname": {
            "description": "愛称",
            "type": "string"
          },
          "owned": {
            "description": "所持しているかどうか",
            "type": "boolean"
          },
          "connectRank": {
            "description": "コネクトランク",
            "type": "integer"
          }
        },
        "required": ["officialName", "nickname", "owned", "connectRank"]
      }
    }
  },
  "required": ["googleUserId", "displayName", "createdAt"]
}
