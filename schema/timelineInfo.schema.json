{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TimelineInfo",
  "description": "Metadata schema for battle timeline information.",
  "type": "object",
  "properties": {
    "uniqueId": {
      "description": "A unique identifier for the timeline entry.",
      "type": "string"
    },
    "yearmonth": {
      "description": "The year and month of the battle in YYYYMM format.",
      "type": "string",
      "pattern": "^[0-9]{6}$"
    },
    "bossname": {
      "description": "The name of the boss fought in the battle.",
      "type": "string"
    },
    "damage": {
      "description": "Total battle damage.",
      "type": "integer"
    },
    "battleTime": {
      "description": "Battle duration in mm:ss format.",
      "type": "string",
      "pattern": "^[0-9]{2}:[0-9]{2}$"
    },
    "battleDate": {
      "description": "Battle date and time in yyyy/MM/dd HH:mm format.",
      "type": "string",
      "pattern": "^[0-9]{4}/[0-9]{2}/[0-9]{2} [0-9]{2}:[0-9]{2}$"
    },
    "postTitle": {
      "description": "Post title for sharing.",
      "type": "string"
    },
    "postComment": {
      "description": "Post comment for sharing.",
      "type": "string"
    },
    "difficulty": {
      "description": "Battle difficulty level.",
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "visibility": {
      "description": "Post visibility scope.",
      "type": "string",
      "enum": ["all", "clan", "self"]
    },
    "mode": {
      "description": "Battle mode.",
      "type": "string",
      "enum": ["full", "agro", "rank2", "rank3"]
    },
    "authorid": {
      "description": "Author of the timeline entry.",
      "type": "string"
    },
    "authorname": {
      "description": "Author's name.",
      "type": "string"
    },
    "authorclanid": {
      "description": "Author's clan ID.",
      "type": "string"
    },
    "party": {
      "description": "Party members used in the battle.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "description": "Character name.",
            "type": "string"
          },
          "star": {
            "description": "Character star level.",
            "type": "integer"
          },
          "level": {
            "description": "Character level.",
            "type": "integer"
          },
          "rank": {
            "description": "Character rank.",
            "type": "integer"
          }
        },
        "required": ["name", "star", "level", "rank"]
      }
    },
    "ubTimeline": {
      "description": "Timeline of union burst events.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "time": {
            "description": "Timeline position in mm:ss format.",
            "type": "string",
            "pattern": "^[0-9]{2}:[0-9]{2}$"
          },
          "character": {
            "description": "Character or battle event label.",
            "type": "string"
          },
          "activeIcons": {
            "description": "Array of active character indices (0-4 for party only).",
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            }
          },
          "autoActive": {
            "description": "Whether Auto is active.",
            "type": "boolean"
          },
          "comment": {
            "description": "Comment for this timeline entry.",
            "type": "string"
          },
          "isAddedRow": {
            "description": "Whether this row was user-added.",
            "type": "boolean"
          },
          "timing": {
            "description": "Whether timing is active for this row.",
            "type": "boolean"
          }
        },
        "required": ["time", "character"]
      }
    }
  },
  "required": ["uniqueId", "yearmonth", "bossname", "mode", "damage", "battleTime", "battleDate", "party", "ubTimeline"]
}
