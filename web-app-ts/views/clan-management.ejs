<div class="page-content clan-management-page">
  <% const data = clanManagementData || { clan: null, members: [], loadError: '' }; %>
  <% if (data.loadError) { %>
    <div class="settings-firebase-error"><%= data.loadError %></div>
  <% } else { %>
    <% const clanName = data.clan && typeof data.clan.name === 'string' && data.clan.name.trim().length > 0 ? data.clan.name.trim() : '未登録'; %>
    <% const members = Array.isArray(data.members) ? [...data.members] : []; %>
    <% const leaderCount = members.filter((member) => member.role === 'leader').length; %>
    <% const officerCount = members.filter((member) => member.role === 'officer').length; %>
    <% const memberCount = members.length; %>
    <% members.sort((left, right) => {
      const roleWeight = (role) => {
        if (role === 'leader') return 0;
        if (role === 'officer') return 1;
        return 2;
      };

      const roleDiff = roleWeight(left.role) - roleWeight(right.role);
      if (roleDiff !== 0) {
        return roleDiff;
      }

      const nameDiff = String(left.name || '').localeCompare(String(right.name || ''), 'ja');
      if (nameDiff !== 0) {
        return nameDiff;
      }

      return String(left.memberid || '').localeCompare(String(right.memberid || ''), 'ja');
    }); %>

    <% const roleLabel = (role) => {
      if (role === 'leader') return 'マスター';
      if (role === 'officer') return 'サブマスター';
      return '';
    }; %>
    <% const clanId = data.clan && typeof data.clan.clanid === 'string' ? data.clan.clanid : ''; %>
    <% const delegations = Array.isArray(data.delegations) ? data.delegations : []; %>
    <% const memberNameById = new Map(); %>
    <% members.forEach((member) => {
      memberNameById.set(member.memberid, member.name || 'Unknown');
    }); %>
    <% const agentNamesByPrincipalId = new Map(); %>
    <% const principalNamesByAgentId = new Map(); %>
    <% delegations.forEach((row) => {
      if (!row || typeof row.memberid !== 'string' || typeof row.delegateid !== 'string') {
        return;
      }
      const agentName = memberNameById.get(row.memberid);
      const principalName = memberNameById.get(row.delegateid);
      if (agentName) {
        if (!agentNamesByPrincipalId.has(row.delegateid)) {
          agentNamesByPrincipalId.set(row.delegateid, []);
        }
        agentNamesByPrincipalId.get(row.delegateid).push(agentName);
      }
      if (principalName) {
        if (!principalNamesByAgentId.has(row.memberid)) {
          principalNamesByAgentId.set(row.memberid, []);
        }
        principalNamesByAgentId.get(row.memberid).push(principalName);
      }
    }); %>
    <% const sortJaNames = (names) => names.slice().sort((left, right) => String(left).localeCompare(String(right), 'ja')); %>

    <section class="clan-management-panel">
      <div class="clan-management-header">
        <div>
          <p class="clan-management-eyebrow">クラン管理</p>
          <h2 class="clan-management-clan-name"><%= clanName %></h2>
          <p class="clan-management-description">メンバーの役職確認と削除を行います。</p>
        </div>
        <div class="clan-management-summary">
          <span class="clan-management-summary-chip"><strong><%= memberCount %></strong> members</span>
          <span class="clan-management-summary-chip is-leader"><strong><%= leaderCount %></strong> master</span>
          <span class="clan-management-summary-chip is-officer"><strong><%= officerCount %></strong> sub</span>
        </div>
      </div>

      <div class="clan-management-actions">
        <form method="post" action="/clan-management/members/add" id="clan-management-add-form" class="clan-management-add-form">
          <input type="hidden" name="name" id="clan-management-add-name" />
          <button type="button" id="clan-management-add-button" class="btn btn-primary clan-management-add-button">メンバー追加</button>
        </form>
      </div>

      <div class="clan-management-modal" id="clan-management-modal" aria-hidden="true">
        <div class="clan-management-modal-backdrop" data-clan-management-modal-close></div>
        <div class="clan-management-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="clan-management-modal-title">
          <div class="clan-management-modal-header">
            <h4 id="clan-management-modal-title">メンバー追加</h4>
            <button type="button" class="clan-management-modal-close" data-clan-management-modal-close aria-label="閉じる">×</button>
          </div>
          <p class="clan-management-modal-description">追加するメンバー名を入力してください。</p>
          <label class="clan-management-modal-label" for="clan-management-name-input">名前</label>
          <input type="text" id="clan-management-name-input" class="clan-management-modal-input" autocomplete="off" maxlength="100" />
          <div class="clan-management-modal-actions">
            <button type="button" class="btn clan-management-modal-cancel" data-clan-management-modal-close>キャンセル</button>
            <button type="button" id="clan-management-modal-submit" class="btn btn-primary">追加</button>
          </div>
        </div>
      </div>

      <div class="clan-management-modal" id="clan-management-delegation-modal" aria-hidden="true">
        <div class="clan-management-modal-backdrop" data-clan-management-delegation-modal-close></div>
        <div class="clan-management-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="clan-management-delegation-modal-title">
          <div class="clan-management-modal-header">
            <h4 id="clan-management-delegation-modal-title">代理設定</h4>
            <div class="clan-management-modal-header-actions">
              <button type="button" class="btn clan-management-modal-cancel" data-clan-management-delegation-modal-close>破棄</button>
              <button type="button" id="clan-management-delegation-modal-submit" class="btn btn-primary">確定</button>
            </div>
          </div>
          <p class="clan-management-modal-description">代理操作をするユーザーを選んでください。</p>
          <div id="clan-management-delegation-checkbox-list" class="clan-management-delegation-checkbox-list"></div>
        </div>
      </div>

      <form method="post" action="/clan-management/members/delegations" id="clan-management-delegation-form" class="clan-management-delegation-form">
        <input type="hidden" name="clanid" value="<%= clanId %>" />
        <input type="hidden" name="memberid" id="clan-management-delegation-memberid" />
      </form>

      <script type="application/json" id="clan-management-delegation-data"><%- JSON.stringify({
        members: members.map((member) => ({ memberid: member.memberid, name: member.name || 'Unknown' })),
        delegations
      }) %></script>

      <h3 class="clan-management-member-list-title">クランメンバー一覧</h3>

      <div class="clan-management-table-wrapper">
        <table class="clan-management-table">
          <thead>
            <tr>
              <th>名前</th>
              <th>役職</th>
              <th>操作</th>
            </tr>
          </thead>
          <tbody>
            <% members.forEach((member) => { %>
              <% const roleBadgeClass = member.role === 'leader' ? 'is-leader' : member.role === 'officer' ? 'is-officer' : 'is-member'; %>
              <% const agentNames = sortJaNames(agentNamesByPrincipalId.get(member.memberid) || []); %>
              <% const principalNames = sortJaNames(principalNamesByAgentId.get(member.memberid) || []); %>
              <% const sourceLabel = String(member.memberid || '').startsWith('w') ? 'web' : 'discord'; %>
              <tr>
                <td class="clan-management-name-cell"><%= member.name || 'Unknown' %></td>
                <td>
                  <div class="clan-management-role-cell">
                    <div class="clan-management-role-badges">
                      <span class="clan-management-role-badge <%= roleBadgeClass %>"><%= roleLabel(member.role) || 'メンバー' %></span>
                      <span class="clan-management-source-badge is-<%= sourceLabel %>"><%= sourceLabel %></span>
                    </div>
                    <% if (agentNames.length > 0 || principalNames.length > 0) { %>
                      <div class="clan-management-delegation-chips">
                        <% agentNames.forEach((name) => { %>
                          <span class="clan-management-delegation-chip is-agent">代理人: <%= name %></span>
                        <% }); %>
                        <% principalNames.forEach((name) => { %>
                          <span class="clan-management-delegation-chip is-principal">操作: <%= name %></span>
                        <% }); %>
                      </div>
                    <% } %>
                  </div>
                </td>
                <td>
                  <div class="clan-management-row-actions">
                    <button type="button" class="btn clan-management-delegate-button" data-member-id="<%= member.memberid %>">代理</button>
                    <% if (member.role !== 'leader' && sourceLabel !== 'web') { %>
                      <% const isOfficer = member.role === 'officer'; %>
                      <form method="post" action="/clan-management/members/role" class="clan-management-role-form" onsubmit="return confirm('<%= isOfficer ? 'このメンバーのサブマスターを解除します。よろしいですか？' : 'このメンバーをサブマスターにします。よろしいですか？' %>');">
                        <input type="hidden" name="clanid" value="<%= member.clanid %>" />
                        <input type="hidden" name="memberid" value="<%= member.memberid %>" />
                        <button type="submit" class="btn clan-management-officer-button"><%= isOfficer ? 'サブ解除' : 'サブマス' %></button>
                      </form>
                    <% } %>
                    <form method="post" action="/clan-management/members/delete" class="clan-management-delete-form" onsubmit="return confirm('このメンバーを削除します。よろしいですか？');">
                      <input type="hidden" name="clanid" value="<%= member.clanid %>" />
                      <input type="hidden" name="memberid" value="<%= member.memberid %>" />
                      <button type="submit" class="btn btn-danger clan-management-delete-button">削除</button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </section>
  <% } %>
</div>

<style>
