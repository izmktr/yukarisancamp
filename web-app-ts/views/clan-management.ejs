    border: 1px solid rgba(37, 99, 235, 0.24);
  }

  .clan-management-modal-header-actions {
    display: flex;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .clan-management-delegation-form {
    display: none;
  }

  .clan-management-delegation-checkbox-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-height: 16rem;
    overflow-y: auto;
    margin-top: 0.5rem;
  }

  .clan-management-delegation-checkbox-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.5rem;
