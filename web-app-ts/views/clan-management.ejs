  }

  .clan-management-delegation-chip.is-agent {
    background: rgba(8, 145, 178, 0.12);
    color: #0e7490;
  }

  .clan-management-delegation-chip.is-principal {
    background: rgba(124, 58, 237, 0.12);
    color: #6d28d9;
  }

  .clan-management-role-badge,
  .clan-management-source-badge {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    padding: 0.35rem 0.7rem;
    font-size: 0.9rem;
    line-height: 1;
  }

  .clan-management-role-badge {
    font-weight: 700;
  }

  .clan-management-role-badge.is-leader {
    background: rgba(245, 158, 11, 0.14);
    color: #92400e;
  }

  .clan-management-role-badge.is-officer {
    background: rgba(59, 130, 246, 0.14);
    color: #1d4ed8;
  }

  .clan-management-role-badge.is-member {
    background: rgba(148, 163, 184, 0.18);
    color: #475569;
  }

  .clan-management-source-badge {
    background: rgba(15, 23, 42, 0.05);
    color: #475569;
  }

  .clan-management-source-badge.is-web {
    background: rgba(14, 165, 233, 0.12);
    color: #0369a1;
  }

  .clan-management-source-badge.is-discord {
    background: rgba(88, 101, 242, 0.12);
    color: #4338ca;
  }

  .clan-management-delete-form,
  .clan-management-role-form {
    margin: 0;
    display: inline-flex;
  }

  .clan-management-row-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .clan-management-delete-button {
    min-width: 5rem;
    border-radius: 999px;
    box-shadow: 0 10px 24px rgba(220, 38, 38, 0.18);
  }

  .clan-management-delegate-button {
    min-width: 4rem;
    border-radius: 999px;
    background: rgba(59, 130, 246, 0.12);
    color: #1d4ed8;
    border: 1px solid rgba(59, 130, 246, 0.24);
  }

  .clan-management-officer-button {
    min-width: 5rem;
    border-radius: 999px;
    background: rgba(37, 99, 235, 0.12);
