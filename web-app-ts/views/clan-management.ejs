</style>

<script>
  (function () {
    const addButton = document.getElementById('clan-management-add-button');
    const addForm = document.getElementById('clan-management-add-form');
    const addNameInput = document.getElementById('clan-management-add-name');
    const modal = document.getElementById('clan-management-modal');
    const modalInput = document.getElementById('clan-management-name-input');
    const modalSubmit = document.getElementById('clan-management-modal-submit');
    const modalCloseButtons = Array.from(document.querySelectorAll('[data-clan-management-modal-close]'));

    if (!addButton || !addForm || !addNameInput || !modal || !modalInput || !modalSubmit) {
      return;
    }

    const openModal = () => {
      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');
      modalInput.value = '';
      window.setTimeout(() => {
        modalInput.focus();
      }, 0);
    };

    const closeModal = () => {
      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');
    };

    addButton.addEventListener('click', () => {
      openModal();
    });

    modalCloseButtons.forEach((button) => {
      button.addEventListener('click', closeModal);
    });

    modal.addEventListener('click', (event) => {
      if (event.target === modal) {
        closeModal();
      }
    });

    modalInput.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        closeModal();
      }
      if (event.key === 'Enter') {
        event.preventDefault();
        modalSubmit.click();
      }
    });

    modalSubmit.addEventListener('click', () => {
      const trimmedName = modalInput.value.trim();
      if (!trimmedName) {
        window.alert('名前を入力してください');
        modalInput.focus();
        return;
      }

      addNameInput.value = trimmedName;
      closeModal();
      addForm.submit();
    });
  })();

  (function () {
    const dataScript = document.getElementById('clan-management-delegation-data');
    const modal = document.getElementById('clan-management-delegation-modal');
    const checkboxList = document.getElementById('clan-management-delegation-checkbox-list');
    const modalSubmit = document.getElementById('clan-management-delegation-modal-submit');
    const modalCloseButtons = Array.from(document.querySelectorAll('[data-clan-management-delegation-modal-close]'));
    const delegationForm = document.getElementById('clan-management-delegation-form');
    const delegationMemberIdInput = document.getElementById('clan-management-delegation-memberid');
    const delegateButtons = Array.from(document.querySelectorAll('.clan-management-delegate-button'));

    if (!dataScript || !modal || !checkboxList || !modalSubmit || !delegationForm || !delegationMemberIdInput || delegateButtons.length === 0) {
      return;
    }

    const parsedData = JSON.parse(dataScript.textContent || '{}');
    const members = Array.isArray(parsedData.members) ? parsedData.members : [];
    const delegations = Array.isArray(parsedData.delegations) ? parsedData.delegations : [];

    const delegationsByTarget = new Map();
    delegations.forEach((row) => {
      if (!row || typeof row.memberid !== 'string' || typeof row.delegateid !== 'string') {
        return;
      }
      if (!delegationsByTarget.has(row.delegateid)) {
        delegationsByTarget.set(row.delegateid, new Set());
      }
      delegationsByTarget.get(row.delegateid).add(row.memberid);
    });

    const closeModal = () => {
      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');
    };

    const openModal = (targetMemberId) => {
      delegationMemberIdInput.value = targetMemberId;
      checkboxList.innerHTML = '';

      const checkedIds = delegationsByTarget.get(targetMemberId) || new Set();
      members
        .filter((member) => member.memberid !== targetMemberId)
        .forEach((member) => {
          const row = document.createElement('label');
          row.className = 'clan-management-delegation-checkbox-row';

          const checkbox = document.createElement('input');
          checkbox.type = 'checkbox';
          checkbox.name = 'delegateMemberIds';
          checkbox.value = member.memberid;
          checkbox.checked = checkedIds.has(member.memberid);

          row.appendChild(checkbox);
          row.appendChild(document.createTextNode(member.name || 'Unknown'));
          checkboxList.appendChild(row);
        });

      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');
    };

    delegateButtons.forEach((button) => {
      button.addEventListener('click', () => {
        openModal(String(button.getAttribute('data-member-id') || ''));
      });
    });

    modalCloseButtons.forEach((button) => {
      button.addEventListener('click', closeModal);
    });

    modal.addEventListener('click', (event) => {
      if (event.target === modal) {
        closeModal();
      }
    });

    modalSubmit.addEventListener('click', () => {
      const checkedCheckboxes = Array.from(checkboxList.querySelectorAll('input[type="checkbox"]:checked'));
      checkedCheckboxes.forEach((checkbox) => {
        delegationForm.appendChild(checkbox.cloneNode(true));
      });
      closeModal();
      delegationForm.submit();
    });
  })();
</script>