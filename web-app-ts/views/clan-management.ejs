  }

  .clan-management-table tbody tr:hover {
    background: rgba(239, 246, 255, 1);
  }

  .clan-management-table tbody tr + tr td {
    border-top: 1px solid rgba(15, 23, 42, 0.06);
  }

  .clan-management-name-cell {
    font-weight: 700;
    color: #0f172a;
  }

  .clan-management-role-cell {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
  }

  .clan-management-role-badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
  }

  .clan-management-delegation-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  .clan-management-delegation-chip {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    padding: 0.28rem 0.55rem;
