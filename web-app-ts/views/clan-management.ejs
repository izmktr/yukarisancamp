  .clan-management-summary-chip strong {
    font-size: 1.05rem;
  }

  .clan-management-summary-chip.is-leader {
    background: rgba(245, 158, 11, 0.12);
    color: #92400e;
  }

  .clan-management-summary-chip.is-officer {
    background: rgba(59, 130, 246, 0.12);
    color: #1d4ed8;
  }

  .clan-management-actions {
    display: flex;
    justify-content: flex-end;
    margin: 0 0 1rem;
  }

  .clan-management-add-form {
    margin: 0;
  }

  .clan-management-add-button {
    border-radius: 999px;
    padding-inline: 1.1rem;
    box-shadow: 0 10px 24px rgba(37, 99, 235, 0.16);
  }

  .clan-management-modal {
    position: fixed;
    inset: 0;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    z-index: 50;
  }

  .clan-management-modal.is-open {
    display: flex;
  }

  .clan-management-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(15, 23, 42, 0.56);
    backdrop-filter: blur(6px);
  }

  .clan-management-modal-dialog {
    position: relative;
    width: min(100%, 28rem);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(248, 250, 252, 0.98));
    border: 1px solid rgba(15, 23, 42, 0.1);
    border-radius: 18px;
    box-shadow: 0 24px 80px rgba(15, 23, 42, 0.24);
    padding: 1.25rem;
    z-index: 1;
  }

  .clan-management-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .clan-management-modal-header h4 {
    margin: 0;
    font-size: 1.05rem;
    color: #0f172a;
  }

  .clan-management-modal-close {
    border: none;
    background: transparent;
    font-size: 1.5rem;
    line-height: 1;
    color: #64748b;
    cursor: pointer;
    padding: 0.25rem 0.4rem;
  }

  .clan-management-modal-description {
    margin: 0.75rem 0 1rem;
    color: #475569;
  }

  .clan-management-modal-label {
    display: block;
    margin-bottom: 0.35rem;
    font-weight: 700;
    color: #0f172a;
  }

  .clan-management-modal-input {
    width: 100%;
    border: 1px solid rgba(15, 23, 42, 0.16);
    border-radius: 12px;
    background: #fff;
    padding: 0.8rem 0.9rem;
    font-size: 1rem;
    color: #0f172a;
    outline: none;
  }

  .clan-management-modal-input:focus {
    border-color: #2563eb;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.16);
  }

  .clan-management-modal-actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .clan-management-modal-cancel {
    border-radius: 999px;
  }

  .clan-management-member-list-title {
    margin: 0 0 0.85rem;
    color: #0f172a;
    font-size: 1rem;
  }

  .clan-management-table-wrapper {
    overflow-x: auto;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.7);
  }

  .clan-management-table {
    width: 100%;
    border-collapse: collapse;
  }

  .clan-management-table thead th {
    background: linear-gradient(180deg, #111827, #1f2937);
    color: #fff;
    font-weight: 700;
    letter-spacing: 0.02em;
