<div class="clandata-detail-container">
  <div class="clandata-header">
    <h2>クランデータ詳細</h2>
    <% const hasClanName = clanData && typeof clanData.name === 'string' && clanData.name.trim().length > 0; %>
    <p class="clandata-id">
      <% if (hasClanName) { %>
        <strong><%= clanData.name %></strong>
      <% } else { %>
        クランID: <strong><%= clanId %></strong>
      <% } %>
    </p>
  </div>

  <% if (error) { %>
    <div class="error-message">
      <p><%= error %></p>
    </div>
  <% } else if (clanData) { %>
    <div class="clandata-content">
      <!-- ボスカウントセクション -->
      <% if (clanData.bosscount && Array.isArray(clanData.bosscount)) { %>
        <% 
          const numericBossCounts = clanData.bosscount.map((value) => Number(value));
          const minBossCount = numericBossCounts.length > 0 ? Math.min(...numericBossCounts) : 0;
        %>
        <section class="clandata-section">
          <h3>ボスカウント</h3>
          <div class="bosscount-display">
            <% clanData.bosscount.forEach((count, idx) => { %>
              <% 
                const currentCount = Number(count);
                let countStateClass = '';
                if (currentCount === minBossCount + 1) {
                  countStateClass = 'bosscount-near-min';
                } else if (currentCount >= minBossCount + 2) {
                  countStateClass = 'bosscount-far-min';
                }
              %>
              <div class="bosscount-item <%= countStateClass %>">
                <p>
                  <span class="boss-name-label" data-boss-index="<%= idx %>">ボス <%= idx + 1 %></span>:
                  <strong><%= Number(count) + 1 %></strong>
                </p>
              </div>
            <% }); %>
          </div>
        </section>
      <% } %>

      <!-- メンバー情報セクション -->
      <% if (clanData.members) { %>
        <% 
          const calcAttackCount = (member) => {
            const attackTimes = Array.isArray(member?.attacktime) ? member.attacktime : [];
            return attackTimes.reduce((sum, t) => {
              if (t === 0) return sum + 1;
              if (t === null) return sum;
              return sum + 0.5;
            }, 0);
          };

          const sortedMembers = Object.values(clanData.members).sort((left, right) => {
            const diff = calcAttackCount(left) - calcAttackCount(right);
            if (diff !== 0) {
              return diff;
            }
            return String(left?.name ?? '').localeCompare(String(right?.name ?? ''), 'ja');
          });

          const fullAttackMemberCount = sortedMembers.filter((member) => calcAttackCount(member) >= 3).length;
          const totalMemberCount = sortedMembers.length;
          const totalAttackCount = sortedMembers.reduce((sum, member) => sum + calcAttackCount(member), 0);
          const maxAttackCount = totalMemberCount * 3;
        %>
        <section class="clandata-section">
          <div class="clandata-section-header clandata-members-header">
            <h3>メンバー</h3>
            <button type="button" id="members-show-all-btn" class="members-show-all-btn" aria-pressed="false">全て表示</button>
          </div>
          <p class="members-attack-summary">完凸 <%= fullAttackMemberCount %>人/<%= totalMemberCount %>人(<%= totalAttackCount %>凸/<%= maxAttackCount %>凸)</p>
          <div class="members-table-wrapper">
            <table class="members-table">
              <thead>
                <tr>
                  <th>名前</th>
                  <th>攻撃数</th>
                  <th>履歴</th>
                  <th>前日</th>
                </tr>
              </thead>
              <tbody>
                <% for (const member of sortedMembers) { %>
                  <% 
                    const attackCount = calcAttackCount(member);
                    const hasTaskkill = !!(member.taskkill && member.taskkill !== 0);
                    const hideByDefault = attackCount >= 3;

                    const sortedPlan = Array.isArray(member.plan)
                      ? [...member.plan].sort((a, b) => Number(a) - Number(b))
                      : [];
                    const previousDay = sortedPlan.map((p) => Number(p) + 1).join(',');

                    const historyList = Array.isArray(member.history)
                      ? [...member.history]
                          .filter((item) => item && typeof item === 'object')
                          .sort((a, b) => {
                            const sortieDiff = Number(a.sortie) - Number(b.sortie);
                            if (sortieDiff !== 0) {
                              return sortieDiff;
                            }
                            return String(a.updatetime ?? '').localeCompare(String(b.updatetime ?? ''));
                          })
                      : [];
                  %>
                  <tr class="member-row <%= hideByDefault ? 'member-row-hidden-by-default' : '' %>" data-attack-count="<%= attackCount %>" data-hidden-by-default="<%= hideByDefault ? '1' : '0' %>">
                    <td class="member-name-cell">
                      <div class="member-name-content">
                        <span class="member-name-text"><%= member.name || 'Unknown' %></span>
                        <% if (hasTaskkill) { %>
                          <span class="member-taskkill-badge" aria-label="タスキルあり" title="タスキルあり">！</span>
                        <% } %>
                      </div>
                    </td>
                    <td><%= attackCount %></td>
                    <td class="member-history-cell member-mobile-optional-cell" data-mobile-hide-empty="1">
                      <% historyList.forEach((item) => { %>
                        <% 
                          const sortieNumber = Number(item.sortie);
                          const bossNumber = Number(item.boss);
                          const bossId = ((bossNumber % 5) + 5) % 5;
                          const loop = Math.floor(bossNumber / 5) + 1;
                          const optionText = item.defeat === true ? ` [討伐:${Number(item.overtime ?? 0)}]` : '';
                        %>
                        <div class="member-history-entry">
                          <%= sortieNumber + 1 %>凸 <%= loop %>周 <span class="boss-name-label" data-boss-index="<%= bossId %>">ボス <%= bossId + 1 %></span><%= optionText %>
                        </div>
                      <% }); %>
                    </td>
                    <td class="member-mobile-optional-cell" data-mobile-hide-empty="1"><%= previousDay %></td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </section>
      <% } %>

      <!-- ボス履歴 -->
      <% 
        const membersMap = clanData.members && typeof clanData.members === 'object' ? clanData.members : {};
        const memberHistoryList = Object.values(membersMap).flatMap((member) => {
          return member && Array.isArray(member.history) ? member.history : [];
        });
        const rootBossHistory = Array.isArray(clanData.bosshistory) ? clanData.bosshistory : [];
        const combinedBossHistory = [...rootBossHistory, ...memberHistoryList];

        const historyMap = new Map();
        combinedBossHistory.forEach((item) => {
          if (!item || typeof item !== 'object') {
            return;
          }
          const uniqueKey = [
            String(item.messageid ?? ''),
            String(item.member ?? ''),
            String(item.day ?? ''),
            String(item.sortie ?? ''),
            String(item.boss ?? ''),
            String(item.updatetime ?? '')
          ].join('|');
          if (!historyMap.has(uniqueKey)) {
            historyMap.set(uniqueKey, item);
          }
        });

        const mergedHistoryList = Array.from(historyMap.values()).filter((item) => {
          return item && typeof item === 'object' && Number.isFinite(Number(item.boss)) && Number.isFinite(Number(item.day));
        });
      %>
      <% if (mergedHistoryList.length > 0) { %>
        <% 
          const historyList = [...mergedHistoryList].sort((a, b) => {
            return String(a.updatetime ?? '').localeCompare(String(b.updatetime ?? ''));
          });

          const bossCountLoopNumbers = Array.isArray(clanData.bosscount)
            ? clanData.bosscount
                .map((value) => Number(value) + 1)
                .filter((value) => Number.isFinite(value) && value > 0)
            : [];
          const bossCountMaxLoopZeroBased = Array.isArray(clanData.bosscount)
            ? clanData.bosscount
                .map((value) => Number(value))
                .filter((value) => Number.isFinite(value) && value >= 0)
                .reduce((max, value) => Math.max(max, value), 0)
            : 0;

          const maxDay = historyList.reduce((max, item) => Math.max(max, Number(item.day)), 0);
          const maxHistoryLoop = historyList.reduce((max, item) => Math.max(max, Math.floor(Number(item.boss) / 5)), 0);
          const maxLoop = Math.max(maxHistoryLoop, bossCountMaxLoopZeroBased);
          const defaultVisibleMinLoop = Math.max(0, maxLoop - 5);
        %>
        <section class="clandata-section">
          <div class="clandata-section-header clandata-bosshistory-header">
            <h3>ボス履歴</h3>
            <button type="button" id="bosshistory-show-all-btn" class="bosshistory-show-all-btn" aria-pressed="false">全て表示</button>
          </div>
          <div class="bosshistory-mobile-filter" role="group" aria-label="ボス履歴フィルタ">
            <button type="button" class="bosshistory-filter-btn is-active" data-boss-filter="all">ALL</button>
            <button type="button" class="bosshistory-filter-btn" data-boss-filter="0">1</button>
            <button type="button" class="bosshistory-filter-btn" data-boss-filter="1">2</button>
            <button type="button" class="bosshistory-filter-btn" data-boss-filter="2">3</button>
            <button type="button" class="bosshistory-filter-btn" data-boss-filter="3">4</button>
            <button type="button" class="bosshistory-filter-btn" data-boss-filter="4">5</button>
          </div>
          <div class="bosshistory-mobile-selected-boss" aria-live="polite"></div>
          <div class="bosshistory-table-wrapper">
            <table class="bosshistory-table">
              <thead>
                <tr>
                  <th>周回数</th>
                  <th><span class="boss-name-label" data-boss-index="0">ボス1</span></th>
                  <th><span class="boss-name-label" data-boss-index="1">ボス2</span></th>
                  <th><span class="boss-name-label" data-boss-index="2">ボス3</span></th>
                  <th><span class="boss-name-label" data-boss-index="3">ボス4</span></th>
                  <th><span class="boss-name-label" data-boss-index="4">ボス5</span></th>
                </tr>
              </thead>
              <tbody>
                <% for (let loop = maxLoop; loop >= 0; loop -= 1) { %>
                  <% const loopNumber = loop + 1; %>
                  <% const hideByDefault = loop < defaultVisibleMinLoop; %>
                  <tr class="bosshistory-row <%= hideByDefault ? 'bosshistory-row-hidden-by-default' : '' %>" data-loop-number="<%= loopNumber %>" data-hidden-by-default="<%= hideByDefault ? '1' : '0' %>">
                    <td class="bosshistory-loop"><%= loopNumber %></td>
                    <% for (let bossid = 0; bossid < 5; bossid += 1) { %>
                      <% const isBossCountMatchedCell = bossCountLoopNumbers[bossid] === loopNumber; %>
                      <% 
                        const cellItems = historyList
                          .filter((item) => Math.floor(Number(item.boss) / 5) === loop && Number(item.boss) % 5 === bossid)
                          .sort((a, b) => {
                            const timeDiff = String(a.updatetime ?? '').localeCompare(String(b.updatetime ?? ''));
                            if (timeDiff !== 0) {
                              return timeDiff;
                            }
                            return Number(a.sortie) - Number(b.sortie);
                          });
                      %>
                      <td class="bosshistory-cell <%= isBossCountMatchedCell ? 'bosshistory-cell-bosscount-match' : '' %>" data-boss-index="<%= bossid %>">
                        <div class="bosshistory-mobile-boss-label">
                          <span class="boss-name-label" data-boss-index="<%= bossid %>">ボス<%= bossid + 1 %></span>
                        </div>
                        <% cellItems.forEach((item) => { %>
                          <% 
                            const memberIdText = item.member === null || item.member === undefined
                              ? ''
                              : String(item.member);
                            const matchedMemberEntry = Object.entries(membersMap).find(([memberId]) => String(memberId) === memberIdText);
                            const memberData = matchedMemberEntry ? matchedMemberEntry[1] : null;
                            const memberName = memberData && typeof memberData.name === 'string'
                              ? memberData.name
                              : '(不明)';
                            const hasKnownMemberName = memberName !== '(不明)';

                            let option = '';
                            if (item.defeat === true) {
                              option = ` [討伐:${Number(item.overtime ?? 0)}]`;
                            } else if (item.defeat === false && Number(item.sortiecount ?? 0) < 1) {
                              option = ' [持]';
                            }

                            const entryText = `${Number(item.sortie) + 1}凸 ${memberName}${option}`;
                            const fadedClass = Number(item.day) !== maxDay ? 'history-old-day' : '';
                          %>
                          <div class="bosshistory-entry <%= fadedClass %>" data-has-player-name="<%= hasKnownMemberName ? '1' : '0' %>"><%= entryText %></div>
                        <% }); %>
                      </td>
                    <% } %>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </section>

        <% 
          const memberHistoryMap = new Map();
          historyList.forEach((item) => {
            const bossNumber = Number(item.boss);
            const dayNumber = Number(item.day);
            const sortieNumber = Number(item.sortie);
            if (!Number.isFinite(bossNumber) || !Number.isFinite(dayNumber) || !Number.isFinite(sortieNumber)) {
              return;
            }

            const bossId = ((bossNumber % 5) + 5) % 5;
            const memberIdText = item.member === null || item.member === undefined
              ? ''
              : String(item.member);

            if (!memberHistoryMap.has(memberIdText)) {
              const matchedMemberEntry = Object.entries(membersMap).find(([memberId]) => String(memberId) === memberIdText);
              const memberData = matchedMemberEntry ? matchedMemberEntry[1] : null;
              const memberName = memberData && typeof memberData.name === 'string'
                ? memberData.name
                : '(不明)';

              memberHistoryMap.set(memberIdText, {
                memberName,
                bossEntries: [[], [], [], [], []]
              });
            }

            memberHistoryMap.get(memberIdText).bossEntries[bossId].push(item);
          });

          const memberHistoryRows = Array.from(memberHistoryMap.values())
            .map((row) => ({
              memberName: row.memberName,
              bossEntries: row.bossEntries.map((entries) => [...entries].sort((a, b) => {
                const timeDiff = String(a.updatetime ?? '').localeCompare(String(b.updatetime ?? ''));
                if (timeDiff !== 0) {
                  return timeDiff;
                }
                return Number(a.sortie) - Number(b.sortie);
              }))
            }))
            .sort((left, right) => String(left.memberName ?? '').localeCompare(String(right.memberName ?? ''), 'ja'));
        %>
        <section class="clandata-section">
          <div class="clandata-section-header clandata-memberhistory-header">
            <h3>メンバー履歴</h3>
            <button type="button" id="memberhistory-toggle-btn" class="memberhistory-toggle-btn" aria-pressed="false">表示する</button>
          </div>
          <div id="memberhistory-container" class="memberhistory-container">
            <% if (memberHistoryRows.length > 0) { %>
              <div class="memberhistory-table-wrapper">
                <table class="memberhistory-table">
                  <thead>
                    <tr>
                      <th>メンバー</th>
                      <th><span class="boss-name-label" data-boss-index="0">ボス1</span></th>
                      <th><span class="boss-name-label" data-boss-index="1">ボス2</span></th>
                      <th><span class="boss-name-label" data-boss-index="2">ボス3</span></th>
                      <th><span class="boss-name-label" data-boss-index="3">ボス4</span></th>
                      <th><span class="boss-name-label" data-boss-index="4">ボス5</span></th>
                    </tr>
                  </thead>
                  <tbody>
                    <% memberHistoryRows.forEach((row) => { %>
                      <tr>
                        <td class="memberhistory-member-cell"><%= row.memberName %></td>
                        <% for (let bossid = 0; bossid < 5; bossid += 1) { %>
                          <td class="memberhistory-cell" data-boss-index="<%= bossid %>">
                            <% row.bossEntries[bossid].forEach((item) => { %>
                              <% 
                                let option = '';
                                if (item.defeat === true) {
                                  option = ` [討伐:${Number(item.overtime ?? 0)}]`;
                                } else if (item.defeat === false && Number(item.sortiecount ?? 0) < 1) {
                                  option = ' [持]';
                                }

                                const entryText = `${Number(item.day) + 1}日目 ${Number(item.sortie) + 1}凸${option}`;
                                const fadedClass = Number(item.day) !== maxDay ? 'history-old-day' : '';
                              %>
                              <div class="memberhistory-entry <%= fadedClass %>"><%= entryText %></div>
                            <% }); %>
                          </td>
                        <% } %>
                      </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>
            <% } else { %>
              <p class="memberhistory-empty">表示できる履歴がありません</p>
            <% } %>
          </div>
        </section>
      <% } %>

    </div>
  <% } else { %>
    <div class="no-data-message">
      <p>クランデータが利用可能ではありません</p>
    </div>
  <% } %>
</div>

<script>
  async function replaceBossCountLabelsFromClanBattleSettings() {
    const labelElements = Array.from(document.querySelectorAll('.boss-name-label[data-boss-index]'));
    if (labelElements.length === 0 || !window.firebase) {
      return;
    }

    try {
      const yearmonth = getBaseYearMonth();

      const app = window.firebase.apps && window.firebase.apps.length > 0
        ? window.firebase.app()
        : window.firebase.initializeApp(window.__FIREBASE_CONFIG__ || {});
      const firestore = app.firestore();
      const snap = await firestore.collection('clanBattles').doc(yearmonth).get();

      if (!snap.exists) {
        return;
      }

      const data = snap.data() || {};
      const bossNames = Array.isArray(data.bossname) ? data.bossname : [];

      labelElements.forEach((element) => {
        const index = Number(element.getAttribute('data-boss-index'));
        const bossName = typeof bossNames[index] === 'string' ? bossNames[index].trim() : '';
        if (bossName.length > 0) {
          element.textContent = bossName;
        }
      });
    } catch (error) {
      console.error('クラバト設定のボス名取得に失敗しました:', error);
    }
  }

  function initBossHistoryMobileFilter() {
    if (!window.matchMedia || !window.matchMedia('(max-width: 768px)').matches) {
      return;
    }

    const filterContainer = document.querySelector('.bosshistory-mobile-filter');
    const filterButtons = Array.from(document.querySelectorAll('.bosshistory-filter-btn[data-boss-filter]'));
    const selectedBossLine = document.querySelector('.bosshistory-mobile-selected-boss');
    const historyRows = Array.from(document.querySelectorAll('.bosshistory-table tbody tr'));

    if (!filterContainer || filterButtons.length === 0 || historyRows.length === 0) {
      return;
    }

    const getBossName = (bossIndex) => {
      const label = document.querySelector(`.bosshistory-table thead .boss-name-label[data-boss-index="${bossIndex}"]`);
      const text = label ? String(label.textContent || '').trim() : '';
      if (text.length > 0) {
        return text;
      }
      return `ボス${Number(bossIndex) + 1}`;
    };

    const setFilter = (bossFilter) => {
      const showAll = isBossHistoryShowAllEnabled();
      const isAll = bossFilter === 'all';

      filterButtons.forEach((button) => {
        button.classList.toggle('is-active', button.getAttribute('data-boss-filter') === bossFilter);
      });

      if (selectedBossLine) {
        if (isAll) {
          selectedBossLine.textContent = '';
          selectedBossLine.classList.remove('is-visible');
        } else {
          selectedBossLine.textContent = getBossName(bossFilter);
          selectedBossLine.classList.add('is-visible');
        }
      }

      const rowStates = [];

      historyRows.forEach((row) => {
        const cells = Array.from(row.querySelectorAll('.bosshistory-cell[data-boss-index]'));
        let hasVisibleEntryInRow = false;

        cells.forEach((cell) => {
          const cellBossIndex = String(cell.getAttribute('data-boss-index'));
          const showCell = isAll || cellBossIndex === bossFilter;
          cell.style.display = showCell ? '' : 'none';

          const cellBossLabel = cell.querySelector('.bosshistory-mobile-boss-label');
          if (cellBossLabel) {
            cellBossLabel.style.display = isAll ? '' : 'none';
          }

          const entries = Array.from(cell.querySelectorAll('.bosshistory-entry'));
          if (isAll || !showCell) {
            entries.forEach((entry) => {
              entry.style.display = '';
            });
            if (showCell && entries.length > 0) {
              hasVisibleEntryInRow = true;
            }
            return;
          }

          let hasVisibleEntryInCell = false;
          entries.forEach((entry) => {
            const hasPlayerName = entry.getAttribute('data-has-player-name') === '1';
            entry.style.display = hasPlayerName ? '' : 'none';
            if (hasPlayerName) {
              hasVisibleEntryInCell = true;
            }
          });

          if (hasVisibleEntryInCell) {
            hasVisibleEntryInRow = true;
          }
        });

        rowStates.push({
          row,
          hasVisibleEntryInRow,
          loopNumber: Number(row.getAttribute('data-loop-number') || '0'),
          hiddenByDefault: row.getAttribute('data-hidden-by-default') === '1'
        });
      });

      if (isAll) {
        rowStates.forEach(({ row, hiddenByDefault }) => {
          const shouldShowRow = showAll || !hiddenByDefault;
          row.style.display = shouldShowRow ? '' : 'none';
        });
        return;
      }

      const highestLoopWithPlayer = rowStates.reduce((max, state) => {
        if (!state.hasVisibleEntryInRow) {
          return max;
        }
        return Math.max(max, state.loopNumber);
      }, -1);

      rowStates.forEach(({ row, hasVisibleEntryInRow, loopNumber, hiddenByDefault }) => {
        const shouldShowByFilter = highestLoopWithPlayer >= 0 && (hasVisibleEntryInRow || loopNumber <= highestLoopWithPlayer);
        const shouldShowByLoopToggle = showAll || !hiddenByDefault;
        const shouldShowRow = shouldShowByFilter && shouldShowByLoopToggle;
        row.style.display = shouldShowRow ? '' : 'none';
      });
    };

    filterContainer.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLElement)) {
        return;
      }
      const button = target.closest('.bosshistory-filter-btn[data-boss-filter]');
      if (!(button instanceof HTMLElement)) {
        return;
      }
      const bossFilter = String(button.getAttribute('data-boss-filter') || 'all');
      setFilter(bossFilter);
    });

    document.addEventListener('bosshistory:showall-changed', () => {
      const activeButton = filterContainer.querySelector('.bosshistory-filter-btn.is-active[data-boss-filter]');
      const currentFilter = activeButton instanceof HTMLElement
        ? String(activeButton.getAttribute('data-boss-filter') || 'all')
        : 'all';
      setFilter(currentFilter);
    });

    setFilter('all');
  }

  document.addEventListener('DOMContentLoaded', async () => {
    await replaceBossCountLabelsFromClanBattleSettings();
    initBossHistoryLoopToggle();
    initBossHistoryMobileFilter();
    initMemberHistoryToggle();
    initMembersAttackCountToggle();
  });

  function initMemberHistoryToggle() {
    const toggleButton = document.getElementById('memberhistory-toggle-btn');
    const historyContainer = document.getElementById('memberhistory-container');

    if (!(toggleButton instanceof HTMLButtonElement) || !(historyContainer instanceof HTMLElement)) {
      return;
    }

    let isOpen = false;

    const applyState = () => {
      historyContainer.classList.toggle('is-open', isOpen);
      toggleButton.textContent = isOpen ? '閉じる' : '表示する';
      toggleButton.classList.toggle('is-active', isOpen);
      toggleButton.setAttribute('aria-pressed', isOpen ? 'true' : 'false');
    };

    toggleButton.addEventListener('click', () => {
      isOpen = !isOpen;
      applyState();
    });

    applyState();
  }

  function isBossHistoryShowAllEnabled() {
    const toggleButton = document.getElementById('bosshistory-show-all-btn');
    if (!(toggleButton instanceof HTMLButtonElement)) {
      return false;
    }
    return toggleButton.getAttribute('aria-pressed') === 'true';
  }

  function initBossHistoryLoopToggle() {
    const toggleButton = document.getElementById('bosshistory-show-all-btn');
    const historyRows = Array.from(document.querySelectorAll('.bosshistory-row[data-hidden-by-default]'));

    if (!(toggleButton instanceof HTMLButtonElement) || historyRows.length === 0) {
      return;
    }

    let showAll = false;

    const applyState = () => {
      const isMobile = window.matchMedia && window.matchMedia('(max-width: 768px)').matches;

      historyRows.forEach((row) => {
        const hiddenByDefault = row.getAttribute('data-hidden-by-default') === '1';
        const shouldHide = !showAll && hiddenByDefault;
        row.classList.toggle('bosshistory-row-hidden-by-default', shouldHide);

        if (!isMobile) {
          row.style.display = shouldHide ? 'none' : 'table-row';
        }
      });

      toggleButton.textContent = showAll ? '絞り込む' : '全て表示';
      toggleButton.classList.toggle('is-active', showAll);
      toggleButton.setAttribute('aria-pressed', showAll ? 'true' : 'false');

      document.dispatchEvent(new CustomEvent('bosshistory:showall-changed'));
    };

    toggleButton.addEventListener('click', () => {
      showAll = !showAll;
      applyState();
    });

    applyState();
  }

  function initMembersAttackCountToggle() {
    const toggleButton = document.getElementById('members-show-all-btn');
    const memberRows = Array.from(document.querySelectorAll('.member-row[data-attack-count]'));

    if (!(toggleButton instanceof HTMLButtonElement) || memberRows.length === 0) {
      return;
    }

    let showAll = false;

    const applyState = () => {
      const isMobile = window.matchMedia && window.matchMedia('(max-width: 768px)').matches;

      memberRows.forEach((row) => {
        const attackCount = Number(row.getAttribute('data-attack-count') || '0');
        const shouldHide = !showAll && attackCount >= 3;
        row.classList.toggle('member-row-hidden-by-default', shouldHide);
        row.style.display = shouldHide ? 'none' : (isMobile ? 'block' : 'table-row');
      });

      applyMembersMobileEmptyFieldVisibility(isMobile);

      toggleButton.textContent = showAll ? '絞り込む' : '全て表示';
      toggleButton.classList.toggle('is-active', showAll);
      toggleButton.setAttribute('aria-pressed', showAll ? 'true' : 'false');
    };

    toggleButton.addEventListener('click', () => {
      showAll = !showAll;
      applyState();
    });

    applyState();

    if (window.matchMedia) {
      const mediaQuery = window.matchMedia('(max-width: 768px)');
      const handleViewportChange = () => {
        applyMembersMobileEmptyFieldVisibility(mediaQuery.matches);
      };

      if (typeof mediaQuery.addEventListener === 'function') {
        mediaQuery.addEventListener('change', handleViewportChange);
      } else if (typeof mediaQuery.addListener === 'function') {
        mediaQuery.addListener(handleViewportChange);
      }
    }
  }

  function applyMembersMobileEmptyFieldVisibility(isMobile) {
    const optionalCells = Array.from(document.querySelectorAll('.member-mobile-optional-cell[data-mobile-hide-empty="1"]'));

    optionalCells.forEach((cell) => {
      if (!(cell instanceof HTMLElement)) {
        return;
      }

      if (!isMobile) {
        cell.style.display = '';
        return;
      }

      const hasHistoryEntry = cell.classList.contains('member-history-cell')
        ? cell.querySelectorAll('.member-history-entry').length > 0
        : false;

      const textContent = String(cell.textContent || '').trim();
      const hasContent = hasHistoryEntry || textContent.length > 0;
      cell.style.display = hasContent ? 'grid' : 'none';
    });
  }
