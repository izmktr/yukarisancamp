<div class="page-content">
        <% 
            const difficultyLabelByLevel = {
                1: 'フルオート',
                2: 'セミオート',
                3: '簡単',
                4: '普通',
                5: '高難度'
            };
            const difficultyValue = difficultyLabelByLevel[Number(article.difficulty)] || '';
            const postCommentText = article.postComment || article.postcomment || '';
            const visibilityRaw = String(article.visibility || article.visibilality || '').toLowerCase();
            const visibilityLabelByValue = {
                all: '全体',
                clan: 'クラン',
                self: '自分'
            };
            const visibilityValue = visibilityLabelByValue[visibilityRaw] || visibilityRaw;
            const bossValue = article.bossname || '';
            const damageValue = article.damage || '';
            const battleStartRow = Array.isArray(ubRows)
                ? ubRows.find((row) => row && row.ubText === 'バトル開始' && typeof row.time === 'string')
                : null;
            const battleStartMatch = String(battleStartRow?.time || '').trim().match(/^(\d{1,2}):(\d{2})$/);
            const battleTimeMatch = String(article.battleTime || '').trim().match(/^(\d{1,2}):(\d{2})$/);
            const battleTimeSeconds = battleStartMatch
                ? (Number(battleStartMatch[1]) * 60) + Number(battleStartMatch[2])
                : (battleTimeMatch
                    ? (Number(battleTimeMatch[1]) * 60) + Number(battleTimeMatch[2])
                    : 0);
        %>
        <p>
            <a href="/board" class="btn">一覧へ戻る</a>
        </p>
        <div class="board-page-title-row">
            <h2><%= article.postTitle || '記事詳細' %></h2>
            <button id="board-help-toggle" type="button" class="btn board-help-toggle-btn" aria-controls="board-help-panel" aria-expanded="false">使い方</button>
        </div>
        <section id="board-help-panel" class="board-help-panel" hidden>
            <h3>記事詳細の使い方</h3>
            <ul>
                <li>表示切り替えは「すべて」「操作」「操作+1つ前」から選べます。操作行だけ確認したい場合は「操作」、行動の流れも見たい場合は「操作+1つ前」が便利です。</li>
                <li>サイズは「大 / 中 / 小」で切り替えできます。スマホで見切れる場合は「小」にすると全体を確認しやすくなります。</li>
                <li>残り時間が90秒でない場合は、「入力時間」に秒数を入れて「変更」を押すと残り時間に合わせて時間が再計算されます。</li>
                <li>「エクスポート」では現在の表示内容をテキスト化できます。</li>
                <li>「差分」では別のTLとの差分確認ができます。どこでずれているかを調べる事ができます。</li>
                <li>「カスタム」で編成キャラの表示名変更と所持チェックができます。ログインしていれば、内容を保存します。</li>
                <li>自身の投稿であれば「編集」「削除」が使えます。削除は取り消せないため、実行前に内容を確認してください。</li>
            </ul>
        </section>
    <div class="board-detail">
        <section class="post-info-editor" aria-label="情報">
            <h3>情報</h3>

            <div class="post-info-row post-info-row-static post-info-row-inline">
                <div class="post-info-inline-group">
                    <div class="post-info-pill" role="group" aria-label="ボス">
                        <span class="post-info-pill-key">ボス</span>
                        <span class="post-info-pill-value"><%= bossValue %></span>
                    </div>
                    <div class="post-info-pill" role="group" aria-label="ダメージ">
                        <span class="post-info-pill-key">ダメージ</span>
                        <span class="post-info-pill-value"><%= damageValue %></span>
                    </div>
                    <div class="post-info-pill" role="group" aria-label="難易度">
                        <span class="post-info-pill-key">難易度</span>
                        <span class="post-info-pill-value"><%= difficultyValue %></span>
                    </div>
                    <div class="post-info-pill" role="group" aria-label="公開範囲">
                        <span class="post-info-pill-key">公開範囲</span>
                        <span class="post-info-pill-value"><%= visibilityValue %></span>
                    </div>
                </div>
            </div>

            <% if (postCommentText.trim().length > 0) { %>
                <div class="post-info-row post-info-row-static">
                    <div class="post-info-static-value post-info-static-value-multiline post-info-static-value-titlelike"><%= postCommentText %></div>
                </div>
            <% } %>
        </section>

        <div class="board-party-heading">
            <h3>パーティ編成</h3>
            <% if (partyMembers && partyMembers.length > 0) { %>
                <button type="button" id="board-party-customize-open" class="btn btn-primary">カスタム</button>
            <% } %>
        </div>
        <% if (partyMembers && partyMembers.length > 0) { %>
            <% const partyDisplayMembers = partyMembers.slice().reverse(); %>
            <div class="board-party-grid">
                <% partyDisplayMembers.forEach(function(member) { %>
                    <div class="board-party-card" data-party-official-name="<%= member.name %>">
                        <% if (member.imagePath) { %>
                            <img src="<%= member.imagePath %>" alt="<%= member.name %>" class="board-party-image" data-party-image="true" />
                        <% } else { %>
                            <div class="board-party-image board-party-image-missing">NO IMAGE</div>
                        <% } %>
                        <div class="board-party-name" data-party-name-text="true"><%= member.name %></div>
                        <div class="board-party-stats"><%
                            const stats = [];
                            if (member.star !== null) stats.push(`★${member.star}`);
                            if (member.level !== null) stats.push(`Lv${member.level}`);
                            if (member.rank !== null) stats.push(`RANK${member.rank}`);
                        %><%= stats.length > 0 ? stats.join(' ') : '' %></div>
                    </div>
                <% }); %>
            </div>

            <div id="board-party-customize-modal" class="board-party-modal" hidden>
                <div class="board-party-modal-backdrop" data-party-modal-close="true"></div>
                <div class="board-party-modal-window" role="dialog" aria-modal="true" aria-labelledby="board-party-modal-title">
                    <div class="board-party-modal-header">
                        <h4 id="board-party-modal-title">パーティカスタム</h4>
                        <div class="board-party-modal-actions">
                            <button type="button" id="board-party-customize-save" class="btn btn-primary">保存</button>
                            <button type="button" id="board-party-customize-discard" class="btn">破棄</button>
                        </div>
                    </div>
                    <div id="board-party-customize-status" class="board-party-customize-status" role="status" aria-live="polite"></div>
                    <div id="board-party-customize-list" class="board-party-customize-list"></div>
                </div>
            </div>
        <% } else { %>
            <p>未登録</p>
        <% } %>

        <h3>ユニオンバースト発動時間</h3>
        <% if (ubRows && ubRows.length > 0) { %>
            <% const partySlots = (partyMembers && partyMembers.length > 0) ? partyMembers.slice().reverse() : []; %>
            <% const DETAIL_COMMENT_COLSPAN = 7; %>
            <div class="ub-toolbar">
                <div class="ub-toolbar-main">
                    <div class="ub-control-panel">
                        <div class="ub-display-toggle" role="group" aria-label="表示切り替え">
                            <button type="button" class="ub-display-toggle-btn is-active" data-display-mode="all">すべて</button>
                            <button type="button" class="ub-display-toggle-btn" data-display-mode="operation">操作</button>
                            <button type="button" class="ub-display-toggle-btn" data-display-mode="operation-plus-prev">操作+1つ前</button>
                        </div>
                        <div class="ub-size-toggle" role="group" aria-label="サイズ">
                            <span class="ub-size-toggle-label">サイズ</span>
                            <button type="button" class="ub-size-toggle-btn is-active" data-icon-size="large">大</button>
                            <button type="button" class="ub-size-toggle-btn" data-icon-size="medium">中</button>
                            <button type="button" class="ub-size-toggle-btn" data-icon-size="small">小</button>
                        </div>
                        <div class="ub-time-adjust" role="group" aria-label="残り時間の調整">
                            <span class="ub-time-adjust-label">残り時間</span>
                            <input type="text" id="ub-time-adjust-input" class="ub-time-adjust-input" inputmode="numeric" value="<%= battleTimeSeconds > 0 ? battleTimeSeconds : '' %>" data-battle-time="<%= battleTimeSeconds %>" aria-label="入力時間" />
                            <button type="button" id="ub-time-adjust-button" class="ub-time-adjust-button">変更</button>
                        </div>
                    </div>
                </div>
                <div class="ub-toolbar-actions">
                    <button type="button" id="board-export-open-button" class="btn">エクスポート</button>
                    <button type="button" class="btn" onclick="location.href='/board/<%= id %>/diff'">差分</button>
                    <% if (canEdit) { %>
                    <a href="/board/<%= id %>/edit" class="btn btn-primary">編集</a>
                    <form method="post" action="/board/<%= id %>/delete" onsubmit="return confirm('この記事を削除します。よろしいですか？');">
                        <button type="submit" class="btn btn-danger">削除</button>
                    </form>
                    <% } %>
                </div>
            </div>
            <div class="ub-table-wrapper">
                <table class="ub-table">
                    <thead>
                        <tr>
                            <th>残り時間</th>
                            <th>UB</th>
                            <th class="ub-header-party-cell" colspan="5">編成</th>
                            <th class="ub-auto-cell">Auto</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% ubRows.forEach(function(row) { %>
                            <% const rowActiveIcons = Array.isArray(row.activeIcons) ? row.activeIcons : []; %>
                            <% const hasServerActive = rowActiveIcons.length > 0 || row.autoActive; %>
                            <% const isPartyCharRow = partySlots.some(function(s) { return s && s.name === row.ubText; }); %>
                            <tr class="<%= hasServerActive ? 'ub-row-has-active' : '' %> <%= row.comment ? 'has-comment-row' : '' %>" data-is-battle-start="<%= row.ubText === 'バトル開始' ? 'true' : 'false' %>" data-is-battle-end="<%= row.ubText === 'バトル終了' ? 'true' : 'false' %>" data-is-added-row="<%= row.isAddedRow ? 'true' : 'false' %>" data-timing="<%= row.timing ? 'true' : 'false' %>" data-ub-text="<%= encodeURIComponent(row.ubText || '') %>" data-party-character-official-name="<%= isPartyCharRow ? row.ubText : '' %>">
                                <td class="ub-time-cell"><%= row.time || '' %></td>
                                <td class="ub-event-cell">
                                    <div class="ub-event-cell-inner">
                                        <% if (row.ubImagePath) { %>
                                            <img src="<%= row.ubImagePath %>" alt="<%= row.ubText %>" title="<%= row.ubText %>" class="ub-event-image" data-ub-event-image="true" />
                                        <% } else if (row.ubText) { %>
                                            <div class="ub-event-image-missing ub-event-image-missing-blue" data-ub-event-text="true"><%= row.ubText %></div>
                                        <% } %>
                                        <% if (isPartyCharRow) { %>
                                            <span class="ub-state-badge" aria-hidden="true"></span>
                                        <% } %>
                                        <% if (row.timing) { %>
                                            <img src="/images/icon_bomb.png" alt="目押し" class="ub-timing-hoshi" />
                                        <% } %>
                                    </div>
                                </td>
                                <% for (let i = 0; i < 5; i += 1) { %>
                                    <% const partySlot = partySlots[i]; %>
                                    <% const isTimingPartySlot = row.timing && partySlot && partySlot.name === row.ubText; %>
                                    <td class="ub-party-cell">
                                        <% if (partySlot && partySlot.imagePath) { %>
                                            <div class="ub-icon-box <%= isTimingPartySlot ? 'ub-timing-target' : '' %>" data-icon-type="image" data-is-active="<%= rowActiveIcons.includes(i) ? 'true' : 'false' %>" data-party-slot-name="<%= partySlot.name %>" data-party-slot-official-name="<%= partySlot.name %>">
                                                <img src="<%= partySlot.imagePath %>" alt="<%= partySlot.name %>" title="<%= partySlot.name %>" class="ub-party-image <%= rowActiveIcons.includes(i) ? '' : 'ub-party-image-mono' %>" />
                                                <span class="ub-set-badge">SET!</span>
                                                <% if (isTimingPartySlot) { %>
                                                    <img src="/images/icon_bomb.png" alt="目押し" class="ub-timing-hoshi" />
                                                <% } %>
                                            </div>
                                        <% } else if (partySlot) { %>
                                            <div class="ub-icon-box <%= isTimingPartySlot ? 'ub-timing-target' : '' %>" data-icon-type="placeholder" data-is-active="<%= rowActiveIcons.includes(i) ? 'true' : 'false' %>" data-party-slot-name="<%= partySlot.name %>" data-party-slot-official-name="<%= partySlot.name %>">
                                                <div class="<%= rowActiveIcons.includes(i) ? 'ub-party-image-missing ub-party-image-missing-blue' : 'ub-party-image-missing ub-party-image-missing-gray' %>"><%= partySlot.name %></div>
                                                <span class="ub-set-badge">SET!</span>
                                                <% if (isTimingPartySlot) { %>
                                                    <img src="/images/icon_bomb.png" alt="目押し" class="ub-timing-hoshi" />
                                                <% } %>
                                            </div>
                                        <% } else { %>
                                            <div class="ub-icon-box" data-icon-type="placeholder" data-is-active="false">
                                                <div class="ub-party-image-missing ub-party-image-missing-gray"></div>
                                                <span class="ub-set-badge">SET!</span>
                                            </div>
                                        <% } %>
                                    </td>
                                <% } %>
                                <td class="ub-auto-cell">
                                    <div class="ub-icon-box ub-auto-icon-box" data-icon-type="auto" data-is-active="<%= row.autoActive ? 'true' : 'false' %>">
                                        <div class="ub-auto-btn <%= row.autoActive ? 'ub-auto-btn-active' : 'ub-auto-btn-inactive' %>">
                                            <span class="ub-auto-label">OFF</span>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                            <% if (row.comment) { %>
                                <tr class="ub-comment-row">
                                    <td class="ub-comment-prefix-cell"></td>
                                    <td class="ub-comment-cell" colspan="<%= DETAIL_COMMENT_COLSPAN %>">
                                        <div class="ub-comment-display"><%= row.comment %></div>
                                    </td>
                                </tr>
                            <% } %>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <p>未登録</p>
        <% } %>

        <p>
            <a href="/board" class="btn">一覧へ戻る</a>
        </p>
    </div>
</div>

<div id="board-export-modal" class="board-export-modal" data-boss-name="<%= bossValue %>" data-damage="<%= damageValue %>" hidden>
    <div class="board-export-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="board-export-modal-title">
        <div class="board-export-modal-header-row">
            <h3 id="board-export-modal-title" class="board-export-modal-title">エクスポート</h3>
            <button type="button" id="board-export-close-button" class="btn">閉じる</button>
        </div>
        <div class="board-export-options" role="group" aria-label="エクスポートオプション">
            <label class="board-export-option-item">
                <input type="checkbox" id="board-export-option-show-onoff" />
                <span>On/Offキャラを表示する</span>
            </label>
            <label class="board-export-option-item">
                <input type="checkbox" id="board-export-option-uppercase-switch" />
                <span>切り替えるキャラを大文字にする</span>
            </label>
        </div>
        <textarea id="board-export-textarea" class="board-export-textarea" rows="12" aria-label="エクスポートテキスト"></textarea>
        <div class="board-export-modal-actions">
            <button type="button" id="board-export-copy-button" class="btn">クリップボードにコピー</button>
            <button type="button" id="board-export-download-button" class="btn btn-primary">ダウンロード</button>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const PARTY_COLUMN_COUNT = 5;
        const DISPLAY_MODE_ALL = 'all';
        const DISPLAY_MODE_OPERATION = 'operation';
        const DISPLAY_MODE_OPERATION_PLUS_PREV = 'operation-plus-prev';
        const ICON_SIZE_LARGE = 'large';
        const ICON_SIZE_MEDIUM = 'medium';
        const ICON_SIZE_SMALL = 'small';
        const IS_LOGGED_IN = <%- JSON.stringify(!!isLoggedIn) %>;
        const INITIAL_PARTY_MEMBERS = <%- JSON.stringify(((partyMembers || []).slice().reverse()).map((member) => ({
            officialName: member.name,
            imagePath: member.imagePath || ''
        }))) %>;
        let currentDisplayMode = DISPLAY_MODE_ALL;
        const timeAdjustInput = document.getElementById('ub-time-adjust-input');
        const timeAdjustButton = document.getElementById('ub-time-adjust-button');
        const exportModal = document.getElementById('board-export-modal');
        const exportOpenButton = document.getElementById('board-export-open-button');
        const exportCloseButton = document.getElementById('board-export-close-button');
        const exportTextarea = document.getElementById('board-export-textarea');
        const exportCopyButton = document.getElementById('board-export-copy-button');
        const exportDownloadButton = document.getElementById('board-export-download-button');
        const exportShowOnOffOption = document.getElementById('board-export-option-show-onoff');
        const exportUppercaseSwitchOption = document.getElementById('board-export-option-uppercase-switch');
        const EXPORT_OPTION_COOKIE_MAX_AGE_SECONDS = 60 * 60 * 24 * 365;
        const EXPORT_OPTION_SHOW_ONOFF_KEY = 'boardExportShowOnOff';
        const EXPORT_OPTION_UPPERCASE_SWITCH_KEY = 'boardExportUppercaseSwitch';
        const BOARD_DISPLAY_MODE_COOKIE_KEY = 'boardDetailDisplayMode';
        const BOARD_ICON_SIZE_COOKIE_KEY = 'boardDetailIconSize';
        let currentBattleTimeSeconds = 0;
        let currentInputSeconds = 0;
        let currentIconSize = ICON_SIZE_LARGE;
        const partyCustomizeOpenButton = document.getElementById('board-party-customize-open');
        const partyCustomizeModal = document.getElementById('board-party-customize-modal');
        const partyCustomizeList = document.getElementById('board-party-customize-list');
        const partyCustomizeSaveButton = document.getElementById('board-party-customize-save');
        const partyCustomizeDiscardButton = document.getElementById('board-party-customize-discard');
        const partyCustomizeStatus = document.getElementById('board-party-customize-status');
        const partyStateByOfficialName = new Map();
        let partyDraftByOfficialName = new Map();

        function clearPartyCustomizeStatus() {
            if (!(partyCustomizeStatus instanceof HTMLElement)) {
                return;
            }
            partyCustomizeStatus.textContent = '';
            partyCustomizeStatus.classList.remove('is-success', 'is-error');
        }

        function renderPartyCustomizeStatus(message, statusType = '') {
            if (!(partyCustomizeStatus instanceof HTMLElement)) {
                return;
            }
            partyCustomizeStatus.textContent = message;
            partyCustomizeStatus.classList.remove('is-success', 'is-error');
            if (statusType === 'success') {
                partyCustomizeStatus.classList.add('is-success');
            }
            if (statusType === 'error') {
                partyCustomizeStatus.classList.add('is-error');
            }
        }

        function clonePartyStateMap(sourceMap) {
            const cloned = new Map();
            sourceMap.forEach((value, key) => {
                cloned.set(key, {
                    officialName: value.officialName,
                    nickname: value.nickname,
                    owned: value.owned,
                    connectRank: Number.isFinite(Number(value.connectRank)) ? Math.trunc(Number(value.connectRank)) : 0
                });
            });
            return cloned;
        }

        function buildDefaultPartyStateMap() {
            const map = new Map();
            INITIAL_PARTY_MEMBERS.forEach((member) => {
                if (!member || typeof member.officialName !== 'string') {
                    return;
                }
                const officialName = member.officialName.trim();
                if (!officialName || map.has(officialName)) {
                    return;
                }
                map.set(officialName, {
                    officialName,
                    nickname: officialName,
                    owned: true,
                    connectRank: 0
                });
            });
            return map;
        }

        function getDisplayNameByOfficialName(officialName) {
            const current = partyStateByOfficialName.get(officialName);
            if (!current) {
                return officialName;
            }
            const nickname = String(current.nickname || '').trim();
            return nickname || officialName;
        }

        function getCurrentFirebaseUser() {
            if (!window.firebase || typeof window.firebase.auth !== 'function') {
                return null;
            }
            try {
                return window.firebase.auth().currentUser || null;
            } catch {
                return null;
            }
        }

        function sleep(ms) {
            return new Promise((resolve) => {
                window.setTimeout(resolve, ms);
            });
        }

        async function waitForFirebaseUser(timeoutMs = 3000) {
            const startedAt = Date.now();
            while (Date.now() - startedAt <= timeoutMs) {
                const user = getCurrentFirebaseUser();
                if (user && typeof user.getIdToken === 'function') {
                    return user;
                }
                await sleep(100);
            }
            return null;
        }

        async function fetchCurrentProfileWithToken() {
            const user = await waitForFirebaseUser();
            if (!user) {
                throw new Error('ログイン状態を確認できませんでした。Googleログインし直してください。');
            }

            const idToken = await user.getIdToken();
            const response = await fetch('/api/settings/profile/current', {
                method: 'GET',
                headers: {
                    Authorization: `Bearer ${idToken}`
                }
            });

            if (!response.ok) {
                throw new Error('プロフィールの取得に失敗しました。');
            }

            const payload = await response.json();
            return payload && payload.profile ? payload.profile : null;
        }

        async function saveOwnedCharactersWithToken(ownedCharacters) {
            const user = await waitForFirebaseUser();
            if (!user) {
                throw new Error('ログイン状態を確認できませんでした。Googleログインし直してください。');
            }

            const idToken = await user.getIdToken();
            const response = await fetch('/api/settings/profile/save', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    Authorization: `Bearer ${idToken}`
                },
                body: JSON.stringify({ ownedCharacters })
            });

            if (!response.ok) {
                throw new Error('カスタム設定の保存に失敗しました。');
            }

            const payload = await response.json();
            return payload && payload.profile ? payload.profile : null;
        }

        function mergeOwnedCharactersIntoPartyState(rawOwnedCharacters) {
            if (!Array.isArray(rawOwnedCharacters)) {
                return;
            }

            rawOwnedCharacters.forEach((item) => {
                if (!item || typeof item !== 'object') {
                    return;
                }
                const officialNameRaw = typeof item.officialName === 'string' ? item.officialName.trim() : '';
                if (!officialNameRaw || !partyStateByOfficialName.has(officialNameRaw)) {
                    return;
                }

                const current = partyStateByOfficialName.get(officialNameRaw);
                if (!current) {
                    return;
                }

                const nextNickname = typeof item.nickname === 'string' ? item.nickname.trim() : '';
                const nextConnectRank = Number.isFinite(Number(item.connectRank)) ? Math.trunc(Number(item.connectRank)) : current.connectRank;

                partyStateByOfficialName.set(officialNameRaw, {
                    officialName: officialNameRaw,
                    nickname: nextNickname || officialNameRaw,
                    owned: Boolean(item.owned),
                    connectRank: nextConnectRank
                });
            });
        }

        function applyPartyStateToView() {
            partyStateByOfficialName.forEach((state, officialName) => {
                const displayName = (state.nickname || '').trim() || officialName;
                const safeDisplayName = displayName;

                document.querySelectorAll(`.board-party-card[data-party-official-name="${CSS.escape(officialName)}"]`).forEach((card) => {
                    const nameElement = card.querySelector('[data-party-name-text="true"]');
                    if (nameElement) {
                        nameElement.textContent = safeDisplayName;
                    }

                    const imageElement = card.querySelector('[data-party-image="true"]');
                    if (imageElement instanceof HTMLImageElement) {
                        imageElement.alt = safeDisplayName;
                        imageElement.title = safeDisplayName;
                    }

                    card.classList.toggle('is-unowned', !state.owned);
                });

                document.querySelectorAll(`.ub-icon-box[data-party-slot-official-name="${CSS.escape(officialName)}"]`).forEach((iconBox) => {
                    if (!(iconBox instanceof HTMLElement)) {
                        return;
                    }

                    iconBox.dataset.partySlotName = safeDisplayName;
                    iconBox.classList.toggle('is-unowned', !state.owned);

                    const partyImage = iconBox.querySelector('img.ub-party-image');
                    if (partyImage instanceof HTMLImageElement) {
                        partyImage.alt = safeDisplayName;
                        partyImage.title = safeDisplayName;
                    }

                    const missingText = iconBox.querySelector('.ub-party-image-missing');
                    if (missingText) {
                        missingText.textContent = safeDisplayName;
                    }
                });

                document.querySelectorAll(`tr[data-party-character-official-name="${CSS.escape(officialName)}"]`).forEach((row) => {
                    if (!(row instanceof HTMLElement)) {
                        return;
                    }

                    row.dataset.ubText = encodeURIComponent(safeDisplayName);

                    const eventImage = row.querySelector('[data-ub-event-image="true"]');
                    if (eventImage instanceof HTMLImageElement) {
                        eventImage.alt = safeDisplayName;
                        eventImage.title = safeDisplayName;
                    }

                    const eventText = row.querySelector('[data-ub-event-text="true"]');
                    if (eventText) {
                        eventText.textContent = safeDisplayName;
                    }
                });
            });

            updateStateBadges();
            applyRowFilter();
        }

        function getPartyStateListFromMap(sourceMap) {
            const output = [];
            sourceMap.forEach((value) => {
                output.push({
                    officialName: value.officialName,
                    nickname: (value.nickname || '').trim() || value.officialName,
                    owned: Boolean(value.owned),
                    connectRank: Number.isFinite(Number(value.connectRank)) ? Math.trunc(Number(value.connectRank)) : 0
                });
            });
            return output;
        }

        function renderPartyCustomizeList() {
            if (!(partyCustomizeList instanceof HTMLElement)) {
                return;
            }

            partyCustomizeList.innerHTML = '';
            const fragment = document.createDocumentFragment();

            INITIAL_PARTY_MEMBERS.forEach((member, index) => {
                const officialName = member.officialName;
                const state = partyDraftByOfficialName.get(officialName);
                if (!state) {
                    return;
                }

                const row = document.createElement('div');
                row.className = 'board-party-customize-row';

                const imageWrap = document.createElement('div');
                imageWrap.className = 'board-party-customize-image-wrap';

                if (member.imagePath) {
                    const image = document.createElement('img');
                    image.src = member.imagePath;
                    image.alt = officialName;
                    image.className = 'board-party-customize-image';
                    imageWrap.appendChild(image);
                } else {
                    const missing = document.createElement('div');
                    missing.className = 'board-party-customize-image board-party-customize-image-missing';
                    missing.textContent = 'NO IMAGE';
                    imageWrap.appendChild(missing);
                }

                const controls = document.createElement('div');
                controls.className = 'board-party-customize-controls';

                const nameInput = document.createElement('input');
                nameInput.type = 'text';
                nameInput.className = 'board-party-customize-name';
                nameInput.value = state.nickname;
                nameInput.placeholder = officialName;
                nameInput.maxLength = 100;
                nameInput.dataset.officialName = officialName;
                nameInput.setAttribute('aria-label', `${officialName} の表示名`);

                const ownedWrap = document.createElement('label');
                ownedWrap.className = 'board-party-customize-owned';
                const ownedInput = document.createElement('input');
                ownedInput.type = 'checkbox';
                ownedInput.checked = state.owned;
                ownedInput.dataset.officialName = officialName;
                ownedInput.setAttribute('aria-label', `${officialName} を所持している`);
                const ownedText = document.createElement('span');
                ownedText.textContent = '所持';
                ownedWrap.appendChild(ownedInput);
                ownedWrap.appendChild(ownedText);

                nameInput.addEventListener('input', () => {
                    const targetOfficialName = nameInput.dataset.officialName || '';
                    const current = partyDraftByOfficialName.get(targetOfficialName);
                    if (!current) {
                        return;
                    }
                    current.nickname = nameInput.value;
                    partyDraftByOfficialName.set(targetOfficialName, current);
                    clearPartyCustomizeStatus();
                });

                ownedInput.addEventListener('change', () => {
                    const targetOfficialName = ownedInput.dataset.officialName || '';
                    const current = partyDraftByOfficialName.get(targetOfficialName);
                    if (!current) {
                        return;
                    }
                    current.owned = ownedInput.checked;
                    partyDraftByOfficialName.set(targetOfficialName, current);
                    clearPartyCustomizeStatus();
                });

                controls.appendChild(nameInput);
                controls.appendChild(ownedWrap);
                row.appendChild(imageWrap);
                row.appendChild(controls);
                fragment.appendChild(row);
            });

            partyCustomizeList.appendChild(fragment);
        }

        function openPartyCustomizeModal() {
            if (!(partyCustomizeModal instanceof HTMLElement)) {
                return;
            }

            partyDraftByOfficialName = clonePartyStateMap(partyStateByOfficialName);
            renderPartyCustomizeList();
            clearPartyCustomizeStatus();
            partyCustomizeModal.hidden = false;
        }

        function closePartyCustomizeModal() {
            if (!(partyCustomizeModal instanceof HTMLElement)) {
                return;
            }
            partyCustomizeModal.hidden = true;
        }

        async function savePartyCustomize() {
            partyStateByOfficialName.clear();
            partyDraftByOfficialName.forEach((value, key) => {
                partyStateByOfficialName.set(key, {
                    officialName: value.officialName,
                    nickname: (value.nickname || '').trim() || value.officialName,
                    owned: Boolean(value.owned),
                    connectRank: Number.isFinite(Number(value.connectRank)) ? Math.trunc(Number(value.connectRank)) : 0
                });
            });
            applyPartyStateToView();

            if (!IS_LOGGED_IN) {
                renderPartyCustomizeStatus('この画面内で保存しました。', 'success');
                closePartyCustomizeModal();
                return;
            }

            if (!(partyCustomizeSaveButton instanceof HTMLButtonElement)) {
                return;
            }

            partyCustomizeSaveButton.disabled = true;
            try {
                const profile = await fetchCurrentProfileWithToken();
                const existingOwnedCharacters = Array.isArray(profile?.ownedCharacters) ? profile.ownedCharacters : [];
                const mergedMap = new Map();

                existingOwnedCharacters.forEach((entry) => {
                    if (!entry || typeof entry !== 'object') {
                        return;
                    }
                    const officialName = typeof entry.officialName === 'string' ? entry.officialName.trim() : '';
                    if (!officialName) {
                        return;
                    }
                    mergedMap.set(officialName, {
                        officialName,
                        nickname: typeof entry.nickname === 'string' ? entry.nickname : officialName,
                        owned: Boolean(entry.owned),
                        connectRank: Number.isFinite(Number(entry.connectRank)) ? Math.trunc(Number(entry.connectRank)) : 0
                    });
                });

                const latestPartyStateList = getPartyStateListFromMap(partyStateByOfficialName);
                latestPartyStateList.forEach((entry) => {
                    const previous = mergedMap.get(entry.officialName);
                    mergedMap.set(entry.officialName, {
                        officialName: entry.officialName,
                        nickname: entry.nickname,
                        owned: entry.owned,
                        connectRank: previous ? previous.connectRank : entry.connectRank
                    });
                });

                const mergedOwnedCharacters = Array.from(mergedMap.values());
                await saveOwnedCharactersWithToken(mergedOwnedCharacters);

                renderPartyCustomizeStatus('Supabase に保存しました。', 'success');
                closePartyCustomizeModal();
            } catch (error) {
                console.error('パーティカスタムの保存に失敗しました:', error);
                renderPartyCustomizeStatus('保存に失敗しました。画面反映はされています。', 'error');
            } finally {
                partyCustomizeSaveButton.disabled = false;
            }
        }

        async function hydratePartyStateIfLoggedIn() {
            if (!IS_LOGGED_IN || partyStateByOfficialName.size === 0) {
                return;
            }

            try {
                const profile = await fetchCurrentProfileWithToken();
                mergeOwnedCharactersIntoPartyState(profile?.ownedCharacters);
                applyPartyStateToView();
            } catch (error) {
                console.warn('パーティカスタムの読み込みに失敗しました。ローカル表示を使用します。', error);
            }
        }

        function sanitizeFileNamePart(value) {
            return String(value || '')
                .trim()
                .replace(/[\\/:*?"<>|]/g, '_');
        }

        function getDamageWithoutLast4(value) {
            const digits = String(value || '').replace(/\D/g, '');
            if (!digits) {
                return '0';
            }
            const numeric = Number(digits);
            if (!Number.isFinite(numeric)) {
                return '0';
            }
            return String(Math.floor(numeric / 10000));
        }

        function getExportFileName() {
            if (!(exportModal instanceof HTMLElement)) {
                return 'export.txt';
            }

            const bossNameRaw = exportModal.dataset.bossName || 'boss';
            const damageRaw = exportModal.dataset.damage || '';
            const bossName = sanitizeFileNamePart(bossNameRaw) || 'boss';
            const damage = sanitizeFileNamePart(getDamageWithoutLast4(damageRaw)) || '0';
            return `${bossName}${damage}.txt`;
        }

        function getCookieValue(name) {
            const escapedName = name.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
            const match = document.cookie.match(new RegExp(`(?:^|; )${escapedName}=([^;]*)`));
            return match ? decodeURIComponent(match[1]) : '';
        }

        function setCookieValue(name, value) {
            document.cookie = `${name}=${encodeURIComponent(value)}; path=/; max-age=${EXPORT_OPTION_COOKIE_MAX_AGE_SECONDS}; samesite=lax`;
        }

        function isValidDisplayMode(mode) {
            return mode === DISPLAY_MODE_ALL
                || mode === DISPLAY_MODE_OPERATION
                || mode === DISPLAY_MODE_OPERATION_PLUS_PREV;
        }

        function isValidIconSize(sizeMode) {
            return sizeMode === ICON_SIZE_LARGE
                || sizeMode === ICON_SIZE_MEDIUM
                || sizeMode === ICON_SIZE_SMALL;
        }

        function setActiveDisplayMode(mode) {
            const safeMode = isValidDisplayMode(mode) ? mode : DISPLAY_MODE_ALL;
            currentDisplayMode = safeMode;
            document.querySelectorAll('.ub-display-toggle-btn').forEach((item) => {
                item.classList.toggle('is-active', item.dataset.displayMode === safeMode);
            });
            applyRowFilter();
        }

        function setActiveIconSize(sizeMode) {
            const safeSizeMode = isValidIconSize(sizeMode) ? sizeMode : ICON_SIZE_LARGE;
            currentIconSize = safeSizeMode;
            applyIconSize(safeSizeMode);
            updateBattleStartEndLabels(safeSizeMode);
            document.querySelectorAll('.ub-size-toggle-btn').forEach((item) => {
                item.classList.toggle('is-active', item.dataset.iconSize === safeSizeMode);
            });
        }

        function initializeBoardDetailToggleStates() {
            const savedDisplayMode = getCookieValue(BOARD_DISPLAY_MODE_COOKIE_KEY);
            const savedIconSize = getCookieValue(BOARD_ICON_SIZE_COOKIE_KEY);

            setActiveDisplayMode(isValidDisplayMode(savedDisplayMode) ? savedDisplayMode : DISPLAY_MODE_ALL);
            setActiveIconSize(isValidIconSize(savedIconSize) ? savedIconSize : ICON_SIZE_LARGE);
        }

        function getExportOptionFlags() {
            const showOnOffCharacters = exportShowOnOffOption instanceof HTMLInputElement ? exportShowOnOffOption.checked : false;
            const uppercaseSwitchState = exportUppercaseSwitchOption instanceof HTMLInputElement ? exportUppercaseSwitchOption.checked : false;
            return {
                showOnOffCharacters,
                uppercaseSwitchState
            };
        }

        function initializeExportOptions() {
            const showOnOffSaved = getCookieValue(EXPORT_OPTION_SHOW_ONOFF_KEY);
            const uppercaseSaved = getCookieValue(EXPORT_OPTION_UPPERCASE_SWITCH_KEY);

            if (exportShowOnOffOption instanceof HTMLInputElement) {
                exportShowOnOffOption.checked = showOnOffSaved === '1';
                exportShowOnOffOption.addEventListener('change', () => {
                    setCookieValue(EXPORT_OPTION_SHOW_ONOFF_KEY, exportShowOnOffOption.checked ? '1' : '0');
                    refreshExportText();
                });
            }

            if (exportUppercaseSwitchOption instanceof HTMLInputElement) {
                exportUppercaseSwitchOption.checked = uppercaseSaved === '1';
                exportUppercaseSwitchOption.addEventListener('change', () => {
                    setCookieValue(EXPORT_OPTION_UPPERCASE_SWITCH_KEY, exportUppercaseSwitchOption.checked ? '1' : '0');
                    refreshExportText();
                });
            }
        }

        function formatDamageForExport(value) {
            const digits = String(value || '').replace(/\D/g, '');
            const numeric = digits ? Number(digits) : 0;
            if (!Number.isFinite(numeric) || numeric <= 0) {
                return '0億0000万';
            }

            const afterTrim = Math.floor(numeric / 10000);
            const oku = Math.floor(afterTrim / 10000);
            const man = afterTrim % 10000;
            return `${oku}億${String(man).padStart(4, '0')}万`;
        }

        function getExportPartyLine() {
            const names = Array.from(document.querySelectorAll('.board-party-grid .board-party-name[data-party-name-text="true"]'))
                .map((element) => (element.textContent || '').trim())
                .filter((name) => name.length > 0);
            return names.join(' ');
        }

        function getRenderedTimeText(row) {
            const mainTime = row.querySelector('.ub-time-cell .ub-time-main');
            if (mainTime) {
                return (mainTime.textContent || '').trim();
            }
            const timeCell = row.querySelector('.ub-time-cell');
            return (timeCell ? timeCell.textContent : '').trim();
        }

        function getRowCommentText(row) {
            const commentRow = row.nextElementSibling;
            if (!(commentRow instanceof HTMLTableRowElement) || !commentRow.classList.contains('ub-comment-row') || commentRow.hidden) {
                return '';
            }

            const commentDisplay = commentRow.querySelector('.ub-comment-display');
            return (commentDisplay ? commentDisplay.textContent : '').trim();
        }

        function isSetIcon(iconBox) {
            if (!(iconBox instanceof HTMLElement)) {
                return false;
            }
            return iconBox.classList.contains('has-set') || iconBox.classList.contains('set-inactive');
        }

        function getAutoStateForExport(row) {
            const autoBox = row.querySelector('.ub-auto-cell .ub-icon-box');
            if (!(autoBox instanceof HTMLElement)) {
                return { isActive: false, isOn: false };
            }

            const autoButton = autoBox.querySelector('.ub-auto-btn');
            const isActive = autoBox.dataset.isActive === 'true';
            const isOn = autoButton ? autoButton.classList.contains('ub-auto-btn-set') : false;
            return { isActive, isOn };
        }

        function getSetStatusForExport(row, uppercaseSwitchState) {
            const partyIcons = Array.from(row.querySelectorAll('.ub-party-cell .ub-icon-box'));
            const setParts = partyIcons.map((iconBox) => {
                const baseMark = isSetIcon(iconBox) ? 'o' : 'x';
                const shouldUppercase = uppercaseSwitchState && isIconActive(iconBox);
                return shouldUppercase ? baseMark.toUpperCase() : baseMark;
            }).join('');
            const autoState = getAutoStateForExport(row);
            const autoText = autoState.isOn ? 'on' : 'off';
            const renderedAutoText = autoState.isActive ? autoText.toUpperCase() : autoText;
            return `[${setParts}]${renderedAutoText}`;
        }

        function getOnOffTextForExport(row, uppercaseSwitchState) {
            const partyIcons = Array.from(row.querySelectorAll('.ub-party-cell .ub-icon-box'));
            const onNames = [];
            const offNames = [];

            partyIcons.forEach((iconBox) => {
                if (!(iconBox instanceof HTMLElement)) {
                    return;
                }
                if (!isIconActive(iconBox)) {
                    return;
                }

                const name = String(iconBox.dataset.partySlotName || '').trim();
                if (!name) {
                    return;
                }

                const displayName = uppercaseSwitchState ? name.toUpperCase() : name;

                if (iconBox.classList.contains('has-set')) {
                    onNames.push(displayName);
                } else {
                    offNames.push(displayName);
                }
            });

            const onText = onNames.length > 0 ? `${onNames.join(',')}on` : '';
            const offText = offNames.length > 0 ? `${offNames.join(',')}off` : '';
            return { onText, offText };
        }

        function buildTimelineTextLines() {
            const tbody = document.querySelector('.ub-table tbody');
            if (!tbody) {
                return [];
            }

            const lines = [];
            const visibleRows = Array.from(tbody.querySelectorAll('tr:not(.ub-comment-row)')).filter((row) => !row.hidden);
            const { showOnOffCharacters, uppercaseSwitchState } = getExportOptionFlags();

            visibleRows.forEach((row) => {
                const timeText = getRenderedTimeText(row);
                const ubText = getDecodedUbText(row);
                const commentText = getRowCommentText(row);
                const isOperationRow = isYellowMainRow(row);

                if (isOperationRow) {
                    const { onText, offText } = showOnOffCharacters
                        ? getOnOffTextForExport(row, uppercaseSwitchState)
                        : { onText: '', offText: '' };
                    const autoState = getAutoStateForExport(row);
                    const autoToggleText = showOnOffCharacters && autoState.isActive
                        ? (autoState.isOn ? 'オートon' : 'オートoff')
                        : '';
                    const setStatus = getSetStatusForExport(row, uppercaseSwitchState);
                    const operationParts = [timeText, ubText, onText, offText, autoToggleText, setStatus].filter((part) => part && part.trim().length > 0);
                    lines.push(operationParts.join(' '));
                } else {
                    const normalParts = [timeText, ubText].filter((part) => part && part.trim().length > 0);
                    lines.push(normalParts.join(' '));
                }

                if (commentText) {
                    lines.push(commentText);
                }
            });

            return lines;
        }

        function buildExportText() {
            if (!(exportModal instanceof HTMLElement)) {
                return '';
            }

            const bossName = String(exportModal.dataset.bossName || '').trim();
            const damageText = formatDamageForExport(exportModal.dataset.damage || '');
            const partyText = getExportPartyLine();
            const timelineLines = buildTimelineTextLines();
            const articleUrl = `${window.location.origin}${window.location.pathname}`;

            const blocks = [
                `${bossName}${damageText}`,
                partyText,
                '',
                'TL',
                ...timelineLines,
                '',
                articleUrl
            ];

            return blocks.join('\n').trimEnd();
        }

        function refreshExportText() {
            if (!(exportTextarea instanceof HTMLTextAreaElement)) {
                return;
            }
            exportTextarea.value = buildExportText();
        }

        function openExportModal() {
            if (!(exportModal instanceof HTMLElement)) {
                return;
            }
            refreshExportText();
            exportModal.hidden = false;
            document.body.classList.add('board-export-modal-open');
            if (exportTextarea instanceof HTMLTextAreaElement) {
                exportTextarea.focus();
            }
        }

        function closeExportModal() {
            if (!(exportModal instanceof HTMLElement)) {
                return;
            }
            exportModal.hidden = true;
            document.body.classList.remove('board-export-modal-open');
        }

        async function copyExportText() {
            if (!(exportTextarea instanceof HTMLTextAreaElement)) {
                return;
            }

            const text = exportTextarea.value;
            try {
                await navigator.clipboard.writeText(text);
                alert('クリップボードにコピーしました。');
            } catch (error) {
                console.error('コピーに失敗しました:', error);
                alert('コピーに失敗しました。');
            }
        }

        function downloadExportText() {
            if (!(exportTextarea instanceof HTMLTextAreaElement)) {
                return;
            }

            const text = exportTextarea.value;
            const blob = new Blob([text], { type: 'text/plain;charset=utf-8' });
            const url = URL.createObjectURL(blob);
            const link = document.createElement('a');
            link.href = url;
            link.download = getExportFileName();
            document.body.appendChild(link);
            link.click();
            link.remove();
            URL.revokeObjectURL(url);
        }

        function parseTimeToSeconds(timeText) {
            const raw = (timeText || '').trim();
            const match = raw.match(/^(\d{1,2}):(\d{2})$/);
            if (!match) {
                return null;
            }
            const minutes = Number(match[1]);
            const seconds = Number(match[2]);
            if (Number.isNaN(minutes) || Number.isNaN(seconds) || seconds >= 60) {
                return null;
            }
            return (minutes * 60) + seconds;
        }

        function parseSecondsInput(value) {
            const raw = String(value || '').trim();
            if (!raw) {
                return null;
            }

            if (!/^\d+$/.test(raw)) {
                return null;
            }

            return Number(raw);
        }

        function formatSecondsToTime(totalSeconds) {
            const minutes = Math.floor(totalSeconds / 60);
            const seconds = totalSeconds % 60;
            return `${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
        }

        function renderTimeCell(cell, timeText, diffText = '') {
            if (!cell) {
                return;
            }
            cell.innerHTML = '';

            const timeMain = document.createElement('div');
            timeMain.className = 'ub-time-main';
            timeMain.textContent = timeText || '';
            cell.appendChild(timeMain);

            if (diffText) {
                const timeDiff = document.createElement('div');
                timeDiff.className = 'ub-time-diff';
                timeDiff.textContent = diffText;
                cell.appendChild(timeDiff);
            }
        }

        function initializeTimeCells() {
            const rows = Array.from(document.querySelectorAll('.ub-table tbody tr:not(.ub-comment-row)'));
            rows.forEach((row) => {
                const timeCell = row.querySelector('.ub-time-cell');
                if (!timeCell) {
                    return;
                }
                const raw = (timeCell.textContent || '').trim();
                row.dataset.timeRaw = raw;
                renderTimeCell(timeCell, raw);
            });
        }

        function initializeBattleTimeControls() {
            if (!(timeAdjustInput instanceof HTMLInputElement)) {
                return;
            }

            const parsedBattleTime = parseSecondsInput(timeAdjustInput.dataset.battleTime || timeAdjustInput.value || '');
            currentBattleTimeSeconds = parsedBattleTime !== null ? parsedBattleTime : 0;
            currentInputSeconds = currentBattleTimeSeconds;
            timeAdjustInput.value = currentBattleTimeSeconds > 0 ? String(currentBattleTimeSeconds) : '';
            timeAdjustInput.dataset.lastValidTime = timeAdjustInput.value;
        }

        function getTimeOffsetSeconds() {
            return currentBattleTimeSeconds - currentInputSeconds;
        }

        function isIconActive(iconBox) {
            return iconBox instanceof HTMLElement && iconBox.dataset.isActive === 'true';
        }

        function getDecodedUbText(row) {
            const raw = row.dataset.ubText || '';
            if (!raw) {
                return '';
            }

            try {
                return decodeURIComponent(raw);
            } catch {
                return raw;
            }
        }

        function getAutoBadgeState(autoBox) {
            if (!(autoBox instanceof HTMLElement)) {
                return 'inactive-unset';
            }

            const autoBtn = autoBox.querySelector('.ub-auto-btn');
            const isAutoActive = autoBtn ? autoBtn.classList.contains('ub-auto-btn-active') : false;
            const isAutoSet = autoBtn ? autoBtn.classList.contains('ub-auto-btn-set') : false;

            if (isAutoActive && isAutoSet) return 'active-set';
            if (!isAutoActive && isAutoSet) return 'inactive-set';
            if (isAutoActive && !isAutoSet) return 'active-unset';
            return 'inactive-unset';
        }

        function updateStateBadges() {
            const rows = Array.from(document.querySelectorAll('.ub-table tbody tr:not(.ub-comment-row)'));

            rows.forEach((row) => {
                const isTimingRow = row.dataset.timing === 'true';
                const bodyBadge = row.querySelector('.ub-event-cell .ub-state-badge');
                if (!(bodyBadge instanceof HTMLElement)) {
                    return;
                }

                const rowUbText = getDecodedUbText(row);
                const targetIconBox = Array.from(row.querySelectorAll('.ub-party-cell .ub-icon-box')).find((iconBox) => {
                    return iconBox.dataset.partySlotName === rowUbText;
                });

                const autoBox = row.querySelector('.ub-auto-cell .ub-icon-box');
                const autoState = getAutoBadgeState(autoBox);
                const targetIsActive = targetIconBox ? isIconActive(targetIconBox) : false;
                const targetHasSet = targetIconBox ? targetIconBox.classList.contains('has-set') : false;
                const targetSetInactive = targetIconBox ? targetIconBox.classList.contains('set-inactive') : false;
                const hasSetState = targetSetInactive || (targetIsActive && !targetHasSet);

                let label = '???';
                let badgeClass = 'ub-state-badge is-unknown';

                if (isTimingRow) {
                    label = 'TIMING';
                    badgeClass = 'ub-state-badge is-timing';
                } else if (hasSetState) {
                    label = 'SET';
                    badgeClass = 'ub-state-badge is-set';
                } else if (autoState === 'inactive-set' || autoState === 'active-unset') {
                    label = 'AUTO';
                    badgeClass = 'ub-state-badge is-auto';
                }

                bodyBadge.className = badgeClass;
                bodyBadge.textContent = label;
            });
        }

        function computeSet(isActive, previousSet, isBattleStart) {
            if (isBattleStart) return isActive;
            if (isActive) return !previousSet;
            return previousSet;
        }

        function updateSetBubbles() {
            const rows = Array.from(document.querySelectorAll('.ub-table tbody tr:not(.ub-comment-row)'));
            const previousSetByColumn = Array(PARTY_COLUMN_COUNT + 1).fill(false);

            rows.forEach((row) => {
                const isBattleStart = row.dataset.isBattleStart === 'true';
                const iconBoxes = row.querySelectorAll('.ub-party-cell .ub-icon-box');
                let hasActiveIcon = false;

                for (let columnIndex = 0; columnIndex < PARTY_COLUMN_COUNT; columnIndex += 1) {
                    const iconBox = iconBoxes[columnIndex];
                    if (!iconBox) {
                        continue;
                    }
                    const isActive = isIconActive(iconBox);
                    if (isActive) hasActiveIcon = true;
                    const shouldSet = computeSet(isActive, previousSetByColumn[columnIndex], isBattleStart);
                    iconBox.classList.toggle('has-set', shouldSet);
                    iconBox.classList.toggle('set-inactive', shouldSet && !isActive);
                    previousSetByColumn[columnIndex] = shouldSet;
                }

                const autoBox = row.querySelector('.ub-auto-cell .ub-icon-box');
                if (autoBox) {
                    const isAutoActive = isIconActive(autoBox);
                    if (isAutoActive) hasActiveIcon = true;
                    const shouldAutoSet = computeSet(isAutoActive, previousSetByColumn[PARTY_COLUMN_COUNT], isBattleStart);
                    const autoBtn = autoBox.querySelector('.ub-auto-btn');
                    const autoLabel = autoBox.querySelector('.ub-auto-label');
                    if (autoBtn) {
                        autoBtn.classList.toggle('ub-auto-btn-set', shouldAutoSet);
                        autoBtn.classList.toggle('ub-auto-btn-unset', !shouldAutoSet);
                    }
                    if (autoLabel) {
                        autoLabel.textContent = shouldAutoSet ? 'ON' : 'OFF';
                        autoLabel.classList.toggle('ub-auto-label-on', shouldAutoSet);
                    }
                    previousSetByColumn[PARTY_COLUMN_COUNT] = shouldAutoSet;
                }

                row.classList.toggle('ub-row-has-active', hasActiveIcon);

                const commentRow = row.nextElementSibling;
                const hasCommentRow = commentRow instanceof HTMLTableRowElement
                    && commentRow.classList.contains('ub-comment-row');
                row.classList.toggle('has-comment-row', hasCommentRow);
            });

            updateStateBadges();
            applyRowFilter();
        }

        function isYellowMainRow(row) {
            return row.classList.contains('ub-row-has-active')
                || row.classList.contains('has-comment-row')
                || row.dataset.isAddedRow === 'true'
                || row.dataset.isBattleStart === 'true'
                || row.dataset.isBattleEnd === 'true'
                || row.dataset.timing === 'true';
        }

        function isYellowRow(row) {
            if (row.classList.contains('ub-comment-row')) {
                return true;
            }
            return isYellowMainRow(row);
        }

        function applyRowFilter() {
            const tbody = document.querySelector('.ub-table tbody');
            if (!tbody) {
                return;
            }

            const mainRows = Array.from(tbody.querySelectorAll('tr:not(.ub-comment-row)'));
            const visibleMainRows = new Set();
            const offsetSeconds = getTimeOffsetSeconds();
            const adjustedSecondsByRow = new Map();

            mainRows.forEach((row) => {
                const timeRaw = row.dataset.timeRaw || '';
                const baseSeconds = parseTimeToSeconds(timeRaw);
                const adjustedSeconds = baseSeconds === null ? null : baseSeconds - offsetSeconds;
                adjustedSecondsByRow.set(row, adjustedSeconds);
                const timeVisible = adjustedSeconds === null || adjustedSeconds >= 0;
                const modeVisible = currentDisplayMode === DISPLAY_MODE_ALL
                    || (currentDisplayMode === DISPLAY_MODE_OPERATION && isYellowRow(row))
                    || (currentDisplayMode === DISPLAY_MODE_OPERATION_PLUS_PREV && isYellowRow(row));

                if (modeVisible && timeVisible) {
                    visibleMainRows.add(row);
                }
            });

            if (currentDisplayMode === DISPLAY_MODE_OPERATION_PLUS_PREV) {
                mainRows.forEach((row) => {
                    if (!visibleMainRows.has(row)) {
                        return;
                    }

                    const isBattleStartRow = row.dataset.isBattleStart === 'true';
                    const isBattleEndRow = row.dataset.isBattleEnd === 'true';
                    if (isBattleStartRow || isBattleEndRow) {
                        return;
                    }

                    const previousRow = row.previousElementSibling;
                    if (previousRow instanceof HTMLTableRowElement && !previousRow.classList.contains('ub-comment-row')) {
                        const previousBaseSeconds = parseTimeToSeconds(previousRow.dataset.timeRaw || '');
                        const previousVisible = previousBaseSeconds === null || (previousBaseSeconds - offsetSeconds) >= 0;
                        if (previousVisible) {
                            visibleMainRows.add(previousRow);
                        }
                    }
                });
            }

            mainRows.forEach((row) => {
                row.hidden = !visibleMainRows.has(row);
            });

            let previousVisibleSeconds = null;
            mainRows.forEach((row) => {
                const timeCell = row.querySelector('.ub-time-cell');
                if (!timeCell) {
                    return;
                }

                const timeRaw = row.dataset.timeRaw || '';
                const adjustedSeconds = adjustedSecondsByRow.get(row);
                if (adjustedSeconds === null) {
                    renderTimeCell(timeCell, timeRaw);
                    if (!row.hidden) {
                        previousVisibleSeconds = null;
                    }
                    return;
                }

                if (adjustedSeconds < 0) {
                    renderTimeCell(timeCell, '');
                    return;
                }

                let diffText = '';
                if (!row.hidden && previousVisibleSeconds !== null) {
                    const diffSeconds = previousVisibleSeconds - adjustedSeconds;
                    diffText = `${diffSeconds > 0 ? '+' : ''}${diffSeconds}s`;
                }

                renderTimeCell(timeCell, formatSecondsToTime(adjustedSeconds), diffText);

                if (!row.hidden) {
                    previousVisibleSeconds = adjustedSeconds;
                }
            });

            mainRows.forEach((row) => {
                const commentRow = row.nextElementSibling;
                if (commentRow instanceof HTMLTableRowElement && commentRow.classList.contains('ub-comment-row')) {
                    commentRow.hidden = row.hidden;
                }
            });

            if (exportModal instanceof HTMLElement && !exportModal.hidden) {
                refreshExportText();
            }
        }

        function applyIconSize(sizeMode) {
            const tableWrapper = document.querySelector('.ub-table-wrapper');
            if (!(tableWrapper instanceof HTMLElement)) {
                return;
            }

            tableWrapper.classList.remove('ub-icon-size-large', 'ub-icon-size-medium', 'ub-icon-size-small');
            tableWrapper.classList.add(`ub-icon-size-${sizeMode}`);
        }

        function updateBattleStartEndLabels(sizeMode) {
            const eventTextElements = Array.from(document.querySelectorAll('.ub-event-cell .ub-event-image-missing-blue'));
            eventTextElements.forEach((element) => {
                if (!(element instanceof HTMLElement)) {
                    return;
                }

                const originalText = element.dataset.originalBattleLabel || (element.textContent || '').trim();
                if (!element.dataset.originalBattleLabel) {
                    element.dataset.originalBattleLabel = originalText;
                }

                if (originalText === 'バトル開始') {
                    element.textContent = sizeMode === ICON_SIZE_SMALL ? '開始' : 'バトル開始';
                } else if (originalText === 'バトル終了') {
                    element.textContent = sizeMode === ICON_SIZE_SMALL ? '終了' : 'バトル終了';
                }
            });
        }

        document.querySelectorAll('.ub-display-toggle-btn').forEach((button) => {
            button.addEventListener('click', () => {
                const mode = button.dataset.displayMode;
                if (!isValidDisplayMode(mode || '')) {
                    return;
                }
                setActiveDisplayMode(mode);
                setCookieValue(BOARD_DISPLAY_MODE_COOKIE_KEY, mode);
            });
        });

        document.querySelectorAll('.ub-size-toggle-btn').forEach((button) => {
            button.addEventListener('click', () => {
                const sizeMode = button.dataset.iconSize;
                if (!isValidIconSize(sizeMode || '')) {
                    return;
                }
                setActiveIconSize(sizeMode);
                setCookieValue(BOARD_ICON_SIZE_COOKIE_KEY, sizeMode);
            });
        });

        if (timeAdjustButton) {
            timeAdjustButton.addEventListener('click', () => {
                if (!(timeAdjustInput instanceof HTMLInputElement)) {
                    return;
                }

                const nextInputSeconds = parseSecondsInput(timeAdjustInput.value);
                if (nextInputSeconds === null || nextInputSeconds <= 0 || nextInputSeconds > currentBattleTimeSeconds) {
                    alert('入力時間は 1 秒以上で、バトル時間以下にしてください。');
                    timeAdjustInput.value = timeAdjustInput.dataset.lastValidTime || (currentBattleTimeSeconds > 0 ? String(currentBattleTimeSeconds) : '');
                    return;
                }

                currentInputSeconds = nextInputSeconds;
                timeAdjustInput.value = String(nextInputSeconds);
                timeAdjustInput.dataset.lastValidTime = timeAdjustInput.value;
                applyRowFilter();
            });
        }

        if (exportOpenButton) {
            exportOpenButton.addEventListener('click', () => {
                openExportModal();
            });
        }

        if (exportCloseButton) {
            exportCloseButton.addEventListener('click', () => {
                closeExportModal();
            });
        }

        if (exportModal) {
            exportModal.addEventListener('click', (event) => {
                if (event.target === exportModal) {
                    closeExportModal();
                }
            });
        }

        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape' && exportModal instanceof HTMLElement && !exportModal.hidden) {
                closeExportModal();
            }
        });

        if (exportCopyButton) {
            exportCopyButton.addEventListener('click', () => {
                copyExportText();
            });
        }

        if (exportDownloadButton) {
            exportDownloadButton.addEventListener('click', () => {
                downloadExportText();
            });
        }

        initializeTimeCells();
        initializeBattleTimeControls();
        initializeExportOptions();
        initializeBoardDetailToggleStates();
        updateSetBubbles();
        applyRowFilter();

        if (partyStateByOfficialName.size === 0) {
            const defaultMap = buildDefaultPartyStateMap();
            defaultMap.forEach((value, key) => {
                partyStateByOfficialName.set(key, value);
            });
            applyPartyStateToView();
        }

        if (partyCustomizeOpenButton) {
            partyCustomizeOpenButton.addEventListener('click', () => {
                openPartyCustomizeModal();
            });
        }

        if (partyCustomizeModal) {
            partyCustomizeModal.addEventListener('click', (event) => {
                const target = event.target;
                if (!(target instanceof HTMLElement)) {
                    return;
                }
                if (target.dataset.partyModalClose === 'true') {
                    closePartyCustomizeModal();
                }
            });
        }

        if (partyCustomizeDiscardButton) {
            partyCustomizeDiscardButton.addEventListener('click', () => {
                closePartyCustomizeModal();
            });
        }

        if (partyCustomizeSaveButton) {
            partyCustomizeSaveButton.addEventListener('click', async () => {
                await savePartyCustomize();
            });
        }

        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape' && partyCustomizeModal && !partyCustomizeModal.hidden) {
                closePartyCustomizeModal();
            }
        });

        hydratePartyStateIfLoggedIn();
    });
</script>
