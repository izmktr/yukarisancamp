<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="icon" type="image/png" href="/images/favicon.png">
    <link rel="apple-touch-icon" href="/images/favicon.png">
    <link rel="stylesheet" href="/styles/main.css">
</head>
<body>
    <!-- ヘッダー -->
    <header class="header">
        <div class="header-content">
            <div class="header-left">
                <h1 class="title"><%= title %></h1>
            </div>
            <div class="header-right">
                <div class="info-space">
                    <span id="current-time"></span>
                </div>
                <div class="auth-buttons">
                    <% if (isLoggedIn) { %>
                        <span class="user-name">こんにちは、<%= userName %>さん<% if (typeof isDevLogin !== 'undefined' && isDevLogin) { %>（開発）<% } %></span>
                        <button class="btn btn-logout" onclick="logout()">ログアウト</button>
                    <% } else { %>
                        <button class="btn btn-login" onclick="loginWithGoogle()">Googleでログイン</button>
                        <% if (typeof devLoginAvailable !== 'undefined' && devLoginAvailable) { %>
                            <details class="dev-login-menu">
                                <summary class="btn btn-login">開発ログイン</summary>
                                <div class="dev-login-menu-panel">
                                    <a href="/dev/login?role=user">一般ユーザー</a>
                                    <a href="/dev/login?role=admin">admin</a>
                                    <a href="/dev/login?role=admin&amp;withDiscord=1">admin + クラン</a>
                                </div>
                            </details>
                        <% } %>
                    <% } %>
                </div>
            </div>
        </div>
    </header>

    <!-- タブナビゲーション -->
    <nav class="tabs">
        <div class="tab-content">
            <a href="/info" class="tab <%= currentPage === 'info' ? 'active' : '' %>">情報</a>
            <a href="/board" class="tab <%= currentPage === 'board' ? 'active' : '' %>">掲示板</a>
            <% if (isLoggedIn) { %>
                <a href="/settings" class="tab <%= currentPage === 'settings' ? 'active' : '' %>">設定</a>
                <% if (hasDiscordServer) { %>
                    <a href="/clan" class="tab clan-tab <%= currentPage === 'clan' ? 'active' : '' %>">クラン</a>
                    <a href="/clan-data" class="tab clan-tab <%= currentPage === 'clan-data' ? 'active' : '' %>">メンバー</a>
                    <% if (clanManagementTabVisible) { %>
                        <a href="/clan-management" class="tab clan-tab <%= currentPage === 'clan-management' ? 'active' : '' %>">管理</a>
                    <% } %>
                <% } %>
            <% } %>
            <% if (isAdmin) { %>
                <a href="/chara-check" class="tab admin-tab <%= currentPage === 'chara-check' ? 'active' : '' %>">キャラ確認</a>
                <a href="/clanlist" class="tab admin-tab <%= currentPage === 'clanlist' ? 'active' : '' %>">クラン一覧</a>
                <a href="/clanbattle-settings" class="tab admin-tab <%= currentPage === 'clanbattle-settings' ? 'active' : '' %>">クラバト設定</a>
            <% } %>
        </div>
    </nav>

    <!-- メインコンテンツ -->
    <main class="main-content">
        <%- body %>
    </main>

    <script>
        window.__FIREBASE_CONFIG__ = <%- JSON.stringify(typeof firebaseConfig !== 'undefined' ? firebaseConfig : {}) %>;
        window.__SUPABASE_PUBLIC_CONFIG__ = <%- JSON.stringify(typeof supabasePublicConfig !== 'undefined' ? supabasePublicConfig : {}) %>;
        window.__SERVER_SESSION__ = {
            isLoggedIn: <%- JSON.stringify(!!isLoggedIn) %>,
            isAdmin: <%- JSON.stringify(!!isAdmin) %>,
            hasDiscordServer: <%- JSON.stringify(!!hasDiscordServer) %>,
            isDevLogin: <%- JSON.stringify(typeof isDevLogin !== 'undefined' && !!isDevLogin) %>,
            userName: <%- JSON.stringify(typeof userName !== 'undefined' ? userName : '') %>,
            googleUserId: <%- JSON.stringify(typeof googleUserId !== 'undefined' ? googleUserId : '') %>,
            discordServer: <%- JSON.stringify(typeof discordServer !== 'undefined' ? discordServer : '') %>,
            devLoginAvailable: <%- JSON.stringify(typeof devLoginAvailable !== 'undefined' && !!devLoginAvailable) %>
        };
    </script>
    <script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-auth-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore-compat.js"></script>
    <script src="/scripts/main.js"></script>
</body>
</html>
