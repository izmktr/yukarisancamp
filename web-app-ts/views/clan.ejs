    function initializeClanHistoryEditor() {
        const editButton = document.getElementById('clan-history-edit-button');
        const saveButton = document.getElementById('clan-history-save-button');
        const cancelButton = document.getElementById('clan-history-cancel-button');
        const status = document.getElementById('clan-history-status');
        const rows = Array.from(document.querySelectorAll('.clan-attack-history-row[data-history-id]'));
        if (!editButton || !saveButton || !cancelButton || rows.length === 0) {
            return;
        }

        const setStatus = (message, type) => {
            if (!status) {
                return;
            }
            status.textContent = message;
            status.classList.remove('success', 'error');
            if (type) {
                status.classList.add(type);
            }
        };
        const updateOvertimeVisibility = (row) => {
            const defeatInput = row.querySelector('.clan-history-defeat-input');
            const overtimeInput = row.querySelector('.clan-history-overtime-input');
            const overtimeUnit = row.querySelector('.clan-history-overtime-unit');
            const showOvertime = defeatInput && defeatInput.value === 'true';
            if (overtimeInput) {
                overtimeInput.style.display = showOvertime ? '' : 'none';
            }
            if (overtimeUnit) {
                overtimeUnit.style.display = showOvertime ? '' : 'none';
            }
        };
        const setEditing = (editing) => {
            editButton.style.display = editing ? 'none' : '';
            saveButton.style.display = editing ? '' : 'none';
            cancelButton.style.display = editing ? '' : 'none';
            document.querySelectorAll('.clan-history-display').forEach((element) => {
                element.style.display = editing ? 'none' : '';
            });
            document.querySelectorAll('.clan-history-input').forEach((element) => {
                element.style.display = editing
                    ? (element.classList.contains('clan-history-state-editor') ? 'grid' : 'block')
                    : 'none';
            });
            rows.forEach(updateOvertimeVisibility);
        };
        const restoreOriginalValues = () => {
            rows.forEach((row) => {
                const attacklapInput = row.querySelector('.clan-history-attacklap-input');
                const bossInput = row.querySelector('.clan-history-boss-input');
                const defeatInput = row.querySelector('.clan-history-defeat-input');
                const overtimeInput = row.querySelector('.clan-history-overtime-input');
                if (attacklapInput) attacklapInput.value = row.getAttribute('data-original-attacklap') || '';
                if (bossInput) bossInput.value = row.getAttribute('data-original-boss') || '';
                if (defeatInput) defeatInput.value = row.getAttribute('data-original-defeat') || 'false';
                if (overtimeInput) overtimeInput.value = row.getAttribute('data-original-overtime') || '0';
                updateOvertimeVisibility(row);
            });
        };

        rows.forEach((row) => {
            const defeatInput = row.querySelector('.clan-history-defeat-input');
            const deleteButton = row.querySelector('.clan-history-delete-button');
            if (defeatInput) {
                defeatInput.addEventListener('change', () => updateOvertimeVisibility(row));
            }
            if (deleteButton) {
                deleteButton.addEventListener('click', async () => {
                    const id = Number(row.getAttribute('data-history-id'));
                    const memberid = row.getAttribute('data-member-id') || '';
                    if (!Number.isInteger(id) || !window.confirm('この凸履歴を削除しますか？')) {
                        return;
                    }
                    deleteButton.disabled = true;
                    saveButton.disabled = true;
                    cancelButton.disabled = true;
                    setStatus('削除中です...', '');
                    try {
                        const response = await fetch('/api/clan/attack-history/delete', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ id, memberid })
                        });
                        if (!response.ok) {
                            const payload = await response.json().catch(() => null);
                            throw new Error(payload && payload.error ? payload.error : 'Failed to delete attack history');
                        }
                        window.location.reload();
                    } catch (error) {
                        console.error('凸履歴の削除に失敗しました:', error);
                        setStatus('削除に失敗しました。画面を更新して再試行してください。', 'error');
                        deleteButton.disabled = false;
                        saveButton.disabled = false;
                        cancelButton.disabled = false;
                    }
                });
            }
        });
        editButton.addEventListener('click', () => {
            setStatus('', '');
            setEditing(true);
        });
        cancelButton.addEventListener('click', () => {
            restoreOriginalValues();
            setStatus('変更を破棄しました。', 'success');
            setEditing(false);
        });
        saveButton.addEventListener('click', async () => {
            const histories = [];
            for (const row of rows) {
                const id = Number(row.getAttribute('data-history-id'));
                const memberid = row.getAttribute('data-member-id') || '';
                const attacklap = Number(row.querySelector('.clan-history-attacklap-input')?.value);
                const boss = Number(row.querySelector('.clan-history-boss-input')?.value);
                const defeat = row.querySelector('.clan-history-defeat-input')?.value === 'true';
                const fixedOvertime = row.getAttribute('data-fixed-overtime');
                const overtime = fixedOvertime === '0'
                    ? 0
                    : defeat ? Number(row.querySelector('.clan-history-overtime-input')?.value) : 0;
                if (!Number.isInteger(id) || !memberid || !Number.isInteger(attacklap) || attacklap < 0
                    || !Number.isInteger(boss) || boss < 1 || boss > 5
                    || !Number.isInteger(overtime)
                    || (defeat && fixedOvertime !== '0' && overtime !== 0 && (overtime < 20 || overtime > 90))) {
                    setStatus('周回数は0以上、持ち越し時間は0または20～90の整数で入力してください。', 'error');
                    return;
                }
                histories.push({ id, memberid, attacklap, boss, defeat, overtime });
            }

            saveButton.disabled = true;
            cancelButton.disabled = true;
            setStatus('保存中です...', '');
            try {
                const response = await fetch('/api/clan/attack-history/save', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ histories })
                });
                if (!response.ok) {
                    const payload = await response.json().catch(() => null);
                    throw new Error(payload && payload.error ? payload.error : 'Failed to update attack histories');
                }
                window.location.reload();
            } catch (error) {
                console.error('凸履歴の保存に失敗しました:', error);
                setStatus('保存に失敗しました。画面を更新して再試行してください。', 'error');
                saveButton.disabled = false;
                cancelButton.disabled = false;
            }
        });

        setEditing(false);
    }

    function initializeClanActiveAttackActions() {
        const panels = Array.from(document.querySelectorAll('.clan-operate-panel[data-member-id]'));

        panels.forEach((panel) => {
            const memberId = String(panel.getAttribute('data-member-id') || '');
            const completeButton = panel.querySelector('.clan-attack-complete-button');
            const defeatButtons = Array.from(panel.querySelectorAll('.clan-attack-defeat-button'));
            const cancelButton = panel.querySelector('.clan-attack-cancel-button');
            const messageInput = panel.querySelector('.clan-attack-message-input');
            const messageSendButton = panel.querySelector('.clan-attack-message-send-button');
            const status = panel.querySelector('.clan-attack-active-action-status');

            if (!memberId || !completeButton || !cancelButton || defeatButtons.length === 0) {
                return;
            }

            const actionButtons = [completeButton, cancelButton, ...defeatButtons];
            let statusClearTimer = null;
            const setActionDisabled = (disabled) => {
                actionButtons.forEach((button) => {
                    button.disabled = disabled;
                });
            };
            const setStatus = (message, type) => {
                if (!status) {
                    return;
                }
                if (statusClearTimer !== null) {
                    window.clearTimeout(statusClearTimer);
                    statusClearTimer = null;
                }
                status.textContent = message;
                status.classList.remove('success', 'error');
                if (type) {
                    status.classList.add(type);
                }
                if (type === 'success' && message) {
                    statusClearTimer = window.setTimeout(() => {
                        status.textContent = '';
                        status.classList.remove('success', 'error');
                        statusClearTimer = null;
                    }, 2000);
                }
            };
            const parseDamageAndMessage = () => {
                if (!messageInput) {
                    return null;
                }

                const rawText = String(messageInput.value || '');
                const toHalfWidthDigits = (text) => text.replace(/[０-９]/g, (char) => String.fromCharCode(char.charCodeAt(0) - 0xFEE0));
                const match = rawText.match(/^\s*([0-9０-９]+)(?:\s*[+＋]\s*([0-9０-９]+))?([\s\S]*)$/);
                if (!match) {
                    return {
                        hasDamage: false,
                        message: rawText.trim()
                    };
                }

                const left = Number(toHalfWidthDigits(match[1]));
                const hasRightValue = typeof match[2] === 'string' && match[2].length > 0;
                const right = hasRightValue ? Number(toHalfWidthDigits(match[2])) : 0;
                if (!Number.isFinite(left) || (hasRightValue && !Number.isFinite(right))) {
                    return null;
                }

                const damage = hasRightValue
                    ? Math.trunc(left) + Math.trunc(right)
                    : Math.trunc(left);
                const message = String(match[3] || '').trim();
                return { hasDamage: true, damage, message };
            };
            const submitMessage = async () => {
                const parsed = parseDamageAndMessage();
                if (!parsed) {
                    setStatus('メッセージの形式が不正です。', 'error');
                    return;
                }

                if (messageSendButton) {
                    messageSendButton.disabled = true;
                }
                setStatus('メッセージを送信しています...', '');

                try {
                    const response = await fetch('/api/clan/attack/message', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify(Object.assign(
                            parsed.hasDamage
                                ? { damage: parsed.damage, message: parsed.message }
                                : { message: parsed.message },
                            { actingMemberId: memberId }
                        ))
                    });

                    if (!response.ok) {
                        const payload = await response.json().catch(() => null);
                        throw new Error(payload && payload.error ? payload.error : 'Failed to update attack message');
                    }

                    const payload = await response.json().catch(() => null);
                    const memberRow = document.querySelector(`.clan-attack-member-row[data-member-id="${memberId}"]`);
                    if (memberRow && payload) {
                        const hasDamageValue = payload.damage !== null && payload.damage !== undefined;
                        const updatedDamage = Number(payload.damage) || 0;
                        const updatedMessage = typeof payload.message === 'string' ? payload.message.trim() : '';
                        memberRow.setAttribute('data-damage', String(hasDamageValue ? updatedDamage : 0));
                        updateClanAttackMemberRowText(memberRow, updatedDamage, updatedMessage, hasDamageValue);
                        const panel = memberRow.closest('.clan-attack-active-panel');
                        refreshClanAttackPanelStatuses(panel);
                    }

                    if (messageInput) {
                        messageInput.value = '';
                        messageInput.defaultValue = '';
                        messageInput.dispatchEvent(new CustomEvent('clan-attack-message-saved'));
                    }
                    setStatus('送信しました。', 'success');
                } catch (error) {
                    console.error('攻撃中メッセージの送信に失敗しました:', error);
                    setStatus('送信に失敗しました。画面を更新して再試行してください。', 'error');
                } finally {
                    if (messageSendButton) {
                        messageSendButton.disabled = false;
                    }
                }
            };
            const submitAction = async (action, overtime = 0) => {
                setActionDisabled(true);
                setStatus('更新しています...', '');
                try {
                    const response = await fetch('/api/clan/attack/finish', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({ action, overtime, actingMemberId: memberId })
                    });
                    if (!response.ok) {
                        const payload = await response.json().catch(() => null);
                        throw new Error(payload && payload.error ? payload.error : 'Failed to finish attack');
                    }
                    window.location.reload();
                } catch (error) {
                    console.error('攻撃状態の更新に失敗しました:', error);
                    setStatus('更新に失敗しました。画面を更新して再試行してください。', 'error');
                    setActionDisabled(false);
                }
            };

            completeButton.addEventListener('click', () => submitAction('complete'));
            cancelButton.addEventListener('click', () => submitAction('cancel'));

            if (messageSendButton) {
                messageSendButton.addEventListener('click', () => {
                    submitMessage();
                });
            }
            if (messageInput) {
                messageInput.addEventListener('keydown', (event) => {
                    if (event.key !== 'Enter' || event.isComposing) {
                        return;
                    }
                    event.preventDefault();
                    submitMessage();
                });
            }

            defeatButtons.forEach((button) => {
                button.addEventListener('click', () => {
                    const overtime = Number(button.getAttribute('data-overtime'));
                    if (!Number.isInteger(overtime) || overtime < 0) {
                        setStatus('討伐時間の指定が不正です。', 'error');
                        return;
                    }
                    submitAction('defeat', overtime);
                });
            });
        });
    }

    function initializeClanAttackButtons() {
        const attackButtons = Array.from(document.querySelectorAll('.clan-attack-button[data-boss]'));
        const status = document.getElementById('clan-attack-status');
        const clanPage = document.getElementById('clan-page');
        const pageBaseDate = clanPage ? String(clanPage.getAttribute('data-base-date') || '') : '';
        if (attackButtons.length === 0) {
            return;
        }

        const getCurrentBaseDate = () => {
            const shiftedTime = new Date(Date.now() + 4 * 60 * 60 * 1000);
            const year = shiftedTime.getUTCFullYear();
            const month = String(shiftedTime.getUTCMonth() + 1).padStart(2, '0');
            const day = String(shiftedTime.getUTCDate()).padStart(2, '0');
            return `${year}-${month}-${day}`;
        };

        const setStatus = (message, type) => {
            if (!status) {
                return;
            }
            status.textContent = message;
            status.classList.remove('success', 'error');
            if (type) {
                status.classList.add(type);
            }
        };

        attackButtons.forEach((button) => {
            button.addEventListener('click', async () => {
                const attackBoss = Number(button.getAttribute('data-boss'));
                const historyIdText = button.getAttribute('data-history-id');
                const historyId = historyIdText === null ? null : Number(historyIdText);
                const panel = button.closest('.clan-operate-panel');
                const actingMemberId = panel ? String(panel.getAttribute('data-member-id') || '') : '';
                if (!Number.isInteger(attackBoss) || attackBoss < 1 || attackBoss > 5 || !actingMemberId) {
                    return;
                }
                if (historyId !== null && (!Number.isInteger(historyId) || historyId < 1)) {
                    return;
                }
                if (!pageBaseDate || pageBaseDate !== getCurrentBaseDate()) {
                    setStatus('基準日が変わりました。画面を更新してください。', 'error');
                    return;
                }

                const panelButtons = panel ? Array.from(panel.querySelectorAll('.clan-attack-button')) : attackButtons;
                panelButtons.forEach((item) => {
                    item.disabled = true;
                });
                setStatus('攻撃開始を登録しています...', '');

                try {
                    const response = await fetch(historyId === null
                        ? '/api/clan/attack/start'
                        : '/api/clan/attack/carryover/start', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify(historyId === null
                            ? { attackBoss, pageBaseDate, actingMemberId }
                            : { attackBoss, historyId, pageBaseDate, actingMemberId })
                    });

                    if (!response.ok) {
                        const payload = await response.json().catch(() => null);
                        throw new Error(payload && payload.error ? payload.error : 'Failed to start attack');
                    }

                    window.location.reload();
                } catch (error) {
                    console.error('攻撃開始の登録に失敗しました:', error);
                    setStatus('攻撃開始の登録に失敗しました。画面を更新して再試行してください。', 'error');
                    attackButtons.forEach((item) => {
                        item.disabled = false;
                    });
                }
            });
        });
    }

    function initializeClanBosslapEditor() {
        const editButton = document.getElementById('clan-bosscount-edit-btn');
        const saveButton = document.getElementById('clan-bosscount-save-btn');
        const cancelButton = document.getElementById('clan-bosscount-cancel-btn');
        const status = document.getElementById('clan-bosslap-status');
        const clanIdInput = document.getElementById('clan-id');
        const valueElements = Array.from(document.querySelectorAll('.clan-bosslap-value'));
        const inputElements = Array.from(document.querySelectorAll('.clan-bosslap-input'));

        const clanId = clanIdInput ? String(clanIdInput.value || '').trim() : '';

        if (!editButton || !saveButton || !cancelButton || valueElements.length !== 5 || inputElements.length !== 5 || !/^(?:\d+|w\d{8})$/.test(clanId)) {
            return;
        }

        const originalValues = inputElements.map((input) => Number(input.value));
        let isEditing = false;

        const setStatus = (message, type) => {
            if (!status) {
                return;
            }
            status.textContent = message;
            status.classList.remove('success', 'error');
            if (type) {
                status.classList.add(type);
            }
        };

        const setEditingState = (editing) => {
            isEditing = editing;
            editButton.style.display = editing ? 'none' : '';
            saveButton.style.display = editing ? '' : 'none';
            cancelButton.style.display = editing ? '' : 'none';

            valueElements.forEach((element) => {
                element.style.display = editing ? 'none' : '';
            });
            inputElements.forEach((element) => {
                element.style.display = editing ? 'block' : 'none';
            });
        };

        editButton.addEventListener('click', () => {
            setStatus('', '');
            setEditingState(true);
        });

        cancelButton.addEventListener('click', () => {
            inputElements.forEach((input, index) => {
                input.value = String(originalValues[index]);
            });
            setStatus('変更を破棄しました。', 'success');
            setEditingState(false);
        });

        saveButton.addEventListener('click', async () => {
            if (!isEditing) {
                return;
            }

            const nextValues = [];
            for (const input of inputElements) {
                const numeric = Number(input.value);
                if (!Number.isFinite(numeric) || numeric < 1 || !Number.isInteger(numeric)) {
                    setStatus('1以上の整数を入力してください。', 'error');
                    return;
                }
                nextValues.push(numeric);
            }

            const minValue = Math.min(...nextValues);
            const maxValue = Math.max(...nextValues);
            if ((maxValue - minValue) >= 3) {
                setStatus('最大値と最小値の差は2以下にしてください。', 'error');
                return;
            }

            saveButton.disabled = true;
            cancelButton.disabled = true;
            setStatus('保存中です...', '');

            try {
                const response = await fetch('/api/clan/bosslaps/save', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        clanid: clanId,
                        bosslaps: nextValues
                    })
                });

                if (!response.ok) {
                    let serverMessage = 'Failed to save clan bosslaps';
                    try {
                        const errorPayload = await response.json();
                        if (errorPayload && typeof errorPayload.error === 'string' && errorPayload.error.trim().length > 0) {
                            serverMessage = errorPayload.error.trim();
                        }
                    } catch (parseError) {
                        // noop
                    }
                    throw new Error(serverMessage);
                }

                window.location.reload();
            } catch (error) {
                console.error('ボスカウントの保存に失敗しました:', error);
                setStatus('保存に失敗しました。時間をおいて再試行してください。', 'error');
            } finally {
                saveButton.disabled = false;
                cancelButton.disabled = false;
            }
        });
    }
</script>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script>
    function initializeClanRealtimeSubscription() {
        const clanIdInput = document.getElementById('clan-id');
        const clanId = clanIdInput ? String(clanIdInput.value || '').trim() : '';
        const messageInputs = Array.from(document.querySelectorAll('.clan-attack-message-input'));
        let isReloading = false;
        let isReloadPending = false;

        const hasUnsavedMessage = () => (
            messageInputs.some((input) => input.value !== input.defaultValue)
        );

        const getRealtimeRow = (payload) => {
            if (!payload || typeof payload !== 'object') {
                return null;
            }
            const nested = payload.data && typeof payload.data === 'object' ? payload.data : null;
            const next = payload.new && typeof payload.new === 'object'
                ? payload.new
                : (nested && nested.record && typeof nested.record === 'object' ? nested.record : {});
            const prev = payload.old && typeof payload.old === 'object'
                ? payload.old
                : (nested && nested.old_record && typeof nested.old_record === 'object' ? nested.old_record : {});
            return { ...prev, ...next };
        };

        const getRealtimeClanId = (row) => {
            if (!row || row.clanid === undefined || row.clanid === null) {
                return '';
            }
            return String(row.clanid).trim();
        };

        const isRealtimeRowForCurrentClan = (row) => {
            const rowClanId = getRealtimeClanId(row);
            return !rowClanId || rowClanId === clanId;
        };

        const parseAttackData = (rawAttackData) => {
            let attackData = rawAttackData;
            if (typeof attackData === 'string') {
                try {
                    attackData = JSON.parse(attackData);
                } catch (error) {
                    return {};
                }
            }
            return attackData && typeof attackData === 'object' ? attackData : {};
        };

        const reloadPage = () => {
            if (isReloading) {
                return;
            }
            if (hasUnsavedMessage()) {
                isReloadPending = true;
                return;
            }
            isReloading = true;
            const nextUrl = new URL(window.location.href);
            nextUrl.searchParams.set('_rt', String(Date.now()));
            window.location.replace(nextUrl.toString());
        };

        const reloadPendingPage = () => {
            if (isReloadPending && !hasUnsavedMessage()) {
                reloadPage();
            }
        };

        if (!/^(?:\d+|w\d{8})$/.test(clanId) || !window.__SUPABASE_PUBLIC_CONFIG__) {
            const configExists = !!window.__SUPABASE_PUBLIC_CONFIG__;
            console.warn('Supabase Realtime を開始できません: clanId/config が不足しています。', {
                clanId,
                hasConfig: configExists
            });
            return;
        }

        const config = window.__SUPABASE_PUBLIC_CONFIG__ || {};
        const supabaseUrl = typeof config.url === 'string' ? config.url.trim() : '';
        const publishableKey = typeof config.publishableKey === 'string' ? config.publishableKey.trim() : '';
        if (!supabaseUrl || !publishableKey) {
            console.warn('Supabase Realtime を開始できません: SUPABASE_URL または SUPABASE_PUBLISHABLE_KEY が不足しています。');
            return;
        }
        if (!window.supabase || typeof window.supabase.createClient !== 'function') {
            console.error('Supabase Realtime を開始できません: Supabaseクライアントの読み込みに失敗しました。');
            return;
        }

        if (messageInputs.length > 0) {
            messageInputs.forEach((input) => {
                input.addEventListener('input', reloadPendingPage);
                input.addEventListener('clan-attack-message-saved', reloadPendingPage);
            });
        }

        const tryApplyActiveBossHpRealtimeUpdate = (row) => {
            const hpDisplays = Array.from(document.querySelectorAll('.clan-active-boss-hp-display'));
            if (hpDisplays.length === 0 || !row || typeof row !== 'object') {
                return false;
            }

            const rowBossIndex = Number(row.boss_index);
            const rowCurrentHp = Number(row.current_hp);
            if (!Number.isInteger(rowBossIndex) || !Number.isFinite(rowCurrentHp) || rowCurrentHp < 0) {
                return false;
            }

            let applied = false;
            hpDisplays.forEach((hpDisplay) => {
                const activeBossNumber = Number(hpDisplay.getAttribute('data-boss-index'));
                if (!Number.isInteger(activeBossNumber) || activeBossNumber !== rowBossIndex) {
                    return;
                }

                hpDisplay.textContent = Math.trunc(rowCurrentHp).toLocaleString('ja-JP');

                const hpBlock = hpDisplay.closest('.clan-active-boss-hp-block');
                const hpInput = hpBlock ? hpBlock.querySelector('.clan-active-boss-hp-input') : null;
                if (hpInput && hpInput.style.display === 'none') {
                    hpInput.value = String(Math.trunc(rowCurrentHp));
                }
                const panel = hpDisplay.closest('.clan-attack-active-panel');
                if (panel) {
                    panel.setAttribute('data-boss-hp', String(Math.trunc(rowCurrentHp)));
                }
                applied = true;
            });

            if (applied) {
                refreshClanAttackStatusesForBoss(rowBossIndex);
            }

            return applied;
        };

        const tryApplyClanMembersRealtimeUpdate = (row) => {
            if (!row || typeof row !== 'object') {
                return false;
            }

            const memberId = row.memberid !== undefined && row.memberid !== null
                ? String(row.memberid).trim()
                : '';
            if (!memberId) {
                return false;
            }

            const attackData = parseAttackData(row.attackdata);
            const attackBoss = Number(attackData.boss ?? attackData.attackboss);
            const isAttacking = Number.isInteger(attackBoss) && attackBoss >= 1 && attackBoss <= 5;
            const escapedMemberId = (typeof CSS !== 'undefined' && typeof CSS.escape === 'function')
                ? CSS.escape(memberId)
                : memberId;
            const memberRows = Array.from(document.querySelectorAll(`.clan-attack-member-row[data-member-id="${escapedMemberId}"]`));

            if (isAttacking !== (memberRows.length > 0)) {
                return false;
            }
            if (!isAttacking) {
                return true;
            }

            const panelBossIndexes = memberRows.map((memberRow) => {
                const panel = memberRow.closest('.clan-attack-active-panel');
                return panel ? Number(panel.getAttribute('data-boss-index')) : NaN;
            });
            if (panelBossIndexes.some((bossIndex) => bossIndex !== attackBoss)) {
                return false;
            }

            const damageValue = Number(attackData.damage);
            const hasDamageValue = attackData.damage !== null
                && attackData.damage !== undefined
                && Number.isFinite(damageValue);
            const attackMessageText = typeof (attackData.message ?? attackData.attackmessage) === 'string'
                ? String(attackData.message ?? attackData.attackmessage).trim()
                : '';
            const suffix = attackMessageText
                ? `、${attackMessageText}`
                : (hasDamageValue ? '' : '、メッセージなし');
            const rowText = `：${(Number.isFinite(damageValue) ? damageValue : 0).toLocaleString('ja-JP')}${suffix}`;
            const attacktime = Array.isArray(row.attacktime) ? row.attacktime : attackData.attacktime;
            const sortieIndex = Number(attackData.sortie) - 1;
            const carryTimeValue = Array.isArray(attacktime) ? Number(attacktime[sortieIndex]) : NaN;
            const carryTimeText = Number(attackData.overattack) === 1 && Number.isInteger(carryTimeValue)
                ? ` [持:${carryTimeValue}]`
                : '';
            const displayName = `${row.name || 'Unknown'}${carryTimeText}`;
            const panelsToRefresh = new Set();

            memberRows.forEach((memberRow) => {
                memberRow.setAttribute('data-name', String(row.name || 'Unknown'));
                memberRow.setAttribute('data-damage', String(Number.isFinite(damageValue) ? Math.trunc(damageValue) : 0));
                memberRow.setAttribute('data-overattack', Number(attackData.overattack) === 1 ? '1' : '0');
                const nameElement = memberRow.querySelector('strong');
                const textElement = memberRow.querySelector('.clan-attack-member-row-text');
                if (nameElement) {
                    nameElement.textContent = displayName;
                }
                if (textElement) {
                    textElement.textContent = rowText;
                }
                const panel = memberRow.closest('.clan-attack-active-panel');
                if (panel) {
                    panelsToRefresh.add(panel);
                }
            });
            panelsToRefresh.forEach((panel) => refreshClanAttackPanelStatuses(panel));

            return true;
        };

        try {
            // Bot は service_role で RLS を迂回できるが、Web は publishable/anon。
            // SUBSCRIBED でも payload が来ない場合は anon の SELECT 権限/RLS を確認すること。
            const client = window.supabase.createClient(supabaseUrl, publishableKey);
            const clanIdFilter = `clanid=eq.${clanId}`;
            const channel = client
                .channel(`clan-realtime-${clanId}`)
                .on('postgres_changes', {
                    event: '*',
                    schema: 'public',
                    table: 'clans',
                    filter: clanIdFilter
                }, (payload) => {
                    console.log('Supabase Realtime clans change payload:', payload);
                    const row = getRealtimeRow(payload);
                    if (isRealtimeRowForCurrentClan(row)) {
                        reloadPage();
                    }
                })
                .on('postgres_changes', {
                    event: '*',
                    schema: 'public',
                    table: 'clan_members',
                    filter: clanIdFilter
                }, (payload) => {
                    console.log('Supabase Realtime clan_members change payload:', payload);
                    const row = getRealtimeRow(payload);
                    if (!isRealtimeRowForCurrentClan(row)) {
                        return;
                    }

                    const eventType = payload && typeof payload.eventType === 'string' ? payload.eventType : '';
                    if (eventType !== 'INSERT' && eventType !== 'DELETE' && tryApplyClanMembersRealtimeUpdate(row)) {
                        return;
                    }
                    reloadPage();
                })
                .on('postgres_changes', {
                    event: '*',
                    schema: 'public',
                    table: 'clan_boss_state',
                    filter: clanIdFilter
                }, (payload) => {
                    console.log('Supabase Realtime clan_boss_state change payload:', payload);
                    const row = getRealtimeRow(payload);
                    if (!isRealtimeRowForCurrentClan(row)) {
                        return;
                    }

                    const eventType = payload && typeof payload.eventType === 'string' ? payload.eventType : '';
                    if (eventType !== 'DELETE' && tryApplyActiveBossHpRealtimeUpdate(row)) {
                        return;
                    }
                    //読み込めなかったものは無視
                    //reloadPage();
                })
                .subscribe((status, error) => {
                    console.log('Supabase Realtime subscription status:', status, error || '');
                    if (status === 'SUBSCRIBED') {
                        console.info(
                            'Realtime SUBSCRIBED。clan_members の payload が来ない場合は、'
                            + 'anon への GRANT SELECT と SELECT RLS ポリシーを確認してください。'
                        );
                    }
                    if (status === 'CHANNEL_ERROR' || status === 'TIMED_OUT') {
                        console.error('Supabase Realtimeの購読に失敗しました:', status, error || '');
                    }
                });

            window.addEventListener('beforeunload', () => {
                messageInputs.forEach((input) => {
                    input.removeEventListener('input', reloadPendingPage);
                    input.removeEventListener('clan-attack-message-saved', reloadPendingPage);
                });
                client.removeChannel(channel);
            });
        } catch (error) {
            console.error('Supabase Realtime の購読開始に失敗しました:', error);
        }
    }

</script>
