    function initializeClanActivePanelsVisibility() {
        const checkbox = document.getElementById('clan-show-all-active-checkbox');
        const otherPanels = Array.from(document.querySelectorAll('.clan-attack-active-panel-other'));
        if (!checkbox || otherPanels.length === 0) {
            return;
        }

        const cookieKey = 'clanShowAllActive';
        const readCookieValue = (key) => {
            const escapedKey = key.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
            const match = document.cookie.match(new RegExp(`(?:^|; )${escapedKey}=([^;]*)`));
            return match ? decodeURIComponent(match[1]) : '';
        };
        const writeCookieValue = (key, value) => {
            document.cookie = `${key}=${encodeURIComponent(value)}; max-age=31536000; path=/; samesite=lax`;
        };

        const applyVisibility = () => {
            const shouldShow = checkbox.checked;
            otherPanels.forEach((panel) => {
                panel.style.display = shouldShow ? '' : 'none';
            });
        };

        checkbox.checked = readCookieValue(cookieKey) === '1';
        checkbox.addEventListener('change', () => {
            writeCookieValue(cookieKey, checkbox.checked ? '1' : '0');
            applyVisibility();
        });
        applyVisibility();
    }

