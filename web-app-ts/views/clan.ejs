<div class="page-content clan-page" id="clan-page" data-base-date="<%= clanPageData && clanPageData.baseDate ? clanPageData.baseDate : '' %>">
    <% const data = clanPageData || { discordServer: '', clan: null, members: [], currentMember: null, operableMembers: [], attackHistories: [], bossNames: [], bossHp: [], baseDate: '', refreshToken: 'none:0', loadError: '' }; %>
    <h2><%= data.clan && data.clan.name ? data.clan.name : '未登録' %></h2>
    <%
        const allMembers = Array.isArray(data.members) ? data.members : [];
        const operableMembers = Array.isArray(data.operableMembers) ? data.operableMembers : [];
        const activeBossNumbers = Array.from(new Set(allMembers
            .map((member) => Number(member.attackboss))
            .filter((attackBoss) => Number.isInteger(attackBoss) && attackBoss >= 1 && attackBoss <= 5)))
            .sort((left, right) => left - right);
        const operableAttackingBossNumbers = Array.from(new Set(operableMembers
            .map((member) => Number(member.attackboss))
            .filter((attackBoss) => Number.isInteger(attackBoss) && attackBoss >= 1 && attackBoss <= 5)))
            .sort((left, right) => left - right);
    %>
    <% if (activeBossNumbers.length > 0) { %>
        <label class="clan-show-all-active-toggle">
            <input id="clan-show-all-active-checkbox" type="checkbox" />
            すべての攻撃中を表示
        </label>
    <% } %>

    <% operableAttackingBossNumbers.forEach((bossNumber) => { %>
        <%
            const activeBossIndex = bossNumber - 1;
            const activeBossName = Array.isArray(data.bossNames) && typeof data.bossNames[activeBossIndex] === 'string' && data.bossNames[activeBossIndex].trim()
                ? data.bossNames[activeBossIndex].trim()
                : `ボス ${bossNumber}`;
            const activeBossHpValue = Array.isArray(data.bossHp) ? Number(data.bossHp[activeBossIndex]) : NaN;
            const activeBossHp = Number.isFinite(activeBossHpValue) ? activeBossHpValue.toLocaleString('ja-JP') : '未設定';
            const activeAttackMembers = Array.isArray(allMembers)
                ? allMembers.filter((member) => Number(member.attackboss) === bossNumber)
                : [];
            const operableAttackersForBoss = operableMembers.filter((member) => Number(member.attackboss) === bossNumber);
            const bossLapDisplay = activeAttackMembers.length > 0 && Number.isInteger(Number(activeAttackMembers[0].attacklap))
                ? Number(activeAttackMembers[0].attacklap)
                : '-';
        %>
        <section class="clan-attack-active-panel" aria-labelledby="clan-attack-active-title-<%= bossNumber %>" data-boss-index="<%= bossNumber %>" data-boss-hp="<%= Number.isFinite(activeBossHpValue) ? Math.trunc(activeBossHpValue) : '' %>" data-acting-member-id="<%= operableAttackersForBoss.length > 0 ? operableAttackersForBoss[0].memberid : '' %>">
            <div class="clan-attack-active-header">
                <h2 id="clan-attack-active-title-<%= bossNumber %>">攻撃中</h2>
                <div class="clan-active-boss-hp-block" data-boss-index="<%= bossNumber %>">
                    <p><strong><%= bossLapDisplay %>周目</strong>：<%= activeBossName %>、HP <span class="clan-active-boss-hp-display" data-boss-index="<%= bossNumber %>"><%= activeBossHp %></span></p>
                    <div class="clan-active-boss-hp-actions">
                        <button type="button" class="btn btn-primary clan-active-boss-hp-edit-button">変更</button>
                        <input
                            class="clan-active-boss-hp-input"
                            type="number"
                            min="0"
                            step="1"
                            inputmode="numeric"
                            autocomplete="off"
                            value="<%= Number.isFinite(activeBossHpValue) ? Math.trunc(activeBossHpValue) : '' %>"
                            style="display: none;"
                        />
                        <button type="button" class="btn btn-primary clan-active-boss-hp-save-button" style="display: none;">確定</button>
                        <button type="button" class="btn btn-danger clan-active-boss-hp-cancel-button" style="display: none;">破棄</button>
                    </div>
                    <p class="clan-active-boss-hp-status settings-status" aria-live="polite"></p>
                </div>
            </div>

            <div class="clan-attack-member-list">
                <% activeAttackMembers.forEach((member) => { %>
                    <%- include('partials/clan-attack-member-row', { member, attackingMembers: activeAttackMembers, bossHp: activeBossHpValue }) %>
                <% }); %>
            </div>

            <% operableAttackersForBoss.forEach((member) => { %>
                <div class="clan-operate-panel" data-member-id="<%= member.memberid %>">
                    <label class="clan-attack-message-label"><%= member.isSelf ? '自分' : '代理操作' %>：<%= member.name || 'Unknown' %></label>
                    <div class="clan-attack-message-row">
                        <input
                            class="clan-attack-message-input"
                            type="text"
                            maxlength="200"
                            placeholder="ダメージ、コメントを入力"
                            value="<%= member.attackmessage || '' %>"
                        />
                        <button type="button" class="btn btn-primary clan-attack-message-send-button">送信</button>
                    </div>
                    <div class="clan-attack-active-actions">
                        <button type="button" class="btn btn-primary clan-attack-complete-button">完了</button>
                        <div class="clan-defeat-buttons" role="group" aria-label="討伐時間の選択">
                            <% if (Number(member.overattack) === 1) { %>
                                <button type="button" class="btn btn-primary clan-attack-defeat-button" data-overtime="0">討伐:0</button>
                            <% } else { %>
                                <% [20, 30, 40, 50, 60, 70, 80, 90].forEach((overtime) => { %>
                                    <button type="button" class="btn btn-primary clan-attack-defeat-button" data-overtime="<%= overtime %>">討伐:<%= overtime %></button>
                                <% }); %>
                            <% } %>
                        </div>
                        <button type="button" class="btn btn-danger clan-attack-cancel-button">キャンセル</button>
                    </div>
                    <p class="clan-attack-active-action-status settings-status" aria-live="polite"></p>
                </div>
            <% }); %>
        </section>
    <% }); %>

    <% activeBossNumbers.filter((bossNumber) => !operableAttackingBossNumbers.includes(bossNumber)).forEach((bossNumber) => { %>
        <%
            const activeBossIndex = bossNumber - 1;
            const activeBossName = Array.isArray(data.bossNames) && typeof data.bossNames[activeBossIndex] === 'string' && data.bossNames[activeBossIndex].trim()
                ? data.bossNames[activeBossIndex].trim()
                : `ボス ${bossNumber}`;
            const activeBossHpValue = Array.isArray(data.bossHp) ? Number(data.bossHp[activeBossIndex]) : NaN;
            const activeBossHp = Number.isFinite(activeBossHpValue) ? activeBossHpValue.toLocaleString('ja-JP') : '未設定';
            const activeAttackMembers = Array.isArray(allMembers)
                ? allMembers.filter((member) => Number(member.attackboss) === bossNumber)
                : [];
        %>
        <section class="clan-attack-active-panel clan-attack-active-panel-other" aria-labelledby="clan-attack-active-title-other-<%= bossNumber %>" data-boss-index="<%= bossNumber %>" data-boss-hp="<%= Number.isFinite(activeBossHpValue) ? Math.trunc(activeBossHpValue) : '' %>" style="display: none;">
            <div class="clan-attack-active-header">
                <h2 id="clan-attack-active-title-other-<%= bossNumber %>">攻撃中</h2>
                <p><strong><%= activeAttackMembers.length > 0 && Number.isInteger(Number(activeAttackMembers[0].attacklap)) ? Number(activeAttackMembers[0].attacklap) : '-' %>周目</strong>：<%= activeBossName %>、HP <span class="clan-active-boss-hp-display" data-boss-index="<%= bossNumber %>"><%= activeBossHp %></span></p>
            </div>

            <div class="clan-attack-member-list">
                <% activeAttackMembers.forEach((member) => { %>
                    <%- include('partials/clan-attack-member-row', { member, attackingMembers: activeAttackMembers, bossHp: activeBossHpValue }) %>
                <% }); %>
            </div>
        </section>
    <% }); %>

    <input type="hidden" id="clan-refresh-token" value="<%= data.refreshToken %>" />
    <input type="hidden" id="clan-id" value="<%= data.clan && data.clan.clanid ? data.clan.clanid : '' %>" />

    <% if (data.loadError) { %>
        <div class="settings-firebase-error"><%= data.loadError %></div>
    <% } else { %>
        <div class="settings-card clan-summary-card">
            <% const laps = data.clan && Array.isArray(data.clan.bosslaps) ? data.clan.bosslaps : []; %>
            <% if (laps.length !== 5) { %>
                <p class="clan-empty">bosslaps が未設定です。</p>
            <% } else { %>
                <%
                    const numericBossCounts = laps.map((value) => Number(value));
                    const minBossCount = numericBossCounts.length > 0 ? Math.min(...numericBossCounts) : 0;
                    const clanMembers = Array.isArray(data.members) ? data.members : [];
                    const currentAttackHistories = Array.isArray(data.attackHistories) ? data.attackHistories : [];
                    const bossAttackDisabled = laps.map((count) => Number(count) >= minBossCount + 2);
                    const idleOperableMembers = operableMembers.filter((member) => Number(member.attackboss) === 0);
                %>
                <section class="clandata-section">
                    <div class="clan-bosscount-header">
                        <h3>ボスカウント</h3>
                        <div class="clan-bosscount-actions">
                            <button id="clan-bosscount-edit-btn" type="button" class="btn btn-primary">修正</button>
                            <button id="clan-bosscount-save-btn" type="button" class="btn btn-primary" style="display: none;">確定</button>
                            <button id="clan-bosscount-cancel-btn" type="button" class="btn btn-danger" style="display: none;">破棄</button>
                        </div>
                    </div>
                    <div class="bosscount-display">
                        <% laps.forEach((count, idx) => { %>
                            <%
                                const currentCount = Number(count);
                                let countStateClass = '';
                                if (currentCount === minBossCount + 1) {
                                    countStateClass = 'bosscount-near-min';
                                } else if (currentCount >= minBossCount + 2) {
                                    countStateClass = 'bosscount-far-min';
                                }
                                const attackingMembers = clanMembers.filter((member) => {
                                    const attackBoss = Number(member.attackboss);
                                    return Number.isInteger(attackBoss)
                                        && attackBoss > 0
                                        && (attackBoss - 1) % 5 === idx;
                                });
                            %>
                            <div class="bosscount-item <%= countStateClass %>">
                                <p>
                                    <span class="boss-name-label" data-boss-index="<%= idx %>">ボス <%= idx + 1 %></span>:
                                    <strong class="clan-bosslap-value" data-boss-index="<%= idx %>"><%= Number(count) %></strong>
                                    <input
                                        type="number"
                                        class="clan-bosslap-input"
                                        data-boss-index="<%= idx %>"
                                        min="1"
                                        step="1"
                                        value="<%= Number(count) %>"
                                        style="display: none;"
                                    />
                                </p>
                                <div class="clan-attacking-members">
                                    <% attackingMembers.forEach((member) => { %>
                                        <span class="clan-attacking-member-name"><%= member.name || 'Unknown' %></span>
                                    <% }); %>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                    <p id="clan-bosslap-status" class="settings-status"></p>
                </section>

                <% if (idleOperableMembers.length > 0) { %>
                    <%
                        const hideStartAttackNameColumn = operableMembers.length === 1
                            && operableMembers[0]
                            && operableMembers[0].isSelf === true;
                    %>
                    <section class="clandata-section clan-start-attack-section">
                        <h3>攻撃開始</h3>
                        <div class="clan-start-attack-table-wrapper">
                            <table class="clan-start-attack-table<%= hideStartAttackNameColumn ? ' clan-start-attack-table-no-name' : '' %>">
                                <thead>
                                    <tr>
                                        <% if (!hideStartAttackNameColumn) { %>
                                            <th>名前</th>
                                        <% } %>
                                        <% laps.forEach((count, idx) => { %>
                                            <%
                                                const headerCount = Number(count);
                                                let headerStateClass = '';
                                                if (headerCount === minBossCount + 1) {
                                                    headerStateClass = 'bosscount-near-min';
                                                } else if (headerCount >= minBossCount + 2) {
                                                    headerStateClass = 'bosscount-far-min';
                                                }
                                            %>
                                            <th class="bosscount-item <%= headerStateClass %>">
                                                <span class="boss-name-label" data-boss-index="<%= idx %>">ボス <%= idx + 1 %></span>
                                            </th>
                                        <% }); %>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% idleOperableMembers.forEach((member) => { %>
                                        <%
                                            const memberHistories = currentAttackHistories.filter((history) => history.memberid === member.memberid);
                                            const memberMaxSortie = memberHistories.reduce((max, history) => {
                                                const sortie = Number(history.sortie);
                                                return Number.isFinite(sortie) ? Math.max(max, sortie) : max;
                                            }, 0);
                                            const memberHistoryCountBySortie = memberHistories.reduce((counts, history) => {
                                                const sortie = Number(history.sortie);
                                                counts.set(sortie, (counts.get(sortie) || 0) + 1);
                                                return counts;
                                            }, new Map());
                                            const memberCarryOverHistories = memberHistories.filter((history) => (
                                                history.defeat === true
                                                && memberHistoryCountBySortie.get(Number(history.sortie)) === 1
                                                && Number.isInteger(Number(history.overtime))
                                                && Number(history.overtime) >= 20
                                                && Number(history.overtime) <= 90
                                            ));
                                            const memberCanStartAttack = memberMaxSortie < 3;
                                        %>
                                        <tr class="clan-operate-panel" data-member-id="<%= member.memberid %>">
                                            <% if (!hideStartAttackNameColumn) { %>
                                                <td class="clan-operate-panel-label"><%= member.isSelf ? '自分' : '代理操作' %>：<%= member.name || 'Unknown' %></td>
                                            <% } %>
                                            <% laps.forEach((count, idx) => { %>
                                                <td class="clan-start-attack-boss-cell">
                                                    <% if (memberCanStartAttack) { %>
                                                        <button
                                                            type="button"
                                                            class="btn btn-primary clan-attack-button"
                                                            data-boss="<%= idx + 1 %>"
                                                            aria-label="ボス<%= idx + 1 %>を攻撃"
                                                            <%= bossAttackDisabled[idx] ? 'disabled' : '' %>
                                                        >新規攻撃</button>
                                                    <% } %>
                                                    <% memberCarryOverHistories.forEach((history) => { %>
                                                        <button
                                                            type="button"
                                                            class="btn clan-attack-button clan-carryover-attack-button"
                                                            data-boss="<%= idx + 1 %>"
                                                            data-history-id="<%= Number(history.id) %>"
                                                            aria-label="<%= Number(history.overtime) %>秒の持ち越しでボス<%= idx + 1 %>を攻撃"
                                                            <%= bossAttackDisabled[idx] ? 'disabled' : '' %>
                                                        ><%= Number(history.overtime) %>s攻撃</button>
                                                    <% }); %>
                                                </td>
                                            <% }); %>
                                        </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>
                        <p id="clan-attack-status" class="settings-status" aria-live="polite"></p>
                    </section>
                <% } %>
            <% } %>

            <% const attackHistories = Array.isArray(data.attackHistories) ? data.attackHistories : []; %>
            <% const bossNames = Array.isArray(data.bossNames) ? data.bossNames : []; %>
            <section class="clandata-section clan-attack-history-section">
                <div class="clan-bosscount-header">
                    <h3>凸履歴</h3>
                    <% if (attackHistories.length > 0) { %>
                        <div class="clan-bosscount-actions">
                            <button id="clan-history-edit-button" type="button" class="btn btn-primary">修正</button>
                            <button id="clan-history-save-button" type="button" class="btn btn-primary" style="display: none;">確定</button>
                            <button id="clan-history-cancel-button" type="button" class="btn btn-danger" style="display: none;">破棄</button>
                        </div>
                    <% } %>
                </div>
                <% if (attackHistories.length === 0) { %>
                    <p class="clan-empty">本日の凸履歴はありません。</p>
                <% } else { %>
                    <div class="clan-attack-history-table-wrapper">
                        <table class="clan-attack-history-table">
                            <thead>
                                <tr>
                                    <th>メンバー</th>
                                    <th>凸数</th>
                                    <th>周回数</th>
                                    <th>ボス</th>
                                    <th>状態</th>
                                    <th>操作</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% attackHistories.forEach((history) => { %>
                                    <%
                                        const bossNumber = Number(history.boss);
                                        const bossIndex = bossNumber > 0 ? (bossNumber - 1) % 5 : -1;
                                        const configuredBossName = bossIndex >= 0 && typeof bossNames[bossIndex] === 'string'
                                            ? bossNames[bossIndex].trim()
                                            : '';
                                        const bossName = configuredBossName || (bossIndex >= 0 ? `ボス ${bossIndex + 1}` : 'ボス不明');
                                        const historyMember = operableMembers.find((member) => member.memberid === history.memberid);
                                        const historyMemberName = historyMember ? (historyMember.name || 'Unknown') : (history.memberid || 'Unknown');
                                        const sameMemberHistories = attackHistories.filter((otherHistory) => otherHistory.memberid === history.memberid);
                                        const hasSameSortieHistory = sameMemberHistories.some((otherHistory) => (
                                            Number(otherHistory.id) !== Number(history.id)
                                            && Number(otherHistory.sortie) === Number(history.sortie)
                                        ));
                                        const hasEditableOvertime = !hasSameSortieHistory || Number(history.overtime) > 0;
                                        const isDefeatOnly = hasSameSortieHistory && Number(history.overtime) > 0;
                                        const isDeleteDisabled = isDefeatOnly;
                                        const isUnusedCarryOver = !hasSameSortieHistory && Number(history.overtime) > 0;
                                    %>
                                    <tr
                                        class="clan-attack-history-row <%= isUnusedCarryOver ? 'clan-attack-history-carryover-source' : '' %>"
                                        data-history-id="<%= Number(history.id) %>"
                                        data-member-id="<%= history.memberid || '' %>"
                                        data-original-attacklap="<%= Number.isInteger(history.attacklap) ? Number(history.attacklap) : '' %>"
                                        data-original-boss="<%= bossNumber %>"
                                        data-original-defeat="<%= history.defeat === true ? 'true' : 'false' %>"
                                        data-original-overtime="<%= Number(history.overtime) %>"
                                        data-fixed-overtime="<%= hasEditableOvertime ? '' : '0' %>"
                                    >
                                        <td>
                                            <span><%= historyMemberName %><%= historyMember && !historyMember.isSelf ? '（代理）' : '' %></span>
                                        </td>
                                        <td>
                                            <span><%= Number(history.sortie) %>凸</span>
                                        </td>
                                        <td>
                                            <span class="clan-history-display"><%= Number.isInteger(history.attacklap) ? `${Number(history.attacklap)}周目` : '不明' %></span>
                                            <input class="clan-history-input clan-history-attacklap-input" type="number" min="0" step="1" value="<%= Number.isInteger(history.attacklap) ? Number(history.attacklap) : '' %>" aria-label="周回数" />
                                        </td>
                                        <td>
                                            <span class="clan-history-display"><%= bossName %></span>
                                            <select class="clan-history-input clan-history-boss-input">
                                                <% for (let bossOption = 1; bossOption <= 5; bossOption += 1) { %>
                                                    <% const optionName = typeof bossNames[bossOption - 1] === 'string' && bossNames[bossOption - 1].trim() ? bossNames[bossOption - 1].trim() : `ボス ${bossOption}`; %>
                                                    <option value="<%= bossOption %>" <%= bossOption === bossNumber ? 'selected' : '' %>><%= optionName %></option>
                                                <% } %>
                                            </select>
                                        </td>
                                        <td>
                                            <span class="clan-history-display"><%= history.defeat === true
                                                ? Number(history.overtime) > 0 ? `討伐:${Number(history.overtime)}秒` : '討伐'
                                                : '未討伐' %></span>
                                            <div class="clan-history-input clan-history-state-editor">
                                                <select class="clan-history-defeat-input">
                                                    <% if (!isDefeatOnly) { %>
                                                        <option value="false" <%= history.defeat !== true ? 'selected' : '' %>>未討伐</option>
                                                    <% } %>
                                                    <option value="true" <%= history.defeat === true ? 'selected' : '' %>>討伐</option>
                                                </select>
                                                <% if (hasEditableOvertime) { %>
                                                    <input class="clan-history-overtime-input" type="number" min="20" max="90" step="1" value="<%= Number(history.overtime) %>" aria-label="持ち越し時間" />
                                                    <span class="clan-history-overtime-unit">秒</span>
                                                <% } %>
                                            </div>
                                        </td>
                                        <td>
                                            <button
                                                type="button"
                                                class="clan-history-input clan-history-delete-button btn btn-danger"
                                                <%= isDeleteDisabled ? 'disabled title="持ち越し使用後の討伐履歴は削除できません"' : '' %>
                                            >削除</button>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
                <p id="clan-history-status" class="settings-status" aria-live="polite"></p>
            </section>
        </div>
    <% } %>
</div>

<script src="/scripts/attackStatus.js"></script>
<script>
    function parseClanBossHpText(text) {
        const value = Number(String(text || '').replace(/,/g, '').trim());
        return Number.isFinite(value) ? value : NaN;
    }

    function readClanAttackPanelBossHp(panel) {
        if (!panel) {
            return NaN;
        }
        const display = panel.querySelector('.clan-active-boss-hp-display');
        if (display) {
            const displayHp = parseClanBossHpText(display.textContent);
            if (Number.isFinite(displayHp)) {
                return displayHp;
            }
        }
        return parseClanBossHpText(panel.getAttribute('data-boss-hp'));
    }

    function collectClanAttackPanelMembers(panel) {
        return Array.from(panel.querySelectorAll('.clan-attack-member-row')).map((row) => ({
            memberid: String(row.getAttribute('data-member-id') || ''),
            name: String(row.getAttribute('data-name') || ''),
            damage: Number(row.getAttribute('data-damage')),
            overattack: Number(row.getAttribute('data-overattack'))
        }));
    }

    function refreshClanAttackPanelStatuses(panel) {
        if (!panel || !window.ClanAttackStatus || typeof window.ClanAttackStatus.buildClanAttackMemberStatus !== 'function') {
            return;
        }
        const bossHp = readClanAttackPanelBossHp(panel);
        const members = collectClanAttackPanelMembers(panel);
        Array.from(panel.querySelectorAll('.clan-attack-member-row')).forEach((row, index) => {
            const statusElement = row.querySelector('.clan-attack-member-status');
            if (!statusElement) {
                return;
            }
            const statusText = window.ClanAttackStatus.buildClanAttackMemberStatus(members[index], members, bossHp);
            statusElement.textContent = statusText ? ` ${statusText}` : '';
        });
    }

    function refreshClanAttackStatusesForBoss(bossIndex) {
        Array.from(document.querySelectorAll(`.clan-attack-active-panel[data-boss-index="${bossIndex}"]`))
            .forEach(refreshClanAttackPanelStatuses);
    }

    function updateClanAttackMemberRowText(row, damage, message, hasDamageValue) {
        const textElement = row ? row.querySelector('.clan-attack-member-row-text') : null;
        if (!textElement) {
            return;
        }
        const damageValue = Number.isFinite(Number(damage)) ? Number(damage) : 0;
        const messageText = typeof message === 'string' ? message.trim() : '';
        const suffix = messageText
            ? `、${messageText}`
            : (hasDamageValue ? '' : '、メッセージなし');
        textElement.textContent = `：${damageValue.toLocaleString('ja-JP')}${suffix}`;
    }

    async function replaceBossLabelsFromClanBattleSettings() {
        const labelElements = Array.from(document.querySelectorAll('.boss-name-label[data-boss-index]'));
        if (labelElements.length === 0) {
            return;
        }

        try {
            const response = await fetch('/api/clanbattle-settings/current', {
                method: 'GET',
                cache: 'no-store'
            });
            if (!response.ok) {
                return;
            }

            const payload = await response.json();
            const state = payload && payload.state ? payload.state : null;
            const bossNames = state && Array.isArray(state.bossname) ? state.bossname : [];

            labelElements.forEach((element) => {
                const index = Number(element.getAttribute('data-boss-index'));
                const bossName = typeof bossNames[index] === 'string' ? bossNames[index].trim() : '';
                if (bossName.length > 0) {
                    element.textContent = bossName;
                }
            });
        } catch (error) {
            console.error('クラバト設定のボス名取得に失敗しました:', error);
        }
    }

