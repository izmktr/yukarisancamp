<div class="page-content clan-page">
    <% const data = clanPageData || { discordServer: '', clan: null, members: [], currentMember: null, attackHistories: [], bossNames: [], baseDate: '', refreshToken: 'none:0', loadError: '' }; %>
    <% if (data.currentMember && Number(data.currentMember.attackboss) !== 0) { %>
        <div class="clan-attack-active-status" role="status">攻撃中</div>
    <% } %>
    <h2><%= data.clan && data.clan.name ? data.clan.name : '未登録' %></h2>

    <input type="hidden" id="clan-refresh-token" value="<%= data.refreshToken %>" />
    <input type="hidden" id="clan-source" value="<%= data.clan && data.clan.source ? data.clan.source : '' %>" />
    <input type="hidden" id="clan-id" value="<%= data.clan && data.clan.clanid ? data.clan.clanid : '' %>" />

    <% if (data.loadError) { %>
        <div class="settings-firebase-error"><%= data.loadError %></div>
    <% } else { %>
        <div class="settings-card clan-summary-card">
            <% const laps = data.clan && Array.isArray(data.clan.bosslaps) ? data.clan.bosslaps : []; %>
            <% if (laps.length !== 5) { %>
                <p class="clan-empty">bosslaps が未設定です。</p>
            <% } else { %>
                <%
                    const numericBossCounts = laps.map((value) => Number(value));
                    const minBossCount = numericBossCounts.length > 0 ? Math.min(...numericBossCounts) : 0;
                    const clanMembers = Array.isArray(data.members) ? data.members : [];
                    const canStartAttack = data.currentMember && Number(data.currentMember.attackboss) === 0;
                %>
                <section class="clandata-section">
                    <div class="clan-bosscount-header">
                        <h3>ボスカウント</h3>
                        <div class="clan-bosscount-actions">
                            <button id="clan-bosscount-edit-btn" type="button" class="btn btn-primary">修正</button>
                            <button id="clan-bosscount-save-btn" type="button" class="btn btn-primary" style="display: none;">確定</button>
                            <button id="clan-bosscount-cancel-btn" type="button" class="btn btn-danger" style="display: none;">破棄</button>
                        </div>
                    </div>
                    <div class="bosscount-display">
                        <% laps.forEach((count, idx) => { %>
                            <%
                                const currentCount = Number(count);
                                let countStateClass = '';
                                if (currentCount === minBossCount + 1) {
                                    countStateClass = 'bosscount-near-min';
                                } else if (currentCount >= minBossCount + 2) {
                                    countStateClass = 'bosscount-far-min';
                                }
                                const attackingMembers = clanMembers.filter((member) => {
                                    const attackBoss = Number(member.attackboss);
                                    return Number.isInteger(attackBoss)
                                        && attackBoss > 0
                                        && (attackBoss - 1) % 5 === idx;
                                });
                            %>
                            <div class="bosscount-item <%= countStateClass %>">
                                <p>
                                    <span class="boss-name-label" data-boss-index="<%= idx %>">ボス <%= idx + 1 %></span>:
                                    <strong class="clan-bosslap-value" data-boss-index="<%= idx %>"><%= Number(count) %></strong>
                                    <input
                                        type="number"
                                        class="clan-bosslap-input"
                                        data-boss-index="<%= idx %>"
                                        min="1"
                                        step="1"
                                        value="<%= Number(count) %>"
                                        style="display: none;"
                                    />
                                </p>
                                <div class="clan-attacking-members">
                                    <% attackingMembers.forEach((member) => { %>
                                        <span class="clan-attacking-member-name"><%= member.name || 'Unknown' %></span>
                                    <% }); %>
                                </div>
                                <% if (canStartAttack) { %>
                                    <button
                                        type="button"
                                        class="btn btn-primary clan-attack-button"
                                        data-boss="<%= idx + 1 %>"
                                        aria-label="ボス<%= idx + 1 %>を攻撃"
                                    >攻撃</button>
                                <% } %>
                            </div>
                        <% }); %>
                    </div>
                    <p id="clan-bosslap-status" class="settings-status"></p>
                    <p id="clan-attack-status" class="settings-status" aria-live="polite"></p>
                </section>
            <% } %>

            <% const attackHistories = Array.isArray(data.attackHistories) ? data.attackHistories : []; %>
            <% const bossNames = Array.isArray(data.bossNames) ? data.bossNames : []; %>
            <section class="clandata-section clan-attack-history-section">
                <h3>凸履歴</h3>
                <% if (attackHistories.length === 0) { %>
                    <p class="clan-empty">本日の凸履歴はありません。</p>
                <% } else { %>
                    <div class="clan-attack-history-table-wrapper">
                        <table class="clan-attack-history-table">
                            <thead>
                                <tr>
                                    <th>凸数</th>
                                    <th>ボス</th>
                                    <th>状態</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% attackHistories.forEach((history) => { %>
                                    <%
                                        const bossNumber = Number(history.boss);
                                        const bossIndex = bossNumber >= 0 ? bossNumber % 5 : -1;
                                        const configuredBossName = bossIndex >= 0 && typeof bossNames[bossIndex] === 'string'
                                            ? bossNames[bossIndex].trim()
                                            : '';
                                        const bossName = configuredBossName || (bossIndex >= 0 ? `ボス ${bossIndex + 1}` : 'ボス不明');
                                    %>
                                    <tr>
                                        <td><%= Number(history.sortie) %>凸</td>
                                        <td><%= bossName %></td>
                                        <td><%= history.defeat === true ? `（討伐:${Number(history.overtime)}秒）` : '済' %></td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </section>
        </div>
    <% } %>
</div>

<script>
    async function replaceBossLabelsFromClanBattleSettings() {
        const labelElements = Array.from(document.querySelectorAll('.boss-name-label[data-boss-index]'));
        if (labelElements.length === 0) {
            return;
        }

        try {
            const response = await fetch('/api/clanbattle-settings/current', {
                method: 'GET',
                cache: 'no-store'
            });
            if (!response.ok) {
                return;
            }

            const payload = await response.json();
            const state = payload && payload.state ? payload.state : null;
            const bossNames = state && Array.isArray(state.bossname) ? state.bossname : [];

            labelElements.forEach((element) => {
                const index = Number(element.getAttribute('data-boss-index'));
                const bossName = typeof bossNames[index] === 'string' ? bossNames[index].trim() : '';
                if (bossName.length > 0) {
                    element.textContent = bossName;
                }
            });
        } catch (error) {
            console.error('クラバト設定のボス名取得に失敗しました:', error);
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        replaceBossLabelsFromClanBattleSettings();
        initializeClanBosslapEditor();
        initializeClanAttackButtons();
    });

    function initializeClanAttackButtons() {
        const attackButtons = Array.from(document.querySelectorAll('.clan-attack-button[data-boss]'));
        const status = document.getElementById('clan-attack-status');
        if (attackButtons.length === 0) {
            return;
        }

        const setStatus = (message, type) => {
            if (!status) {
                return;
            }
            status.textContent = message;
            status.classList.remove('success', 'error');
            if (type) {
                status.classList.add(type);
            }
        };

        attackButtons.forEach((button) => {
            button.addEventListener('click', async () => {
                const attackBoss = Number(button.getAttribute('data-boss'));
                if (!Number.isInteger(attackBoss) || attackBoss < 1 || attackBoss > 5) {
                    return;
                }

                attackButtons.forEach((item) => {
                    item.disabled = true;
                });
                setStatus('攻撃開始を登録しています...', '');

                try {
                    const response = await fetch('/api/clan/attack/start', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({ attackBoss })
                    });

                    if (!response.ok) {
                        const payload = await response.json().catch(() => null);
                        throw new Error(payload && payload.error ? payload.error : 'Failed to start attack');
                    }

                    window.location.reload();
                } catch (error) {
                    console.error('攻撃開始の登録に失敗しました:', error);
                    setStatus('攻撃開始の登録に失敗しました。画面を更新して再試行してください。', 'error');
                    attackButtons.forEach((item) => {
                        item.disabled = false;
                    });
                }
            });
        });
    }

    function initializeClanBosslapEditor() {
        const editButton = document.getElementById('clan-bosscount-edit-btn');
        const saveButton = document.getElementById('clan-bosscount-save-btn');
        const cancelButton = document.getElementById('clan-bosscount-cancel-btn');
        const status = document.getElementById('clan-bosslap-status');
        const sourceInput = document.getElementById('clan-source');
        const clanIdInput = document.getElementById('clan-id');
        const valueElements = Array.from(document.querySelectorAll('.clan-bosslap-value'));
        const inputElements = Array.from(document.querySelectorAll('.clan-bosslap-input'));

        const source = sourceInput ? String(sourceInput.value || '').trim() : '';
        const clanId = clanIdInput ? String(clanIdInput.value || '').trim() : '';

        if (!editButton || !saveButton || !cancelButton || valueElements.length !== 5 || inputElements.length !== 5 || !source || !/^\d+$/.test(clanId)) {
            return;
        }

        const originalValues = inputElements.map((input) => Number(input.value));
        let isEditing = false;

        const setStatus = (message, type) => {
            if (!status) {
                return;
            }
            status.textContent = message;
            status.classList.remove('success', 'error');
            if (type) {
                status.classList.add(type);
            }
        };

        const setEditingState = (editing) => {
            isEditing = editing;
            editButton.style.display = editing ? 'none' : '';
            saveButton.style.display = editing ? '' : 'none';
            cancelButton.style.display = editing ? '' : 'none';

            valueElements.forEach((element) => {
                element.style.display = editing ? 'none' : '';
            });
            inputElements.forEach((element) => {
                element.style.display = editing ? 'block' : 'none';
            });
        };

        editButton.addEventListener('click', () => {
            setStatus('', '');
            setEditingState(true);
        });

        cancelButton.addEventListener('click', () => {
            inputElements.forEach((input, index) => {
                input.value = String(originalValues[index]);
            });
            setStatus('変更を破棄しました。', 'success');
            setEditingState(false);
        });

        saveButton.addEventListener('click', async () => {
            if (!isEditing) {
                return;
            }

            const nextValues = [];
            for (const input of inputElements) {
                const numeric = Number(input.value);
                if (!Number.isFinite(numeric) || numeric < 1 || !Number.isInteger(numeric)) {
                    setStatus('1以上の整数を入力してください。', 'error');
                    return;
                }
                nextValues.push(numeric);
            }

            const minValue = Math.min(...nextValues);
            const maxValue = Math.max(...nextValues);
            if ((maxValue - minValue) >= 3) {
                setStatus('最大値と最小値の差は2以下にしてください。', 'error');
                return;
            }

            saveButton.disabled = true;
            cancelButton.disabled = true;
            setStatus('保存中です...', '');

            try {
                const response = await fetch('/api/clan/bosslaps/save', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        source,
                        clanid: clanId,
                        bosslaps: nextValues
                    })
                });

                if (!response.ok) {
                    let serverMessage = 'Failed to save clan bosslaps';
                    try {
                        const errorPayload = await response.json();
                        if (errorPayload && typeof errorPayload.error === 'string' && errorPayload.error.trim().length > 0) {
                            serverMessage = errorPayload.error.trim();
                        }
                    } catch (parseError) {
                        // noop
                    }
                    throw new Error(serverMessage);
                }

                window.location.reload();
            } catch (error) {
                console.error('ボスカウントの保存に失敗しました:', error);
                setStatus('保存に失敗しました。時間をおいて再試行してください。', 'error');
            } finally {
                saveButton.disabled = false;
                cancelButton.disabled = false;
            }
        });
    }
</script>

<script type="module">
    import { createClient } from 'https://esm.sh/@supabase/supabase-js@2';

    function initializeClanRealtimeSubscription() {
        const sourceInput = document.getElementById('clan-source');
        const clanIdInput = document.getElementById('clan-id');
        const source = sourceInput ? String(sourceInput.value || '').trim() : '';
        const clanId = clanIdInput ? String(clanIdInput.value || '').trim() : '';

        if (!source || !/^\d+$/.test(clanId) || !window.__SUPABASE_PUBLIC_CONFIG__) {
            console.warn('Supabase Realtime を開始できません: source/clanId/config が不足しています。');
            return;
        }

        const config = window.__SUPABASE_PUBLIC_CONFIG__ || {};
        const supabaseUrl = typeof config.url === 'string' ? config.url.trim() : '';
        const publishableKey = typeof config.publishableKey === 'string' ? config.publishableKey.trim() : '';
        if (!supabaseUrl || !publishableKey) {
            console.warn('Supabase Realtime を開始できません: SUPABASE_URL または SUPABASE_PUBLISHABLE_KEY が不足しています。');
            return;
        }

        try {
            const client = createClient(supabaseUrl, publishableKey);
            const channel = client
                .channel(`clan-realtime-${source}-${clanId}`)
                .on('postgres_changes', {
                    event: '*',
                    schema: 'public',
                    table: 'clans'
                }, (payload) => {
                    console.log('Supabase Realtime clans change payload:', payload);
                    const next = payload && payload.new ? payload.new : null;
                    const nextSource = next && typeof next.source === 'string' ? next.source.trim() : '';
                    const nextClanId = next && next.clanid !== undefined && next.clanid !== null ? String(next.clanid).trim() : '';

                    if (nextSource === source && nextClanId === clanId) {
                        window.location.reload();
                    }
                })
                .subscribe((status, error) => {
                    console.log('Supabase Realtime subscription status:', status, error || '');
                });

            window.addEventListener('beforeunload', () => {
                client.removeChannel(channel);
            });
        } catch (error) {
            console.error('Supabase Realtime の購読開始に失敗しました:', error);
        }
    }

    initializeClanRealtimeSubscription();
</script>
