<div class="page-content">
    <form class="chara-upload-toolbar" action="/chara-check/refresh-cache" method="post">
        <button type="submit" class="btn">キャッシュ再読込</button>
        <span class="chara-upload-note">Supabase で直接編集したときに押してください</span>
    </form>

    <% if (flash) { %>
        <p class="chara-upload-flash <%= flash.type === 'success' ? 'is-success' : 'is-error' %>"><%= flash.message %></p>
    <% } %>
    <% if (loadError) { %>
        <p class="chara-upload-flash is-error"><%= loadError %></p>
    <% } %>

    <h2>キャラ確認</h2>
    <p>登録済みキャラを名前と画像で確認できます。（<%= characters.length %>件）</p>

    <div class="card">
        <h3>新規登録</h3>
        <form class="chara-register-form" action="/chara-check/add" method="post" enctype="multipart/form-data">
            <input type="text" id="chara-new-name" name="characterName" class="chara-add-input" placeholder="キャラ名（正式名）" required>
            <input type="file" name="charaPng" accept=".png,image/png">
            <button type="submit" class="btn btn-primary chara-add-button">登録</button>
        </form>
        <img class="chara-image-preview" alt="選択した画像" hidden>
        <p class="chara-upload-note">画像は 5MB 以下の .png です。後から登録することもできます。</p>
    </div>

    <% if (unregisteredNames.length > 0) { %>
        <div class="card">
            <h3>掲示板にある未登録の名前</h3>
            <p>今月の掲示板の編成に出てくる、未登録のキャラ名です。（<%= unregisteredNames.length %>件）</p>
            <ul class="chara-unregistered-list">
                <% unregisteredNames.forEach((item) => { %>
                    <li class="chara-unregistered-item">
                        <span class="chara-unregistered-name"><%= item.name %></span>
                        <span class="chara-upload-note"><%= item.count %>件</span>
                        <button type="button" class="btn chara-add-button chara-register-prefill" data-name="<%= item.name %>">登録</button>
                    </li>
                <% }) %>
            </ul>
        </div>
    <% } %>

    <% if (characters.length === 0) { %>
        <div class="card">
            <p>キャラデータが見つかりませんでした。</p>
        </div>
    <% } else { %>
        <div class="chara-filter-bar">
            <input type="search" id="chara-filter-input" class="chara-add-input" placeholder="キャラ名で絞り込み（ひらがな可）" autocomplete="off">
            <label class="chara-filter-option">
                <input type="checkbox" id="chara-filter-missing"> 画像なしのみ
            </label>
            <span id="chara-filter-count" class="chara-upload-note"></span>
        </div>
        <p id="chara-filter-empty" class="chara-upload-note" hidden>該当するキャラがいません。</p>
        <div class="chara-grid">
            <% characters.forEach((character) => { %>
                <div class="chara-card" data-name="<%= character.name %>" data-has-image="<%= character.imageUrl ? 'true' : 'false' %>">
                    <% if (character.imageUrl) { %>
                        <img src="<%= character.imageUrl %>" alt="<%= character.name %>" class="chara-image" loading="lazy">
                    <% } else { %>
                        <div class="chara-image chara-image-missing">NO IMAGE</div>
                    <% } %>
                    <p class="chara-name"><%= character.name %></p>
                    <button type="button" class="btn chara-edit-toggle">編集</button>
                    <div class="chara-edit-panel" hidden>
                        <form class="chara-edit-form" action="/chara-check/rename" method="post">
                            <input type="hidden" name="oldName" value="<%= character.name %>">
                            <input type="text" name="characterName" class="chara-add-input" value="<%= character.name %>" required>
                            <button type="submit" class="btn btn-primary chara-add-button">変更</button>
                        </form>
                        <form class="chara-edit-form" action="/chara-check/image" method="post" enctype="multipart/form-data">
                            <input type="hidden" name="characterName" value="<%= character.name %>">
                            <input type="file" name="charaPng" class="chara-image-input" accept=".png,image/png" required>
                            <button type="submit" class="btn chara-add-button">画像</button>
                        </form>
                        <img class="chara-image-preview" alt="選択した画像" hidden>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } %>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const newNameInput = document.getElementById('chara-new-name');

        document.querySelectorAll('.chara-register-prefill').forEach((button) => {
            button.addEventListener('click', () => {
                if (!(newNameInput instanceof HTMLInputElement) || !(button instanceof HTMLElement)) {
                    return;
                }
                newNameInput.value = button.dataset.name || '';
                newNameInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
                newNameInput.focus();
            });
        });

        const filterInput = document.getElementById('chara-filter-input');
        const filterMissing = document.getElementById('chara-filter-missing');
        const filterCount = document.getElementById('chara-filter-count');
        const filterEmpty = document.getElementById('chara-filter-empty');
        const charaCards = Array.from(document.querySelectorAll('.chara-grid .chara-card'));

        const normalizeForSearch = (value) => String(value || '')
            .normalize('NFKC')
            .toLowerCase()
            .replace(/[\u30a1-\u30f6]/g, (ch) => String.fromCharCode(ch.charCodeAt(0) - 0x60))
            .replace(/\s+/g, '');

        charaCards.forEach((card) => {
            if (card instanceof HTMLElement) {
                card.dataset.searchKey = normalizeForSearch(card.dataset.name);
            }
        });

        const applyCharaFilter = () => {
            if (!(filterInput instanceof HTMLInputElement) || !(filterMissing instanceof HTMLInputElement)) {
                return;
            }
            const query = normalizeForSearch(filterInput.value);
            const missingOnly = filterMissing.checked;
            let visibleCount = 0;
            charaCards.forEach((card) => {
                if (!(card instanceof HTMLElement)) {
                    return;
                }
                const matches = (!query || (card.dataset.searchKey || '').includes(query))
                    && (!missingOnly || card.dataset.hasImage !== 'true');
                card.hidden = !matches;
                if (matches) {
                    visibleCount += 1;
                }
            });
            if (filterCount) {
                filterCount.textContent = `${visibleCount} / ${charaCards.length}件`;
            }
            if (filterEmpty) {
                filterEmpty.hidden = visibleCount > 0;
            }
        };

        if (filterInput && filterMissing) {
            filterInput.addEventListener('input', applyCharaFilter);
            filterMissing.addEventListener('change', applyCharaFilter);
            applyCharaFilter();
        }

        document.addEventListener('keydown', (event) => {
            if (event.key !== '/' || event.ctrlKey || event.metaKey || event.altKey) {
                return;
            }
            const target = event.target;
            if (target instanceof HTMLElement && (target.isContentEditable || ['INPUT', 'TEXTAREA', 'SELECT'].includes(target.tagName))) {
                return;
            }
            if (filterInput instanceof HTMLInputElement) {
                event.preventDefault();
                filterInput.focus();
                filterInput.select();
            }
        });

        document.querySelectorAll('input[type="file"][name="charaPng"]').forEach((fileInput) => {
            if (!(fileInput instanceof HTMLInputElement)) {
                return;
            }
            const form = fileInput.closest('form');
            const preview = form ? form.nextElementSibling : null;
            if (!(preview instanceof HTMLImageElement) || !preview.classList.contains('chara-image-preview')) {
                return;
            }

            fileInput.addEventListener('change', () => {
                if (preview.src) {
                    URL.revokeObjectURL(preview.src);
                    preview.removeAttribute('src');
                }
                const file = fileInput.files && fileInput.files[0];
                if (!file) {
                    preview.hidden = true;
                    return;
                }
                preview.src = URL.createObjectURL(file);
                preview.hidden = false;
            });
        });

        document.querySelectorAll('.chara-edit-toggle').forEach((toggleButton) => {
            if (!(toggleButton instanceof HTMLButtonElement)) {
                return;
            }

            toggleButton.addEventListener('click', () => {
                const card = toggleButton.closest('.chara-card');
                const panel = card ? card.querySelector('.chara-edit-panel') : null;
                if (!(panel instanceof HTMLElement)) {
                    return;
                }

                const isHidden = panel.hidden;
                panel.hidden = !isHidden;
                toggleButton.textContent = isHidden ? '閉じる' : '編集';

                if (isHidden) {
                    const input = panel.querySelector('input[name="characterName"][type="text"]');
                    if (input instanceof HTMLInputElement) {
                        input.focus();
                        input.select();
                    }
                }
            });
        });
    });
</script>
