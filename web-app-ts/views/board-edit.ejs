<div class="page-content">
    <% if (isLoggedIn) { %>
    <textarea id="board-original-article-json" hidden><%- JSON.stringify(article || {}) %></textarea>
    <input id="board-current-id" type="hidden" value="<%= typeof id !== 'undefined' ? id : '' %>" />
    <% if (!(ubRows && ubRows.length > 0)) { %>
    <div class="board-edit-toolbar">
        <button type="button" id="board-save-button" class="btn btn-primary">保存</button>
        <button type="button" id="board-discard-button" class="btn">破棄</button>
    </div>
    <% } %>
    <h2>記事編集</h2>
    <div class="board-detail">
        <% 
          const authorValue = article.authorname || article.authorName || article.displayName || article.userName || (isNew ? (userName || '') : '');
          const bossValue = article.bossname || '';
          const damageValue = article.damage || '';
          const battleTimeValue = article.battleTime || '';
          const damageNum = parseInt(article.damage || 0);
          const afterRemoveLast4 = Math.floor(damageNum / 10000);
          const oku = Math.floor(afterRemoveLast4 / 10000);
          const man = afterRemoveLast4 % 10000;
          let damageFormatted = '';
          if (oku > 0) damageFormatted += oku + '億';
          if (man > 0) damageFormatted += man + '万';
          const defaultTitle = [article.bossname || '', damageFormatted].filter(Boolean).join(' ').trim();
        %>
        <section class="post-info-editor" aria-label="投稿情報">
            <h3>投稿情報</h3>

            <div class="post-info-row post-info-row-static post-info-row-inline">
                <div class="post-info-inline-group">
                    <div class="post-info-pill" role="group" aria-label="投稿者名">
                        <span class="post-info-pill-key">投稿者名</span>
                        <span class="post-info-pill-value"><%= authorValue %></span>
                    </div>
                    <div class="post-info-pill" role="group" aria-label="ボス名">
                        <span class="post-info-pill-key">ボス名</span>
                        <span class="post-info-pill-value"><%= bossValue %></span>
                    </div>
                    <div class="post-info-pill" role="group" aria-label="ダメージ">
                        <span class="post-info-pill-key">ダメージ</span>
                        <span class="post-info-pill-value"><%= damageValue %></span>
                    </div>
                    <div class="post-info-pill" role="group" aria-label="バトル時間">
                        <span class="post-info-pill-key">バトル時間</span>
                        <span class="post-info-pill-value"><%= battleTimeValue %></span>
                    </div>
                </div>
            </div>

            <div class="post-info-row">
                <label for="post-title-input">タイトル</label>
                <input id="post-title-input" type="text" class="post-info-input" value="<%= defaultTitle %>" aria-label="タイトル" />
            </div>

            <div class="post-info-row">
                <label for="post-comment-input">コメント</label>
                <textarea id="post-comment-input" class="post-info-textarea" rows="3" aria-label="コメント"></textarea>
            </div>

            <div class="post-info-row post-info-row-difficulty">
                <label>難易度</label>
                <div class="post-info-toggle-wrap post-info-toggle-wrap-difficulty">
                    <input type="hidden" id="post-difficulty-value" value="easy" />
                    <div class="post-toggle-group" data-group="difficulty" role="group" aria-label="難易度">
                        <button type="button" class="post-toggle-btn" data-value="full-auto">フルオート</button>
                        <button type="button" class="post-toggle-btn" data-value="semi-auto">セミオート</button>
                        <button type="button" class="post-toggle-btn is-active" data-value="easy">簡単</button>
                        <button type="button" class="post-toggle-btn" data-value="normal">普通</button>
                        <button type="button" class="post-toggle-btn" data-value="hard">高難度</button>
                    </div>
                    <p class="post-difficulty-help-text">目押しする回数が2回以下で、猶予が長め</p>
                </div>
            </div>

            <div class="post-info-row">
                <label>公開範囲</label>
                <div class="post-info-toggle-wrap">
                    <input type="hidden" id="post-visibility-value" value="self" />
                    <div class="post-toggle-group" data-group="visibility" role="group" aria-label="公開範囲">
                        <button type="button" class="post-toggle-btn" data-value="all">全体</button>
                        <button type="button" class="post-toggle-btn" data-value="clan">クラン</button>
                        <button type="button" class="post-toggle-btn is-active" data-value="self">自分</button>
                    </div>
                </div>
            </div>

            <div class="post-info-row">
                <label>種別</label>
                <div class="post-info-toggle-wrap">
                    <input type="hidden" id="post-mode-value" value="full" />
                    <div class="post-toggle-group" data-group="mode" role="group" aria-label="種別">
                        <button type="button" class="post-toggle-btn is-active" data-value="full">フル</button>
                        <button type="button" class="post-toggle-btn" data-value="agro">持ち越し</button>
                        <button type="button" class="post-toggle-btn" data-value="rank2">2段階目</button>
                        <button type="button" class="post-toggle-btn" data-value="rank3">3段階目</button>
                    </div>
                </div>
            </div>
        </section>

        <h3>ユニオンバースト発動時間</h3>
        <% if (ubRows && ubRows.length > 0) { %>
            <% const partySlots = (partyMembers && partyMembers.length > 0) ? partyMembers.slice().reverse() : []; %>
            <div class="ub-toolbar">
                <div class="ub-toolbar-main">
                    <div class="ub-display-toggle" role="group" aria-label="表示切り替え">
                        <button type="button" class="ub-display-toggle-btn is-active" data-display-mode="all">すべて</button>
                        <button type="button" class="ub-display-toggle-btn" data-display-mode="operation">操作</button>
                        <button type="button" class="ub-display-toggle-btn" data-display-mode="operation-plus-prev">操作+1つ前</button>
                    </div>
                </div>
                <div class="ub-toolbar-actions">
                    <button type="button" id="board-save-button" class="btn btn-primary">保存</button>
                    <button type="button" id="board-discard-button" class="btn">破棄</button>
                </div>
            </div>
            <div class="ub-table-wrapper">
                <table class="ub-table">
                    <thead>
                        <tr>
                            <th>残り時間</th>
                            <th>UB</th>
                            <% for (let i = 0; i < 5; i += 1) { %>
                                <% const headerSlot = partySlots[i]; %>
                                <th class="ub-header-party-cell">
                                    <% if (headerSlot && headerSlot.imagePath) { %>
                                        <img src="<%= headerSlot.imagePath %>" alt="<%= headerSlot.name %>" title="<%= headerSlot.name %>" class="ub-party-image" />
                                    <% } else if (headerSlot) { %>
                                            <div class="ub-party-image-missing ub-party-image-missing-blue"><%= headerSlot.name %></div>
                                    <% } else { %>
                                        <span class="ub-party-empty">-</span>
                                    <% } %>
                                </th>
                            <% } %>
                            <th class="ub-auto-cell">Auto</th>
                            <th class="ub-actions-cell"></th>
                        </tr>
                    </thead>
                    <tbody>
                        <% ubRows.forEach(function(row) { %>
                            <% const rowActiveIcons = Array.isArray(row.activeIcons) ? row.activeIcons : []; %>
                            <% const hasServerActive = rowActiveIcons.length > 0 || row.autoActive; %>
                            <% const isPartyCharRow = partySlots.some(function(s) { return s && s.name === row.ubText; }); %>
                            <tr class="<%= hasServerActive ? 'ub-row-has-active' : '' %> <%= row.comment ? 'has-comment-row' : '' %>" data-is-battle-start="<%= row.ubText === 'バトル開始' ? 'true' : 'false' %>" data-is-battle-end="<%= row.ubText === 'バトル終了' ? 'true' : 'false' %>" data-is-added-row="<%= row.isAddedRow ? 'true' : 'false' %>" data-active-icons="<%= JSON.stringify(rowActiveIcons) %>" data-auto-active="<%= row.autoActive ? 'true' : 'false' %>" data-comment="<%= encodeURIComponent(row.comment || '') %>" data-ub-text="<%= encodeURIComponent(row.ubText || '') %>" data-ub-is-party-char="<%= isPartyCharRow ? 'true' : 'false' %>" data-timing="<%= row.timing ? 'true' : 'false' %>">
                                <td class="ub-time-cell">
                                    <% if (row.isAddedRow) { %>
                                        <input type="text" class="ub-time-input" aria-label="残り時間" value="<%= row.time || '' %>" />
                                    <% } else { %>
                                        <%= row.time || '' %>
                                    <% } %>
                                </td>
                                <td class="ub-event-cell">
                                    <div class="ub-event-cell-inner">
                                        <% if (row.ubImagePath) { %>
                                            <img src="<%= row.ubImagePath %>" alt="<%= row.ubText %>" title="<%= row.ubText %>" class="ub-event-image" />
                                        <% } else if (row.ubText) { %>
                                            <div class="ub-event-image-missing ub-event-image-missing-blue"><%= row.ubText %></div>
                                        <% } %>
                                        <% if (isPartyCharRow) { %>
                                            <img src="/images/icon_bomb.png" alt="目押し" class="ub-timing-hoshi" />
                                        <% } %>
                                    </div>
                                </td>
                                <% for (let i = 0; i < 5; i += 1) { %>
                                    <% const partySlot = partySlots[i]; %>
                                    <% const isPartyActive = rowActiveIcons.includes(i); %>
                                    <% const isUbChar = isPartyCharRow && partySlot && partySlot.name === row.ubText; %>
                                    <td class="ub-party-cell">
                                        <% if (partySlot && partySlot.imagePath) { %>
                                            <div class="ub-icon-box ub-party-toggleable-char <%= (row.timing && isUbChar) ? 'ub-timing-target' : '' %>" data-icon-type="image" data-party-slot-name="<%= partySlot.name %>">
                                                <img src="<%= partySlot.imagePath %>" alt="<%= partySlot.name %>" title="<%= partySlot.name %>" class="ub-party-image <%= isPartyActive ? '' : 'ub-party-image-mono' %>" />
                                                <span class="ub-set-badge">SET!</span>
                                                    <% if (isUbChar) { %>
                                                        <img src="/images/icon_bomb.png" alt="目押し" class="ub-timing-hoshi" />
                                                    <% } %>
                                            </div>
                                        <% } else if (partySlot) { %>
                                            <div class="ub-icon-box ub-party-toggleable-char <%= (row.timing && isUbChar) ? 'ub-timing-target' : '' %>" data-icon-type="placeholder" data-party-slot-name="<%= partySlot.name %>">
                                                <div class="ub-party-image-missing <%= isPartyActive ? 'ub-party-image-missing-blue' : 'ub-party-image-missing-gray' %>"><%= partySlot.name %></div>
                                                <span class="ub-set-badge">SET!</span>
                                                <% if (isUbChar) { %>
                                                    <img src="/images/icon_bomb.png" alt="目押し" class="ub-timing-hoshi" />
                                                <% } %>
                                            </div>
                                        <% } else { %>
                                            <div class="ub-icon-box ub-party-toggleable-char" data-icon-type="placeholder">
                                                <div class="ub-party-image-missing ub-party-image-missing-gray"></div>
                                                <span class="ub-set-badge">SET!</span>
                                            </div>
                                        <% } %>
                                    </td>
                                <% } %>
                                <td class="ub-auto-cell">
                                    <div class="ub-icon-box ub-auto-icon-box ub-party-toggleable-char" data-icon-type="auto">
                                        <div class="ub-auto-btn <%= row.autoActive ? 'ub-auto-btn-active' : 'ub-auto-btn-inactive' %>">
                                            <span class="ub-auto-label">OFF</span>
                                        </div>
                                    </div>
                                </td>
                                <td class="ub-actions-cell">
                                    <div class="ub-actions-buttons">
                                        <button type="button" class="ub-action-btn ub-action-btn-comment <%= row.comment ? 'is-disabled' : '' %>" title="コメントを追加" aria-label="コメントを追加" <%= row.comment ? 'disabled' : '' %>>
                                            <img src="/images/icon_comment.png" alt="コメントを追加" class="ub-action-btn-image" />
                                        </button>
                                        <button type="button" class="ub-action-btn ub-action-btn-add-line" title="下に行を追加" aria-label="下に行を追加">
                                            <img src="/images/icon_add_line.png" alt="下に行を追加" class="ub-action-btn-image" />
                                        </button>
                                        <% if (row.isAddedRow) { %>
                                            <button type="button" class="ub-action-btn ub-action-btn-delete-row" title="行を削除" aria-label="行を削除">
                                                <img src="/images/icon_trash.png" alt="行を削除" class="ub-action-btn-image" />
                                            </button>
                                        <% } %>
                                        <% if (isPartyCharRow) { %>
                                            <button type="button" class="ub-action-btn ub-action-btn-timing <%= row.timing ? 'is-timing-active' : '' %>" title="目押し設定" aria-label="目押し設定">
                                                <img src="/images/icon_hit.png" alt="目押し" class="ub-action-btn-image" />
                                            </button>
                                        <% } %>
                                    </div>
                                </td>
                            </tr>
                            <% if (row.comment) { %>
                                <tr class="ub-comment-row">
                                    <td class="ub-comment-prefix-cell"></td>
                                    <td class="ub-comment-cell" colspan="8">
                                        <div class="ub-comment-content">
                                            <textarea class="ub-comment-input" rows="1" placeholder="コメントを入力" aria-label="コメントを入力"><%= row.comment %></textarea>
                                            <button type="button" class="ub-comment-delete-btn" aria-label="コメントを削除">削除</button>
                                        </div>
                                    </td>
                                </tr>
                            <% } %>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <p>未登録</p>
        <% } %>

    </div>
    <% } else { %>
    <h2>記事編集</h2>
    <p>Googleでログイン後に編集可能になります</p>
    <p>
        <a href="/board" class="btn">一覧へ戻る</a>
    </p>
    <% } %>
</div>

<% if (isLoggedIn) { %>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const originalArticleRaw = document.getElementById('board-original-article-json');
        const currentIdInput = document.getElementById('board-current-id');
        let originalArticle = {};
        try {
            originalArticle = JSON.parse(originalArticleRaw ? originalArticleRaw.value || '{}' : '{}');
        } catch {
            originalArticle = {};
        }
        const currentId = currentIdInput instanceof HTMLInputElement ? currentIdInput.value : '';
        const PARTY_COLUMN_COUNT = 5;
        const COMMENT_COLSPAN = 8;
        const DISPLAY_MODE_ALL = 'all';
        const DISPLAY_MODE_OPERATION = 'operation';
        const DISPLAY_MODE_OPERATION_PLUS_PREV = 'operation-plus-prev';
        const DIFFICULTY_HELP_TEXT = {
            'full-auto': 'バトル開始時にセットし、最後まで切り替えない',
            'semi-auto': 'UB演出中、または猶予1秒以上ある切り替えのみ',
            easy: '目押しする回数が2回以下で、猶予が長め',
            normal: '目押しする回数が3回以上',
            hard: '目押しの猶予が短く、失敗が多い',
        };
        const DIFFICULTY_VALUE_TO_LEVEL = {
            'full-auto': 1,
            'semi-auto': 2,
            easy: 3,
            normal: 4,
            hard: 5,
        };
        const DIFFICULTY_LEVEL_TO_VALUE = {
            1: 'full-auto',
            2: 'semi-auto',
            3: 'easy',
            4: 'normal',
            5: 'hard',
        };
        let currentDisplayMode = DISPLAY_MODE_ALL;

        function setActiveToggle(groupName, value) {
            const group = document.querySelector(`.post-toggle-group[data-group="${groupName}"]`);
            if (!group) {
                return;
            }

            const buttons = Array.from(group.querySelectorAll('.post-toggle-btn'));
            const target = buttons.find((button) => button.dataset.value === value) || buttons[0];
            if (!target) {
                return;
            }

            buttons.forEach((button) => {
                button.classList.toggle('is-active', button === target);
            });

            const hiddenInput = document.getElementById(`post-${groupName}-value`);
            if (hiddenInput instanceof HTMLInputElement) {
                hiddenInput.value = target.dataset.value || '';
            }

            if (groupName === 'difficulty') {
                const helpText = document.querySelector('.post-difficulty-help-text');
                if (helpText) {
                    helpText.textContent = DIFFICULTY_HELP_TEXT[target.dataset.value || 'easy'] || DIFFICULTY_HELP_TEXT.easy;
                }
            }
        }

        function getDecodedUbText(row) {
            const raw = row.dataset.ubText || '';
            if (!raw) {
                return '';
            }

            try {
                return decodeURIComponent(raw);
            } catch {
                return raw;
            }
        }

        function getUbEventLabel(row) {
            const eventCell = row.querySelector('.ub-event-cell');
            if (!eventCell) {
                return getDecodedUbText(row);
            }
            const img = eventCell.querySelector('img');
            if (img) {
                return getDecodedUbText(row) || (img.getAttribute('alt') || '').trim();
            }
            return getDecodedUbText(row) || (eventCell.textContent || '').trim();
        }

        function getActiveIconIndexes(row) {
            const indexes = [];
            const partyIcons = row.querySelectorAll('.ub-party-cell .ub-icon-box');
            partyIcons.forEach((iconBox, index) => {
                if (isIconActive(iconBox)) {
                    indexes.push(index);
                }
            });
            return indexes;
        }

        function buildUbTimelinePayload() {
            return getMainRows().map((row) => {
                const commentRow = getCommentRowFor(row);
                const commentInput = commentRow ? commentRow.querySelector('.ub-comment-input') : null;
                const autoBox = row.querySelector('.ub-auto-cell .ub-icon-box');
                return {
                    time: getRowTimeText(row),
                    character: getDecodedUbText(row) || getUbEventLabel(row),
                    activeIcons: getActiveIconIndexes(row),
                    autoActive: autoBox ? isIconActive(autoBox) : false,
                    comment: commentInput instanceof HTMLTextAreaElement ? commentInput.value : '',
                    isAddedRow: row.dataset.isAddedRow === 'true',
                    timing: row.dataset.timing === 'true',
                };
            });
        }

        function createMergedTimelineInfo() {
            const base = JSON.parse(JSON.stringify(originalArticle || {}));
            const titleInput = document.getElementById('post-title-input');
            const commentInput = document.getElementById('post-comment-input');
            const difficultyInput = document.getElementById('post-difficulty-value');
            const visibilityInput = document.getElementById('post-visibility-value');
            const modeInput = document.getElementById('post-mode-value');

            if (titleInput instanceof HTMLInputElement) {
                base.postTitle = titleInput.value;
            }
            if (commentInput instanceof HTMLTextAreaElement) {
                base.postComment = commentInput.value;
            }
            if (difficultyInput instanceof HTMLInputElement) {
                const mapped = DIFFICULTY_VALUE_TO_LEVEL[difficultyInput.value] || 3;
                base.difficulty = mapped;
            }
            if (visibilityInput instanceof HTMLInputElement) {
                base.visibility = visibilityInput.value || 'self';
            }
            if (modeInput instanceof HTMLInputElement) {
                base.mode = modeInput.value || 'full';
            }

            base.ubTimeline = buildUbTimelinePayload();
            return base;
        }

        function submitSave() {
            const timelineInfo = createMergedTimelineInfo();
            const form = document.createElement('form');
            form.method = 'post';
            form.action = '/board/save';

            const timelineInput = document.createElement('input');
            timelineInput.type = 'hidden';
            timelineInput.name = 'timelineInfo';
            timelineInput.value = JSON.stringify(timelineInfo);
            form.appendChild(timelineInput);

            const idInput = document.createElement('input');
            idInput.type = 'hidden';
            idInput.name = 'id';
            idInput.value = currentId || (originalArticle && originalArticle.uniqueId) || '';
            form.appendChild(idInput);

            document.body.appendChild(form);
            form.submit();
        }

        function getArticleDetailUrl() {
            const articleId = currentId || (typeof originalArticle.uniqueId === 'string' ? originalArticle.uniqueId : '');
            return articleId ? `/board/${articleId}` : '/board';
        }

        function submitDiscard() {
            window.location.href = getArticleDetailUrl();
        }

        function initializePostInfoFromArticle() {
            const titleInput = document.getElementById('post-title-input');
            const commentInput = document.getElementById('post-comment-input');
            if (titleInput instanceof HTMLInputElement && typeof originalArticle.postTitle === 'string') {
                titleInput.value = originalArticle.postTitle;
            }
            if (commentInput instanceof HTMLTextAreaElement && typeof originalArticle.postComment === 'string') {
                commentInput.value = originalArticle.postComment;
            }

            const difficultyValue = DIFFICULTY_LEVEL_TO_VALUE[Number(originalArticle.difficulty)] || 'easy';
            setActiveToggle('difficulty', difficultyValue);

            const visibilityValue = typeof originalArticle.visibility === 'string' ? originalArticle.visibility : 'self';
            setActiveToggle('visibility', visibilityValue);

            const modeValue = typeof originalArticle.mode === 'string' ? originalArticle.mode : 'full';
            setActiveToggle('mode', modeValue);
        }

        function setupPostInfoToggles() {
            const updateDifficultyHelp = (value) => {
                const helpText = document.querySelector('.post-difficulty-help-text');
                if (!helpText) {
                    return;
                }
                helpText.textContent = DIFFICULTY_HELP_TEXT[value] || DIFFICULTY_HELP_TEXT.easy;
            };

            document.querySelectorAll('.post-toggle-group').forEach((group) => {
                const groupName = group.dataset.group;
                const buttons = Array.from(group.querySelectorAll('.post-toggle-btn'));
                if (buttons.length === 0) {
                    return;
                }

                const hiddenInput = groupName
                    ? document.getElementById(`post-${groupName}-value`)
                    : null;

                buttons.forEach((button) => {
                    button.addEventListener('click', () => {
                        buttons.forEach((item) => {
                            item.classList.toggle('is-active', item === button);
                        });

                        if (hiddenInput instanceof HTMLInputElement) {
                            hiddenInput.value = button.dataset.value || '';
                        }

                        if (groupName === 'difficulty') {
                            updateDifficultyHelp(button.dataset.value || 'easy');
                        }
                    });
                });

                const activeButton = group.querySelector('.post-toggle-btn.is-active');
                if (activeButton && hiddenInput instanceof HTMLInputElement) {
                    hiddenInput.value = activeButton.dataset.value || '';
                }

                if (groupName === 'difficulty') {
                    updateDifficultyHelp((activeButton && activeButton.dataset.value) || 'easy');
                }
            });
        }

        function getMainRows() {
            return Array.from(document.querySelectorAll('.ub-table tbody tr:not(.ub-comment-row)'));
        }

        function ensureRowIds() {
            getMainRows().forEach((row, index) => {
                row.dataset.ubRowId = String(index + 1);
                const nextRow = row.nextElementSibling;
                if (nextRow instanceof HTMLTableRowElement && nextRow.classList.contains('ub-comment-row')) {
                    nextRow.dataset.parentRowId = row.dataset.ubRowId;
                }
            });
        }

        function getCommentRowFor(mainRow) {
            const rowId = mainRow.dataset.ubRowId;
            if (!rowId) {
                return null;
            }
            return document.querySelector(`.ub-comment-row[data-parent-row-id="${rowId}"]`);
        }

        function setCommentButtonState(mainRow, disabled) {
            const commentButton = mainRow.querySelector('.ub-action-btn-comment');
            if (!commentButton) {
                return;
            }
            commentButton.disabled = disabled;
            commentButton.classList.toggle('is-disabled', disabled);
        }

        function createCommentRow(mainRow) {
            const rowId = mainRow.dataset.ubRowId;
            if (!rowId) {
                return null;
            }

            const commentRow = document.createElement('tr');
            commentRow.className = 'ub-comment-row';
            commentRow.dataset.parentRowId = rowId;

            const prefixCell = document.createElement('td');
            prefixCell.className = 'ub-comment-prefix-cell';

            const mergedCell = document.createElement('td');
            mergedCell.className = 'ub-comment-cell';
            mergedCell.colSpan = COMMENT_COLSPAN;
            mergedCell.innerHTML = `
                <div class="ub-comment-content">
                    <textarea class="ub-comment-input" rows="1" placeholder="コメントを入力" aria-label="コメントを入力"></textarea>
                    <button type="button" class="ub-comment-delete-btn" aria-label="コメントを削除">削除</button>
                </div>
            `;

            commentRow.append(prefixCell, mergedCell);
            return commentRow;
        }

        function resizeCommentInput(commentInput) {
            if (!(commentInput instanceof HTMLTextAreaElement)) {
                return;
            }
            commentInput.style.height = 'auto';
            commentInput.style.height = `${commentInput.scrollHeight}px`;
        }

        function bindCommentInputAutoResize(commentInput) {
            if (!(commentInput instanceof HTMLTextAreaElement)) {
                return;
            }

            resizeCommentInput(commentInput);

            commentInput.addEventListener('input', () => {
                resizeCommentInput(commentInput);
            });

            commentInput.addEventListener('keydown', (event) => {
                if (event.key === 'Enter') {
                    requestAnimationFrame(() => resizeCommentInput(commentInput));
                }
            });

            commentInput.addEventListener('paste', () => {
                requestAnimationFrame(() => resizeCommentInput(commentInput));
            });
        }

        function getRowTimeText(row) {
            const timeInput = row.querySelector('.ub-time-input');
            if (timeInput instanceof HTMLInputElement) {
                return timeInput.value;
            }
            const timeCell = row.querySelector('.ub-time-cell');
            return timeCell ? timeCell.textContent.trim() : '';
        }

        function parseTimeToSeconds(timeText) {
            const raw = (timeText || '').trim();
            if (!raw) {
                return null;
            }

            const normalizedWithColon = raw.match(/^(\d{1,2}):(\d{1,2})$/);
            if (normalizedWithColon) {
                const minutes = Number(normalizedWithColon[1]);
                const seconds = Number(normalizedWithColon[2]);
                if (Number.isNaN(minutes) || Number.isNaN(seconds) || seconds >= 60) {
                    return null;
                }
                return (minutes * 60) + seconds;
            }

            const normalizedDigits = raw.match(/^\d{1,4}$/);
            if (!normalizedDigits) {
                return null;
            }

            const padded = raw.padStart(4, '0');
            const minutes = Number(padded.slice(0, 2));
            const seconds = Number(padded.slice(2));
            if (Number.isNaN(minutes) || Number.isNaN(seconds) || seconds >= 60) {
                return null;
            }
            return (minutes * 60) + seconds;
        }

        function formatSecondsToTime(totalSeconds) {
            const minutes = Math.floor(totalSeconds / 60);
            const seconds = totalSeconds % 60;
            return `${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
        }

        function getAdjacentMainRows(currentRow) {
            const rows = getMainRows();
            const index = rows.indexOf(currentRow);
            if (index < 0) {
                return { previousRow: null, nextRow: null };
            }
            return {
                previousRow: index > 0 ? rows[index - 1] : null,
                nextRow: index < rows.length - 1 ? rows[index + 1] : null,
            };
        }

        function validateTimeBetweenAdjacentRows(currentRow, currentSeconds) {
            const { previousRow, nextRow } = getAdjacentMainRows(currentRow);
            const previousSeconds = previousRow ? parseTimeToSeconds(getRowTimeText(previousRow)) : null;
            const nextSeconds = nextRow ? parseTimeToSeconds(getRowTimeText(nextRow)) : null;

            if (previousSeconds === null || nextSeconds === null) {
                return true;
            }

            const minValue = Math.min(previousSeconds, nextSeconds);
            const maxValue = Math.max(previousSeconds, nextSeconds);
            return currentSeconds >= minValue && currentSeconds <= maxValue;
        }

        function normalizeAndValidateTimeInput(timeInput) {
            if (!(timeInput instanceof HTMLInputElement)) {
                return;
            }

            const row = timeInput.closest('tr');
            if (!(row instanceof HTMLTableRowElement)) {
                return;
            }

            const rawValue = timeInput.value.trim();
            const parsedSeconds = parseTimeToSeconds(rawValue);
            if (parsedSeconds === null) {
                alert('残り時間は 00:00 形式に変換できる値を入力してください。');
                timeInput.value = timeInput.dataset.lastValidTime || '';
                return;
            }

            const formatted = formatSecondsToTime(parsedSeconds);
            if (!validateTimeBetweenAdjacentRows(row, parsedSeconds)) {
                alert('残り時間は前行と後行の間の時刻にしてください。');
                timeInput.value = timeInput.dataset.lastValidTime || '';
                return;
            }

            timeInput.value = formatted;
            timeInput.dataset.lastValidTime = formatted;
        }

        function bindTimeInputValidation(row) {
            const timeInput = row.querySelector('.ub-time-input');
            if (!(timeInput instanceof HTMLInputElement)) {
                return;
            }

            const initialSeconds = parseTimeToSeconds(timeInput.value);
            if (initialSeconds !== null) {
                const formattedInitial = formatSecondsToTime(initialSeconds);
                timeInput.value = formattedInitial;
                timeInput.dataset.lastValidTime = formattedInitial;
            } else {
                timeInput.dataset.lastValidTime = '';
            }

            timeInput.addEventListener('blur', () => {
                normalizeAndValidateTimeInput(timeInput);
            });

            timeInput.addEventListener('keydown', (event) => {
                if (event.key === 'Enter') {
                    event.preventDefault();
                    normalizeAndValidateTimeInput(timeInput);
                    timeInput.blur();
                }
            });
        }

        function createCopiedRow(sourceRow) {
            const copiedRow = sourceRow.cloneNode(true);
            copiedRow.classList.remove('ub-row-has-active', 'has-comment-row');
            copiedRow.dataset.isBattleStart = 'false';
            copiedRow.dataset.isBattleEnd = 'false';
            copiedRow.dataset.isAddedRow = 'true';
            copiedRow.dataset.activeIcons = '[]';
            copiedRow.dataset.autoActive = 'false';
            copiedRow.dataset.comment = '';
            copiedRow.dataset.ubText = '';
            copiedRow.dataset.ubIsPartyChar = 'false';
            copiedRow.dataset.timing = 'false';
            delete copiedRow.dataset.ubRowId;

            const timeCell = copiedRow.querySelector('.ub-time-cell');
            if (timeCell) {
                const copiedTime = getRowTimeText(sourceRow);
                timeCell.innerHTML = '';
                const timeInput = document.createElement('input');
                timeInput.type = 'text';
                timeInput.className = 'ub-time-input';
                timeInput.setAttribute('aria-label', '残り時間');
                timeInput.value = copiedTime;
                timeCell.appendChild(timeInput);
            }

            const eventCell = copiedRow.querySelector('.ub-event-cell');
            if (eventCell) {
                eventCell.innerHTML = '';
            }

            copiedRow.querySelectorAll('.ub-party-toggleable-char').forEach((iconBox) => {
                setIconActive(iconBox, false);
            });

            setCommentButtonState(copiedRow, false);
            ensureAddedRowDeleteButton(copiedRow);

            const timingButton = copiedRow.querySelector('.ub-action-btn-timing');
            if (timingButton) {
                timingButton.remove();
            }

            return copiedRow;
        }

        function ensureAddedRowDeleteButton(row) {
            if (row.dataset.isAddedRow !== 'true') {
                return;
            }

            const actionsButtons = row.querySelector('.ub-actions-buttons');
            if (!actionsButtons) {
                return;
            }

            const existingDeleteButton = actionsButtons.querySelector('.ub-action-btn-delete-row');
            if (existingDeleteButton) {
                return;
            }

            const deleteButton = document.createElement('button');
            deleteButton.type = 'button';
            deleteButton.className = 'ub-action-btn ub-action-btn-delete-row';
            deleteButton.title = '行を削除';
            deleteButton.setAttribute('aria-label', '行を削除');
            deleteButton.innerHTML = '<img src="/images/icon_trash.png" alt="行を削除" class="ub-action-btn-image" />';
            actionsButtons.appendChild(deleteButton);
        }

        function parseActiveIconsFromRow(row) {
            const raw = row.dataset.activeIcons;
            if (!raw) {
                return [];
            }
            try {
                const parsed = JSON.parse(raw);
                if (!Array.isArray(parsed)) {
                    return [];
                }
                return parsed.filter((value) => Number.isInteger(value) && value >= 0 && value < PARTY_COLUMN_COUNT);
            } catch {
                return [];
            }
        }

        function getDecodedRowComment(row) {
            const raw = row.dataset.comment || '';
            if (!raw) {
                return '';
            }
            try {
                return decodeURIComponent(raw);
            } catch {
                return raw;
            }
        }

        function ensureAddedRowEditableTime(row) {
            if (row.dataset.isAddedRow !== 'true') {
                return;
            }

            const timeCell = row.querySelector('.ub-time-cell');
            if (!timeCell || timeCell.querySelector('.ub-time-input')) {
                return;
            }

            const currentTime = getRowTimeText(row);
            timeCell.innerHTML = '';
            const timeInput = document.createElement('input');
            timeInput.type = 'text';
            timeInput.className = 'ub-time-input';
            timeInput.setAttribute('aria-label', '残り時間');
            timeInput.value = currentTime;
            timeCell.appendChild(timeInput);
        }

        function hydrateInitialUbRows() {
            getMainRows().forEach((row) => {
                const activeIndexes = parseActiveIconsFromRow(row);
                const partyIcons = row.querySelectorAll('.ub-party-cell .ub-icon-box');
                partyIcons.forEach((iconBox, index) => {
                    setIconActive(iconBox, activeIndexes.includes(index));
                });

                const autoBox = row.querySelector('.ub-auto-cell .ub-icon-box');
                if (autoBox) {
                    setIconActive(autoBox, row.dataset.autoActive === 'true');
                }

                ensureAddedRowEditableTime(row);
                bindTimeInputValidation(row);

                const commentText = getDecodedRowComment(row);
                if (commentText && !getCommentRowFor(row)) {
                    const commentRow = createCommentRow(row);
                    if (commentRow) {
                        row.insertAdjacentElement('afterend', commentRow);
                        row.classList.add('has-comment-row');
                        setCommentButtonState(row, true);
                        const commentInput = commentRow.querySelector('.ub-comment-input');
                        if (commentInput instanceof HTMLTextAreaElement) {
                            commentInput.value = commentText;
                            bindCommentInputAutoResize(commentInput);

                                        setRowTiming(row, row.dataset.timing === 'true');
                        }
                    }
                }
            });
        }

        function bindIconToggleHandlers(row) {
            row.querySelectorAll('.ub-party-toggleable-char').forEach((iconBox) => {
                iconBox.addEventListener('click', () => {
                    setIconActive(iconBox, !isIconActive(iconBox));
                    updateSetBubbles();
                });
            });
        }

        function bindRowActionHandlers(row) {
            const commentButton = row.querySelector('.ub-action-btn-comment');
            if (commentButton) {
                commentButton.addEventListener('click', () => {
                    if (getCommentRowFor(row)) {
                        return;
                    }

                    const commentRow = createCommentRow(row);
                    if (!commentRow) {
                        return;
                    }

                    const existingCommentRow = getCommentRowFor(row);
                    if (existingCommentRow) {
                        existingCommentRow.insertAdjacentElement('afterend', commentRow);
                    } else {
                        row.insertAdjacentElement('afterend', commentRow);
                    }
                    row.classList.add('has-comment-row');
                    setCommentButtonState(row, true);

                    const commentInput = commentRow.querySelector('.ub-comment-input');
                    bindCommentInputAutoResize(commentInput);
                    applyRowFilter();
                });
            }

            const addLineButton = row.querySelector('.ub-action-btn-add-line');
            if (addLineButton) {
                addLineButton.addEventListener('click', () => {
                    const copiedRow = createCopiedRow(row);
                    const existingCommentRow = getCommentRowFor(row);
                    if (existingCommentRow) {
                        existingCommentRow.insertAdjacentElement('afterend', copiedRow);
                    } else {
                        row.insertAdjacentElement('afterend', copiedRow);
                    }

                    bindIconToggleHandlers(copiedRow);
                    bindRowActionHandlers(copiedRow);
                    ensureRowIds();
                    bindTimeInputValidation(copiedRow);

                    const copiedCommentRow = createCommentRow(copiedRow);
                    if (copiedCommentRow) {
                        copiedRow.insertAdjacentElement('afterend', copiedCommentRow);
                        copiedRow.classList.add('has-comment-row');
                        setCommentButtonState(copiedRow, true);
                        const commentInput = copiedCommentRow.querySelector('.ub-comment-input');
                        bindCommentInputAutoResize(commentInput);
                    }

                    updateSetBubbles();
                    applyRowFilter();
                });
            }

            bindTimingButton(row);
        }

        function setRowTiming(row, active) {
            row.dataset.timing = active ? 'true' : 'false';

            const timingButton = row.querySelector('.ub-action-btn-timing');
            if (timingButton) {
                timingButton.classList.toggle('is-timing-active', active);
            }

            const ubCharName = getDecodedUbText(row) || getUbEventLabel(row);
            const eventHoshi = row.querySelector('.ub-event-cell .ub-timing-hoshi');
            if (eventHoshi) {
                eventHoshi.style.display = active ? 'block' : 'none';
            }

            row.querySelectorAll('.ub-party-cell .ub-icon-box').forEach((iconBox) => {
                const slotName = iconBox.dataset.partySlotName;
                const hoshi = iconBox.querySelector('.ub-timing-hoshi');
                const isTimingTarget = active && slotName && slotName === ubCharName;
                if (hoshi) {
                    hoshi.style.display = isTimingTarget ? 'block' : 'none';
                }
                iconBox.classList.toggle('ub-timing-target', Boolean(isTimingTarget));
            });

            applyRowFilter();
        }

        function bindTimingButton(row) {
            const timingButton = row.querySelector('.ub-action-btn-timing');
            if (!timingButton) {
                return;
            }
            timingButton.addEventListener('click', () => {
                const currentTiming = row.dataset.timing === 'true';
                setRowTiming(row, !currentTiming);
            });
        }

        function isYellowMainRow(row) {
            return row.classList.contains('ub-row-has-active')
                || row.classList.contains('has-comment-row')
                || row.dataset.isAddedRow === 'true'
                || row.dataset.isBattleStart === 'true'
                || row.dataset.isBattleEnd === 'true'
                || row.dataset.timing === 'true';
        }

        function isYellowRow(row) {
            if (row.classList.contains('ub-comment-row')) {
                return true;
            }
            return isYellowMainRow(row);
        }

        function applyRowFilter() {
            const tbody = document.querySelector('.ub-table tbody');
            if (!tbody) {
                return;
            }

            const rows = Array.from(tbody.querySelectorAll('tr'));
            if (currentDisplayMode === DISPLAY_MODE_ALL) {
                rows.forEach((row) => {
                    row.hidden = false;
                });
                return;
            }

            if (currentDisplayMode === DISPLAY_MODE_OPERATION) {
                rows.forEach((row) => {
                    row.hidden = !isYellowRow(row);
                });
                return;
            }

            const visibleRows = new Set();
            rows.forEach((row) => {
                if (!isYellowRow(row)) {
                    return;
                }
                visibleRows.add(row);

                const isBattleStartRow = row.dataset.isBattleStart === 'true';
                const isBattleEndRow = row.dataset.isBattleEnd === 'true';
                if (isBattleStartRow || isBattleEndRow) {
                    return;
                }

                const previousRow = row.previousElementSibling;
                if (previousRow instanceof HTMLTableRowElement) {
                    visibleRows.add(previousRow);
                }
            });

            rows.forEach((row) => {
                row.hidden = !visibleRows.has(row);
            });
        }

        function isIconActive(iconBox) {
            const iconType = iconBox.dataset.iconType;
            if (iconType === 'image') {
                const image = iconBox.querySelector('.ub-party-image');
                return image ? !image.classList.contains('ub-party-image-mono') : false;
            }
            if (iconType === 'auto') {
                const btn = iconBox.querySelector('.ub-auto-btn');
                return btn ? btn.classList.contains('ub-auto-btn-active') : false;
            }
            const placeholder = iconBox.querySelector('.ub-party-image-missing');
            return placeholder ? placeholder.classList.contains('ub-party-image-missing-blue') : false;
        }

        function setIconActive(iconBox, active) {
            const iconType = iconBox.dataset.iconType;
            if (iconType === 'image') {
                const image = iconBox.querySelector('.ub-party-image');
                if (image) {
                    image.classList.toggle('ub-party-image-mono', !active);
                }
                return;
            }
            if (iconType === 'auto') {
                const btn = iconBox.querySelector('.ub-auto-btn');
                if (btn) {
                    btn.classList.toggle('ub-auto-btn-active', active);
                    btn.classList.toggle('ub-auto-btn-inactive', !active);
                }
                return;
            }
            const placeholder = iconBox.querySelector('.ub-party-image-missing');
            if (!placeholder) {
                return;
            }
            placeholder.classList.toggle('ub-party-image-missing-blue', active);
            placeholder.classList.toggle('ub-party-image-missing-gray', !active);
        }

        function computeSet(isActive, previousSet, isBattleStart) {
            if (isBattleStart) return isActive;
            if (isActive) return !previousSet;
            return previousSet;
        }

        function updateSetBubbles() {
            const rows = getMainRows();
            const previousSetByColumn = Array(PARTY_COLUMN_COUNT + 1).fill(false);

            rows.forEach((row) => {
                const isBattleStart = row.dataset.isBattleStart === 'true';
                const iconBoxes = row.querySelectorAll('.ub-party-cell .ub-icon-box');
                let hasActiveIcon = false;

                for (let columnIndex = 0; columnIndex < PARTY_COLUMN_COUNT; columnIndex += 1) {
                    const iconBox = iconBoxes[columnIndex];
                    if (!iconBox) {
                        continue;
                    }
                    const isActive = isIconActive(iconBox);
                    if (isActive) hasActiveIcon = true;
                    const shouldSet = computeSet(isActive, previousSetByColumn[columnIndex], isBattleStart);
                    iconBox.classList.toggle('has-set', shouldSet);
                    iconBox.classList.toggle('set-inactive', shouldSet && !isActive);
                    previousSetByColumn[columnIndex] = shouldSet;
                }

                const autoBox = row.querySelector('.ub-auto-cell .ub-icon-box');
                if (autoBox) {
                    const isAutoActive = isIconActive(autoBox);
                    if (isAutoActive) hasActiveIcon = true;
                    const shouldAutoSet = computeSet(isAutoActive, previousSetByColumn[PARTY_COLUMN_COUNT], isBattleStart);
                    const autoLabel = autoBox.querySelector('.ub-auto-label');
                    if (autoLabel) {
                        autoLabel.textContent = shouldAutoSet ? 'ON' : 'OFF';
                        autoLabel.classList.toggle('ub-auto-label-on', shouldAutoSet);
                    }
                    previousSetByColumn[PARTY_COLUMN_COUNT] = shouldAutoSet;
                }

                row.classList.toggle('ub-row-has-active', hasActiveIcon);
            });

            applyRowFilter();
        }

        getMainRows().forEach((row) => {
            ensureAddedRowDeleteButton(row);
            bindIconToggleHandlers(row);
            bindRowActionHandlers(row);
        });

        ensureRowIds();
        hydrateInitialUbRows();

        const tbody = document.querySelector('.ub-table tbody');
        if (tbody) {
            tbody.addEventListener('click', (event) => {
                const target = event.target;
                if (!(target instanceof HTMLElement)) {
                    return;
                }

                const deleteButton = target.closest('.ub-comment-delete-btn');
                if (deleteButton) {
                    const commentRow = deleteButton.closest('.ub-comment-row');
                    if (!commentRow) {
                        return;
                    }

                    const parentRowId = commentRow.dataset.parentRowId;
                    const mainRow = parentRowId
                        ? document.querySelector(`tr[data-ub-row-id="${parentRowId}"]`)
                        : null;

                    commentRow.remove();

                    if (mainRow instanceof HTMLElement) {
                        mainRow.classList.remove('has-comment-row');
                        setCommentButtonState(mainRow, false);
                    }
                    applyRowFilter();
                    return;
                }

                const deleteRowButton = target.closest('.ub-action-btn-delete-row');
                if (!deleteRowButton) {
                    return;
                }

                const mainRow = deleteRowButton.closest('tr');
                if (!mainRow || mainRow.dataset.isAddedRow !== 'true') {
                    return;
                }

                const commentRow = getCommentRowFor(mainRow);
                if (commentRow) {
                    commentRow.remove();
                }

                mainRow.remove();
                ensureRowIds();
                updateSetBubbles();
                applyRowFilter();
            });
        }

        document.querySelectorAll('.ub-display-toggle-btn').forEach((button) => {
            button.addEventListener('click', () => {
                const mode = button.dataset.displayMode;
                if (!mode) {
                    return;
                }
                currentDisplayMode = mode;
                document.querySelectorAll('.ub-display-toggle-btn').forEach((item) => {
                    item.classList.toggle('is-active', item === button);
                });
                applyRowFilter();
            });
        });

        setupPostInfoToggles();
        initializePostInfoFromArticle();
        const saveButton = document.getElementById('board-save-button');
        if (saveButton) {
            saveButton.addEventListener('click', submitSave);
        }
        const discardButton = document.getElementById('board-discard-button');
        if (discardButton) {
            discardButton.addEventListener('click', submitDiscard);
        }
        updateSetBubbles();
        applyRowFilter();
    });
</script>
<% } %>