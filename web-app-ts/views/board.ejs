<div class="page-content">
    <h2>掲示板</h2>
    <p>クランメンバーとの情報共有スペースです。</p>
    
    <div class="board-header">
        <% if (isLoggedIn) { %>
            <a href="/board/post" class="btn btn-primary">新規投稿</a>
        <% } %>
    </div>
    <div class="board-list">
        <% if (typeof articles !== 'undefined' && articles.length > 0) { %>
            <ul>
                <% articles.forEach(function(article) { %>
                    <li>
                        <a href="/board/<%= article.id %>"><%= article.mode %></a>
                        <span class="author"><%= article.damage %></span>
                        <span class="date"><%= article.battleDate %> <%= article.battleTime %></span>
                    </li>
                <% }); %>
            </ul>
        <% } else { %>
            <div class="no-articles">記事がありません。</div>
        <% } %>
    </div>
</div>
