<div class="page-content">
    <div class="board-page-title-row">
        <h2>掲示板</h2>
        <button id="board-help-toggle" type="button" class="btn board-help-toggle-btn" aria-controls="board-help-panel" aria-expanded="false">使い方</button>
    </div>

    <section id="board-help-panel" class="board-help-panel" hidden>
        <h3>掲示板の使い方</h3>
        <ul>
            <li>タイトルを押すと投稿詳細ページを開けます。TLの確認やエクスポート、差分確認は詳細ページで行います。</li>
            <li>ログイン済みの場合は「新規投稿」から投稿を作成できます。</li>
            <li>一覧は「難易度」「モード」「公開範囲」の3項目で絞り込みできます。各見出しの▽ボタンを押すと候補が開きます。</li>
            <li>フィルタで値を選ぶと、その条件に一致する投稿だけを表示します。解除したい場合は「絞り込みなし」を選択してください。</li>
            <li>複数フィルタは同時に指定できます。たとえば難易度とモードを組み合わせて、目的のTLを素早く探せます。</li>
            <li>表の下にある「絞り込み: ...」には現在の条件が表示されます。条件確認に迷ったらここを見てください。</li>
            <li>ログイン中は、設定で登録したキャラの表示名（ニックネーム）が一覧の編成表示にも反映されます。</li>
        </ul>
    </section>
    
    <div class="board-header">
        <% if (isLoggedIn) { %>
            <a href="/board/post" class="btn btn-primary">新規投稿</a>
        <% } %>
    </div>
    <div class="board-list">
        <% if (typeof articles !== 'undefined' && articles.length > 0) { %>
            <div class="board-list-table-wrap">
                <table class="board-list-table">
                    <thead>
                        <tr>
                            <th>タイトル</th>
                            <th>投稿者</th>
                            <th>編成</th>
                            <th>
                                <div class="board-filter-header">
                                    <span>難易度</span>
                                    <button type="button" class="board-filter-icon-btn" data-filter-kind="difficulty" aria-label="難易度で絞り込み" aria-expanded="false">▽</button>
                                    <div class="board-filter-menu" data-filter-kind="difficulty" hidden></div>
                                </div>
                            </th>
                            <th>
                                <div class="board-filter-header">
                                    <span>モード</span>
                                    <button type="button" class="board-filter-icon-btn" data-filter-kind="mode" aria-label="モードで絞り込み" aria-expanded="false">▽</button>
                                    <div class="board-filter-menu" data-filter-kind="mode" hidden></div>
                                </div>
                            </th>
                            <th>
                                <div class="board-filter-header">
                                    <span>公開範囲</span>
                                    <button type="button" class="board-filter-icon-btn" data-filter-kind="visibility" aria-label="公開範囲で絞り込み" aria-expanded="false">▽</button>
                                    <div class="board-filter-menu" data-filter-kind="visibility" hidden></div>
                                </div>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <% articles.forEach(function(article) { %>
                            <tr
                                data-filter-difficulty="<%= article.difficultyValue || '' %>"
                                data-filter-difficulty-label="<%= article.difficultyLabel || '' %>"
                                data-filter-mode="<%= article.modeValue || '' %>"
                                data-filter-mode-label="<%= article.modeLabel || '' %>"
                                data-filter-visibility="<%= article.visibilityValue || '' %>"
                                data-filter-visibility-label="<%= article.visibilityLabel || '' %>"
                            >
                                <td class="board-list-title-cell">
                                    <a href="/board/<%= article.id %>"><%= article.title %></a>
                                </td>
                                <td><%= article.authorName %></td>
                                <td>
                                    <div class="board-list-party-icons" aria-label="編成">
                                        <% for (let i = 0; i < 5; i += 1) { %>
                                            <% const member = article.partyMembers && article.partyMembers[i]; %>
                                            <% if (member && member.imagePath) { %>
                                                <div class="board-list-party-icon-wrap" data-party-official-name="<%= member.name %>">
                                                    <img src="<%= member.imagePath %>" alt="<%= member.name %>" title="<%= member.name %>" class="board-list-party-icon" />
                                                    <img src="/images/lock.svg" alt="" class="character-unowned-lock" aria-hidden="true" />
                                                </div>
                                            <% } else if (member) { %>
                                                <div class="board-list-party-icon-wrap" data-party-official-name="<%= member.name %>">
                                                    <div class="board-list-party-icon board-list-party-icon-missing"><%= member.name %></div>
                                                    <img src="/images/lock.svg" alt="" class="character-unowned-lock" aria-hidden="true" />
                                                </div>
                                            <% } else { %>
                                                <div class="board-list-party-icon-wrap board-list-party-icon-wrap-empty">
                                                    <div class="board-list-party-icon board-list-party-icon-empty"></div>
                                                </div>
                                            <% } %>
                                        <% } %>
                                    </div>
                                </td>
                                <td><%= article.difficultyLabel || '-' %></td>
                                <td><%= article.modeLabel || '-' %></td>
                                <td><%= article.visibilityLabel || '-' %></td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
            <div class="board-list-filter-toolbar" aria-label="絞り込み">
                <span id="board-filter-status" class="board-list-filter-status">絞り込み: なし</span>
            </div>
        <% } else { %>
            <div class="no-articles">記事がありません。</div>
        <% } %>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const IS_LOGGED_IN = <%- JSON.stringify(!!isLoggedIn) %>;

        function getCurrentFirebaseUser() {
            if (!window.firebase || typeof window.firebase.auth !== 'function') {
                return null;
            }
            try {
                return window.firebase.auth().currentUser || null;
            } catch {
                return null;
            }
        }

        function sleep(ms) {
            return new Promise((resolve) => {
                window.setTimeout(resolve, ms);
            });
        }

        async function waitForFirebaseUser(timeoutMs = 3000) {
            const startedAt = Date.now();
            while (Date.now() - startedAt <= timeoutMs) {
                const user = getCurrentFirebaseUser();
                if (user && typeof user.getIdToken === 'function') {
                    return user;
                }
                await sleep(100);
            }
            return null;
        }

        async function fetchCurrentProfileWithToken() {
            const user = await waitForFirebaseUser();
            if (!user) {
                return null;
            }

            const idToken = await user.getIdToken();
            const response = await fetch('/api/settings/profile/current', {
                method: 'GET',
                headers: {
                    Authorization: `Bearer ${idToken}`
                }
            });

            if (!response.ok) {
                return null;
            }

            const payload = await response.json();
            return payload && payload.profile ? payload.profile : null;
        }

        function collectUnownedOfficialNames(ownedCharacters) {
            const unownedOfficialNames = new Set();
            if (!Array.isArray(ownedCharacters)) {
                return unownedOfficialNames;
            }

            ownedCharacters.forEach((entry) => {
                if (!entry || typeof entry !== 'object') {
                    return;
                }
                const officialName = typeof entry.officialName === 'string' ? entry.officialName.trim() : '';
                if (!officialName || entry.owned !== false) {
                    return;
                }
                unownedOfficialNames.add(officialName);
            });

            return unownedOfficialNames;
        }

        function applyCustomNamesToBoardList(profile) {
            const ownedCharacters = profile && Array.isArray(profile.ownedCharacters) ? profile.ownedCharacters : [];
            const nicknameByOfficialName = new Map();
            const unownedOfficialNames = collectUnownedOfficialNames(ownedCharacters);

            ownedCharacters.forEach((entry) => {
                if (!entry || typeof entry !== 'object') {
                    return;
                }
                const officialName = typeof entry.officialName === 'string' ? entry.officialName.trim() : '';
                if (!officialName) {
                    return;
                }
                const nickname = typeof entry.nickname === 'string' ? entry.nickname.trim() : '';
                nicknameByOfficialName.set(officialName, nickname || officialName);
            });

            document.querySelectorAll('.board-list-party-icon-wrap[data-party-official-name]').forEach((wrap) => {
                if (!(wrap instanceof HTMLElement)) {
                    return;
                }
                const officialName = (wrap.dataset.partyOfficialName || '').trim();
                const isUnowned = officialName.length > 0 && unownedOfficialNames.has(officialName);
                wrap.classList.toggle('is-unowned', isUnowned);
            });

            nicknameByOfficialName.forEach((nickname, officialName) => {
                const selector = `.board-list-party-icon-wrap[data-party-official-name="${CSS.escape(officialName)}"]`;
                document.querySelectorAll(selector).forEach((wrap) => {
                    const image = wrap.querySelector('img.board-list-party-icon');
                    if (image instanceof HTMLImageElement) {
                        image.alt = nickname;
                        image.title = nickname;
                        return;
                    }
                    const missing = wrap.querySelector('.board-list-party-icon-missing');
                    if (missing) {
                        missing.textContent = nickname;
                    }
                });
            });
        }

        function initializeBoardListFilters() {
            const tableRows = Array.from(document.querySelectorAll('.board-list-table tbody tr'));
            if (tableRows.length === 0) {
                return;
            }

            const filterButtons = Array.from(document.querySelectorAll('.board-filter-icon-btn'));
            const filterMenus = Array.from(document.querySelectorAll('.board-filter-menu'));
            const statusElement = document.getElementById('board-filter-status');
            const activeFilters = {
                difficulty: '',
                mode: '',
                visibility: ''
            };

            function findFilterLabel(kind, value) {
                if (!value) {
                    return '';
                }

                const matchedMenu = filterMenus.find((menuElement) => {
                    if (!(menuElement instanceof HTMLDivElement)) {
                        return false;
                    }
                    return menuElement.dataset.filterKind === kind;
                });

                if (!(matchedMenu instanceof HTMLDivElement)) {
                    return value;
                }

                const optionButton = Array.from(matchedMenu.querySelectorAll('.board-filter-menu-item')).find((item) => {
                    return item instanceof HTMLButtonElement && item.dataset.filterValue === value;
                });
                return optionButton instanceof HTMLButtonElement
                    ? (optionButton.textContent || value).trim()
                    : value;
            }

            function populateFilterOptions() {
                const optionsByKind = {
                    difficulty: new Map(),
                    mode: new Map(),
                    visibility: new Map()
                };

                tableRows.forEach((row) => {
                    if (!(row instanceof HTMLTableRowElement)) {
                        return;
                    }

                    const keys = ['difficulty', 'mode', 'visibility'];
                    keys.forEach((kind) => {
                        const value = row.dataset[`filter${kind.charAt(0).toUpperCase()}${kind.slice(1)}`] || '';
                        const label = row.dataset[`filter${kind.charAt(0).toUpperCase()}${kind.slice(1)}Label`] || value;
                        if (!value) {
                            return;
                        }
                        if (!optionsByKind[kind].has(value)) {
                            optionsByKind[kind].set(value, label);
                        }
                    });
                });

                filterMenus.forEach((menuElement) => {
                    if (!(menuElement instanceof HTMLDivElement)) {
                        return;
                    }

                    const kind = menuElement.dataset.filterKind || '';
                    const optionPairs = optionsByKind[kind] ? Array.from(optionsByKind[kind].entries()) : [];

                    const noneButton = document.createElement('button');
                    noneButton.type = 'button';
                    noneButton.className = 'board-filter-menu-item';
                    noneButton.dataset.filterKind = kind;
                    noneButton.dataset.filterValue = '';
                    noneButton.textContent = '絞り込みなし';
                    menuElement.appendChild(noneButton);

                    optionPairs.forEach(([value, label]) => {
                        const itemButton = document.createElement('button');
                        itemButton.type = 'button';
                        itemButton.className = 'board-filter-menu-item';
                        itemButton.dataset.filterKind = kind;
                        itemButton.dataset.filterValue = value;
                        itemButton.textContent = label;
                        menuElement.appendChild(itemButton);
                    });
                });
            }

            function updateFilterToolbar() {
                const labels = [];
                if (activeFilters.difficulty) labels.push(`難易度=${findFilterLabel('difficulty', activeFilters.difficulty)}`);
                if (activeFilters.mode) labels.push(`モード=${findFilterLabel('mode', activeFilters.mode)}`);
                if (activeFilters.visibility) labels.push(`公開範囲=${findFilterLabel('visibility', activeFilters.visibility)}`);

                if (statusElement) {
                    statusElement.textContent = labels.length > 0 ? `絞り込み: ${labels.join(' / ')}` : '絞り込み: なし';
                }
            }

            function updateFilterButtonStates() {
                filterButtons.forEach((buttonElement) => {
                    if (!(buttonElement instanceof HTMLButtonElement)) {
                        return;
                    }

                    const kind = buttonElement.dataset.filterKind || '';
                    const isActive = !!kind && !!activeFilters[kind];
                    buttonElement.classList.toggle('is-active', isActive);
                });

                filterMenus.forEach((menuElement) => {
                    if (!(menuElement instanceof HTMLDivElement)) {
                        return;
                    }

                    const kind = menuElement.dataset.filterKind || '';
                    const currentValue = kind ? activeFilters[kind] : '';
                    const items = Array.from(menuElement.querySelectorAll('.board-filter-menu-item'));
                    items.forEach((itemElement) => {
                        if (!(itemElement instanceof HTMLButtonElement)) {
                            return;
                        }
                        const value = itemElement.dataset.filterValue || '';
                        const isActive = value === currentValue;
                        itemElement.classList.toggle('is-active', isActive);
                    });
                });
            }

            function closeAllFilterMenus() {
                filterMenus.forEach((menuElement) => {
                    if (menuElement instanceof HTMLDivElement) {
                        menuElement.hidden = true;
                    }
                });

                filterButtons.forEach((buttonElement) => {
                    if (buttonElement instanceof HTMLButtonElement) {
                        buttonElement.setAttribute('aria-expanded', 'false');
                    }
                });
            }

            function applyFilters() {
                tableRows.forEach((row) => {
                    if (!(row instanceof HTMLTableRowElement)) {
                        return;
                    }

                    const rowDifficulty = row.dataset.filterDifficulty || '';
                    const rowMode = row.dataset.filterMode || '';
                    const rowVisibility = row.dataset.filterVisibility || '';

                    const difficultyMatched = !activeFilters.difficulty || rowDifficulty === activeFilters.difficulty;
                    const modeMatched = !activeFilters.mode || rowMode === activeFilters.mode;
                    const visibilityMatched = !activeFilters.visibility || rowVisibility === activeFilters.visibility;
                    row.hidden = !(difficultyMatched && modeMatched && visibilityMatched);
                });
            }

            filterButtons.forEach((buttonElement) => {
                if (!(buttonElement instanceof HTMLButtonElement)) {
                    return;
                }

                buttonElement.addEventListener('click', (event) => {
                    event.stopPropagation();
                    const kind = buttonElement.dataset.filterKind || '';
                    if (!kind) {
                        return;
                    }

                    const targetMenu = filterMenus.find((menuElement) => {
                        return menuElement instanceof HTMLDivElement
                            && menuElement.dataset.filterKind === kind;
                    });

                    if (!(targetMenu instanceof HTMLDivElement)) {
                        return;
                    }

                    const willOpen = targetMenu.hidden;
                    closeAllFilterMenus();
                    if (willOpen) {
                        targetMenu.hidden = false;
                        buttonElement.setAttribute('aria-expanded', 'true');
                    }
                });
            });

            filterMenus.forEach((menuElement) => {
                if (!(menuElement instanceof HTMLDivElement)) {
                    return;
                }

                menuElement.addEventListener('click', (event) => {
                    event.stopPropagation();

                    const target = event.target;
                    if (!(target instanceof HTMLButtonElement) || !target.classList.contains('board-filter-menu-item')) {
                        return;
                    }

                    const kind = target.dataset.filterKind || '';
                    if (!kind) {
                        return;
                    }

                    activeFilters[kind] = target.dataset.filterValue || '';
                    applyFilters();
                    updateFilterToolbar();
                    updateFilterButtonStates();
                    closeAllFilterMenus();
                });
            });

            document.addEventListener('click', () => {
                closeAllFilterMenus();
            });

            populateFilterOptions();
            applyFilters();
            updateFilterToolbar();
            updateFilterButtonStates();
        }

        async function hydrateCustomNamesIfNeeded() {
            if (!IS_LOGGED_IN) {
                return;
            }

            try {
                const profile = await fetchCurrentProfileWithToken();
                if (!profile) {
                    return;
                }
                applyCustomNamesToBoardList(profile);
            } catch (error) {
                console.warn('一覧のカスタム名読み込みに失敗しました。', error);
            }
        }

        hydrateCustomNamesIfNeeded();
        initializeBoardListFilters();
    });
</script>
