<div class="page-content">
    <h2>新規投稿</h2>
    <form id="board-post-form" action="/board/edit" method="post">
        <div class="form-group">
            <label for="timelog">投稿内容</label>
            <textarea id="timelog" name="timelog" rows="15" class="form-control" style="width: 100%; max-width: 1200px;" placeholder="バトルTLのテキストを貼り付けてください"></textarea>
        </div>
        <input type="hidden" id="timelineInfo" name="timelineInfo" value="">
        <div id="board-post-error" style="display:none; color:#c00; margin: 8px 0;"></div>
        <button type="submit" class="btn btn-primary">投稿</button>
    </form>
</div>
